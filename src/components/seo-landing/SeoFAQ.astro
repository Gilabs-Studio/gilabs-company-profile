---
import type { SeoFaqItem } from "../../data/seoLanding/types";
import { ChevronDown } from "lucide-react";

interface Props {
  title: string;
  subtitle: string;
  faqs: SeoFaqItem[];
}

const { title, subtitle, faqs } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-20 md:py-28 bg-background border-b border-border/60 relative">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
    
    {/* Section Header */}
    <div class="text-center mb-14 md:mb-20">
      <h2 class="typography-section-title mb-4 text-foreground">
        {title}
      </h2>
      <p class="typography-subtitle text-foreground/80 leading-relaxed font-light">
        {subtitle}
      </p>
    </div>

    {/* FAQ Accordion List */}
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white border border-border/80 rounded-2xl overflow-hidden transition-all duration-200 open:shadow-sm">
          <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer select-none text-left font-medium text-foreground hover:text-brand transition-colors">
            <span class="text-base sm:text-lg font-medium pr-2">
              {faq.question}
            </span>
            <ChevronDown className="w-5 h-5 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180 group-open:text-brand" />
          </summary>
          <div class="px-5 sm:px-6 pb-6 pt-1 text-foreground/80 typography-body font-light leading-relaxed border-t border-border/40">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
