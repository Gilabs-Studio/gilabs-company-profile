---
import type { SeoFeatureItem } from "../../data/seoLanding/types";

interface Props {
  title: string;
  subtitle: string;
  features: SeoFeatureItem[];
}

const { title, subtitle, features } = Astro.props;
---

<section class="py-20 md:py-28 bg-white border-b border-border/60 relative">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-14 md:mb-20">
      <h2 class="typography-section-title mb-4 text-foreground">
        {title}
      </h2>
      <p class="typography-subtitle text-foreground/80 leading-relaxed font-light">
        {subtitle}
      </p>
    </div>

    {/* Features Grid - Clean Numbers 01..06 */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {features.map((item, index) => (
        <div class="bg-background border border-border/70 rounded-2xl p-6 sm:p-8 flex flex-col space-y-3 hover:border-brand/40 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
          <div class="text-xs font-mono font-bold text-brand tracking-widest">
            {String(index + 1).padStart(2, '0')}
          </div>
          <h3 class="typography-card-title text-foreground">
            {item.title}
          </h3>
          <p class="typography-body text-foreground/80 leading-relaxed font-light grow">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
