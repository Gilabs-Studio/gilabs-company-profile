---
import {
  Laptop,
  Smartphone,
  Database,
  Workflow,
  ShieldCheck,
  ArrowUpRight
} from "lucide-react";
import { getWhatsAppLink } from "../../../lib/utils";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
}

const { lang = "id", service } = Astro.props;

const {
  featuresEyebrow,
  featuresTitle,
  featuresSubtitle,
  features = [],
} = service;

const iconMap: Record<string, any> = {
  laptop: Laptop,
  smartphone: Smartphone,
  database: Database,
  workflow: Workflow,
  "shield-check": ShieldCheck,
};
---

<section id="layanan" class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {featuresEyebrow && (
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow text-foreground/80">
            {featuresEyebrow}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
      )}

      <h2 class="typography-section-title mb-4">
        {featuresTitle}
      </h2>

      {featuresSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {featuresSubtitle}
        </p>
      )}
    </div>

    {/* Responsive Services Grid: 3 columns on top row, 2 columns on bottom row */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {features.slice(0, 3).map((item) => {
        const IconComponent = (item.icon && iconMap[item.icon]) || Laptop;
        const resolvedHref = item.href?.startsWith("whatsapp:")
          ? getWhatsAppLink(item.href.replace("whatsapp:", ""), lang)
          : item.href || "#";
        const isExternal = item.href?.startsWith("whatsapp:") || item.href?.startsWith("http");

        return (
          <a
            href={resolvedHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class="bg-white border border-border/50 rounded-2xl p-7 sm:p-8 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group cursor-pointer"
          >
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-xl bg-brand/10 text-brand flex items-center justify-center">
                  <IconComponent className="w-6 h-6" />
                </div>
                {item.number && (
                  <span class="font-mono text-xs font-bold text-muted-foreground/60 group-hover:text-brand transition-colors">
                    {item.number}
                  </span>
                )}
              </div>

              <h3 class="typography-card-title text-foreground mb-1 group-hover:text-brand transition-colors">
                {item.title}
              </h3>

              {item.subtitle && (
                <p class="text-xs font-medium text-brand/80 mb-3 tracking-wide">
                  {item.subtitle}
                </p>
              )}

              <p class="typography-body text-muted-foreground leading-relaxed font-light">
                {item.description}
              </p>
            </div>

            {item.ctaText && (
              <div class="pt-6 mt-6 border-t border-border/40 flex items-center justify-between text-xs font-medium text-brand">
                <span>{item.ctaText}</span>
                <ArrowUpRight className="w-4 h-4" />
              </div>
            )}
          </a>
        );
      })}
    </div>

    {/* Bottom 2 Services in 2-column layout */}
    {features.length > 3 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mt-6 sm:mt-8 items-stretch max-w-4xl mx-auto">
        {features.slice(3, 5).map((item) => {
          const IconComponent = (item.icon && iconMap[item.icon]) || Laptop;
          const resolvedHref = item.href?.startsWith("whatsapp:")
            ? getWhatsAppLink(item.href.replace("whatsapp:", ""), lang)
            : item.href || "#";
          const isExternal = item.href?.startsWith("whatsapp:") || item.href?.startsWith("http");

          return (
            <a
              href={resolvedHref}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              class="bg-white border border-border/50 rounded-2xl p-7 sm:p-8 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group cursor-pointer"
            >
              <div>
                <div class="flex items-center justify-between mb-6">
                  <div class="w-12 h-12 rounded-xl bg-brand/10 text-brand flex items-center justify-center">
                    <IconComponent className="w-6 h-6" />
                  </div>
                  {item.number && (
                    <span class="font-mono text-xs font-bold text-muted-foreground/60 group-hover:text-brand transition-colors">
                      {item.number}
                    </span>
                  )}
                </div>

                <h3 class="typography-card-title text-foreground mb-1 group-hover:text-brand transition-colors">
                  {item.title}
                </h3>

                {item.subtitle && (
                  <p class="text-xs font-medium text-brand/80 mb-3 tracking-wide">
                    {item.subtitle}
                  </p>
                )}

                <p class="typography-body text-muted-foreground leading-relaxed font-light">
                  {item.description}
                </p>
              </div>

              {item.ctaText && (
                <div class="pt-6 mt-6 border-t border-border/40 flex items-center justify-between text-xs font-medium text-brand">
                  <span>{item.ctaText}</span>
                  <ArrowUpRight className="w-4 h-4" />
                </div>
              )}
            </a>
          );
        })}
      </div>
    )}
  </div>
</section>
