---
import { Check } from "lucide-react";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
}

const { service } = Astro.props;

const {
  solutionsEyebrow,
  solutionsTitle,
  solutionsSubtitle,
  solutions = [],
} = service;
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {solutionsEyebrow && (
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow text-foreground/80">
            {solutionsEyebrow}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
      )}

      <h2 class="typography-section-title mb-4">
        {solutionsTitle}
      </h2>

      {solutionsSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {solutionsSubtitle}
        </p>
      )}
    </div>

    {/* Solutions Cards Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {solutions.map((pillar) => {
        const cleanTitle = pillar.title.replace(/^(Pilar|Pillar)\s*\d+\s*[-–]\s*/i, "");
        return (
          <div class="bg-white border border-border/50 rounded-2xl p-8 sm:p-9 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-6">
                {pillar.number && (
                  <span class="text-3xl sm:text-4xl font-mono font-bold text-brand">
                    {pillar.number}
                  </span>
                )}
                {pillar.badge && (
                  <span class="text-xs font-semibold px-3 py-1 rounded-full bg-brand/10 text-brand uppercase tracking-wider">
                    {pillar.badge}
                  </span>
                )}
              </div>

              <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
                {cleanTitle}
              </h3>

              {pillar.description && (
                <p class="typography-body text-muted-foreground leading-relaxed mb-6 font-light">
                  {pillar.description}
                </p>
              )}

              {pillar.points && pillar.points.length > 0 && (
                <ul class="space-y-3 pt-4 border-t border-border/40 text-xs sm:text-sm text-foreground/80 font-light">
                  {pillar.points.map((pt) => (
                    <li class="flex items-start gap-2.5">
                      <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                      <span class="leading-snug">{pt}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
