---
import { FAQList } from "../../react/FAQList";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const faqs = [
  {
    question: lang === "en"
      ? "How long does a typical software project take?"
      : "Berapa lama estimasi pengerjaan sebuah project software?",
    answer: lang === "en"
      ? "It depends on complexity. Lean MVP projects typically take 3-6 weeks. Comprehensive custom ERP or CRM systems take 2-4 months. We always define a realistic, committed timeline upfront before writing any code."
      : "Tergantung kompleksitas. Project sederhana (MVP) biasanya 3-6 minggu. Sistem yang lebih kompleks seperti ERP/CRM custom butuh 2-4 bulan. Kami selalu tentukan timeline yang realistis di awal sebelum mulai."
  },
  {
    question: lang === "en"
      ? "Will our company own 100% of the source code?"
      : "Apakah source code jadi milik kami setelah project selesai?",
    answer: lang === "en"
      ? "Yes, 100%. The source code becomes fully owned intellectual property of your company upon project sign-off, complete with repository access and architectural documentation."
      : "Ya, 100%. Source code sepenuhnya menjadi aset milik perusahaan kamu setelah pelunasan, lengkap dengan dokumentasi dan akses repository."
  },
  {
    question: lang === "en"
      ? "How do you handle scope changes or additional feature requests midway?"
      : "Bagaimana kalau di tengah jalan ada fitur tambahan yang ingin dibuat?",
    answer: lang === "en"
      ? "We use an agile Change Request approach. Any new feature is scoped and estimated transparently without disrupting active sprint milestones or core project deadlines."
      : "Kami menggunakan pendekatan fleksibel (Change Request). Fitur baru akan diestimasi scope dan biayanya secara transparan tanpa mengganggu timeline milestone yang sedang berjalan."
  },
  {
    question: lang === "en"
      ? "What technical support is provided after launch?"
      : "Apakah ada dukungan teknis setelah software resmi digunakan?",
    answer: lang === "en"
      ? "Every project includes a dedicated bug-fix warranty (1-3 months depending on plan). Thereafter, we offer flexible monthly retainer packages for continuous maintenance, server monitoring, and feature iteration."
      : "Setiap project dilengkapi masa garansi bug fixes (1-3 bulan tergantung paket). Setelahnya, kami menyediakan paket retainer bulanan untuk maintenance, server monitoring, dan penambahan fitur berkelanjutan."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!-- Inject FAQ Schema for Rich Google Search Snippets -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-16 md:py-24 relative z-10" id="faq">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Common Inquiries" : "Pertanyaan Umum"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        FAQ
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Frequently asked questions regarding delivery timelines, source code ownership, and post-deployment warranties."
          : "Hal yang sering ditanyakan seputar estimasi pengerjaan, kepemilikan source code, dan masa garansi teknis."}
      </p>
    </div>

    <div class="space-y-4">
      <FAQList client:visible items={faqs} itemClassName="border border-border/50 rounded-2xl overflow-hidden bg-white shadow-sm transition-colors duration-200 hover:border-brand/50 relative z-10" />
    </div>
  </div>
</section>
