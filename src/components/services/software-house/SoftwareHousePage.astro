---
import SoftwareHouseHero from "./SoftwareHouseHero.astro";
import SoftwareHouseSocialProof from "./SoftwareHouseSocialProof.astro";
import SoftwareHouseProblems from "./SoftwareHouseProblems.astro";
import SoftwareHouseServices from "./SoftwareHouseServices.astro";
import SoftwareHouseWhyUs from "./SoftwareHouseWhyUs.astro";
import SoftwareHouseProcess from "./SoftwareHouseProcess.astro";
import SoftwareHousePortfolio from "./SoftwareHousePortfolio.astro";
import SoftwareHousePricing from "./SoftwareHousePricing.astro";
import SoftwareHouseFAQ from "./SoftwareHouseFAQ.astro";
import SoftwareHouseCTA from "./SoftwareHouseCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="software-house-service-page">
  {/* 1. HERO SECTION */}
  <SoftwareHouseHero
    lang={lang}
    eyebrow={service.eyebrow}
    title={service.title}
    subtitle={service.subtitle}
    primaryCtaText={service.primaryCtaText}
    secondaryCtaText={service.secondaryCtaText}
  />

  {/* 2. SOCIAL PROOF BAR */}
  <SoftwareHouseSocialProof lang={lang} />

  {/* 3. MASALAH YANG SERING DITEMUI */}
  <SoftwareHouseProblems lang={lang} />

  {/* 4. LAYANAN KAMI */}
  <SoftwareHouseServices lang={lang} />

  {/* 5. KENAPA PILIH KAMI (3 PILAR) */}
  <SoftwareHouseWhyUs lang={lang} />

  {/* 6. PROSES KERJA (5 LANGKAH) */}
  <SoftwareHouseProcess lang={lang} />

  {/* 7. PORTOFOLIO / STUDI KASUS */}
  <SoftwareHousePortfolio lang={lang} />

  {/* 8. PAKET / ESTIMASI BIAYA */}
  <SoftwareHousePricing lang={lang} />

  {/* 9. FAQ */}
  <SoftwareHouseFAQ lang={lang} />

  {/* 10. FINAL CTA */}
  <SoftwareHouseCTA lang={lang} />
</div>
