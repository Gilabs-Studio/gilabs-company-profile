---
import SoftwareHouseHero from "./SoftwareHouseHero.astro";
import SoftwareHouseProblems from "./SoftwareHouseProblems.astro";
import SoftwareHouseServices from "./SoftwareHouseServices.astro";
import SoftwareHouseWhyUs from "./SoftwareHouseWhyUs.astro";
import SoftwareHouseProcess from "./SoftwareHouseProcess.astro";
import SoftwareHouseFAQ from "./SoftwareHouseFAQ.astro";
import SoftwareHouseCTA from "./SoftwareHouseCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="software-house-service-page">
  {/* 1. HERO SECTION */}
  <SoftwareHouseHero lang={lang} service={service} />

  {/* 2. MASALAH YANG SERING DITEMUI */}
  <SoftwareHouseProblems lang={lang} service={service} />

  {/* 3. LAYANAN KAMI */}
  <SoftwareHouseServices lang={lang} service={service} />

  {/* 4. KENAPA PILIH KAMI */}
  <SoftwareHouseWhyUs lang={lang} service={service} />

  {/* 5. PROSES KERJA (5 LANGKAH) */}
  <SoftwareHouseProcess lang={lang} service={service} />

  {/* 6. FAQ */}
  <SoftwareHouseFAQ lang={lang} service={service} />

  {/* 7. FINAL CTA */}
  <SoftwareHouseCTA lang={lang} service={service} />
</div>
