---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const clients = [
  { name: "ADIGUNA LOGISTICS", subtitle: "Supply Chain & Fleet", font: "font-mono tracking-wider font-bold" },
  { name: "NEXORA INDUSTRY", subtitle: "Industrial Manufacturing", font: "font-serif tracking-widest font-semibold" },
  { name: "DOMUS RETAIL TECH", subtitle: "Omnichannel Retail", font: "font-serif italic font-medium tracking-wide" },
  { name: "SAVLO FINTECH", subtitle: "B2B SaaS Platform", font: "font-sans font-extrabold tracking-tight" },
  { name: "ALPHA HEALTHCARE", subtitle: "Clinic & Hospital CRM", font: "font-sans font-black tracking-widest" },
  { name: "FIBER NETWORKS", subtitle: "IoT & Infrastructure", font: "font-mono tracking-widest font-bold" }
];
---

<section class="py-10 sm:py-14 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center max-w-6xl">
    <p class="text-xs sm:text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6 sm:mb-8">
      {lang === "en"
        ? "Trusted by manufacturing, retail, and tech enterprises to build their core operating systems"
        : "Dipercaya perusahaan manufaktur, retail, hingga startup untuk membangun sistem inti bisnis mereka"}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16">
      {clients.map((client) => (
        <div class="group flex flex-col items-center cursor-pointer">
          <span class={`text-base sm:text-lg md:text-xl text-foreground/40 group-hover:text-brand transition-colors select-none ${client.font}`}>
            {client.name}
          </span>
          <span class="text-[10px] text-muted-foreground/60 tracking-wider uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            {client.subtitle}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
