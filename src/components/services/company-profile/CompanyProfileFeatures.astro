---
import CompanyProfileFeatureScroll from "./CompanyProfileFeatureScroll";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
}

const { service, lang = "id" } = Astro.props;

const {
  featuresEyebrow,
  featuresTitle,
  featuresSubtitle,
  features = [],
} = service;

const featureImages = [
  "/images/services/company-profile/feature-01.png",
  "/images/services/company-profile/feature-02.png",
  "/images/services/company-profile/feature-03.png",
  "/images/services/company-profile/feature-04.png",
  "/images/services/company-profile/feature-05.png",
  "/images/services/company-profile/feature-06.png",
  "/images/services/company-profile/feature-07.png",
  "/images/services/company-profile/feature-08.png",
];

const displayFeatures = features.map((f, idx) => ({
  number: String(idx + 1).padStart(2, "0"),
  title: f.title,
  description: f.description,
  image: f.image || featureImages[idx] || featureImages[0],
}));
---

<section id="fitur" class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {featuresEyebrow && (
        <div class="mb-3">
          <span class="typography-eyebrow text-muted-foreground tracking-widest uppercase text-xs font-mono">
            {featuresEyebrow}
          </span>
        </div>
      )}

      <h2 class="typography-section-title mb-4">
        {featuresTitle}
      </h2>

      {featuresSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {featuresSubtitle}
        </p>
      )}
    </div>

    {/* Scroll-Driven Feature Showcase with Sticky Image Container */}
    <CompanyProfileFeatureScroll client:visible features={displayFeatures} />

    {/* Fallback styling for no-JS environments */}
    <noscript>
      <style>
        .no-js-show { display: block !important; }
      </style>
    </noscript>
  </div>
</section>

