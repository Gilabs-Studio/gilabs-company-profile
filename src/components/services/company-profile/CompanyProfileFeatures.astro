---
import { Building2, Target, Users, Briefcase, Award, UserCheck, MapPin, Share2 } from "lucide-react";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const features = [
  {
    number: "01",
    title: lang === "en" ? "Company Profile & History" : "Profil Perusahaan & Sejarah",
    description: lang === "en"
      ? "Tell your company's journey with dignified visual storytelling and timeline milestones."
      : "Ceritakan perjalanan bisnismu dengan visual yang berbobot.",
    Icon: Building2
  },
  {
    number: "02",
    title: lang === "en" ? "Vision, Mission & Values" : "Visi, Misi & Nilai Perusahaan",
    description: lang === "en"
      ? "Display your business principles, core values, and strategic horizons with corporate elegance."
      : "Tampilkan arah dan prinsip bisnis secara elegan.",
    Icon: Target
  },
  {
    number: "03",
    title: lang === "en" ? "Organization Structure / Core Team" : "Struktur Organisasi / Tim Inti",
    description: lang === "en"
      ? "Showcase executive leadership and key specialists behind the company to cement client trust."
      : "Tunjukkan orang-orang di balik perusahaan untuk bangun kepercayaan.",
    Icon: Users
  },
  {
    number: "04",
    title: lang === "en" ? "Project & Client Portfolio" : "Portofolio Proyek / Klien",
    description: lang === "en"
      ? "A verifiable digital showcase of proven past track records, specs, and corporate clients."
      : "Etalase hasil kerja nyata yang bisa diverifikasi.",
    Icon: Briefcase
  },
  {
    number: "05",
    title: lang === "en" ? "Gallery & Certifications" : "Galeri & Sertifikasi",
    description: lang === "en"
      ? "Display official legalities, ISO certificates, safety accreditations, and achievements."
      : "Dokumentasi legalitas, sertifikat ISO, dan pencapaian resmi.",
    Icon: Award
  },
  {
    number: "06",
    title: lang === "en" ? "Career Portal (Optional)" : "Halaman Karir (Opsional)",
    description: lang === "en"
      ? "Post company openings and attract top industry talent directly from your web presence."
      : "Buka lowongan dan rekrut talenta terbaik langsung dari web.",
    Icon: UserCheck
  },
  {
    number: "07",
    title: lang === "en" ? "Contact & Branch Locations" : "Kontak & Lokasi Cabang",
    description: lang === "en"
      ? "Integrated Google Maps and dynamic inquiry forms routed straight to team email or WhatsApp."
      : "Integrasi Google Maps dan form kontak yang langsung masuk ke email/WA tim.",
    Icon: MapPin
  },
  {
    number: "08",
    title: lang === "en" ? "Social Media Integration" : "Integrasi Media Sosial",
    description: lang === "en"
      ? "Centralize all verified official social media accounts and LinkedIn hubs in one single place."
      : "Tautkan semua akun resmi perusahaan di satu tempat.",
    Icon: Share2
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Core Modules" : "Fitur Utama"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Everything a Modern Company Profile Needs" : "Semua yang Dibutuhkan Company Profile Modern"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Essential components engineered to exceed expectations of B2B partners and tender evaluation boards."
          : "Komponen esensial yang dirancang khusus untuk memenuhi ekspektasi partner B2B dan panitia evaluasi proyek."}
      </p>
    </div>

    {/* 8 Features Grid (4 cols on lg, 2 on sm) */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {features.map((feature) => (
        <div class="bg-white border border-border/50 rounded-2xl p-6 sm:p-7 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
          <div>
            {/* Top row: Number and Icon */}
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-semibold text-brand tracking-wider bg-brand/5 px-2.5 py-1 rounded-md border border-brand/10">
                {feature.number}
              </span>
              <feature.Icon className="w-5 h-5 text-brand" />
            </div>

            <h3 class="text-base sm:text-lg font-semibold text-foreground mb-2 group-hover:text-brand transition-colors">
              {feature.title}
            </h3>

            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed font-light">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
