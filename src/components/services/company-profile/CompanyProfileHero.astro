---
import { ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../../lib/utils";

interface Props {
  lang: "en" | "id";
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  lang = "id",
  eyebrow = lang === "en" ? "Company Profile Website" : "Jasa Web Company Profile",
  title = lang === "en"
    ? "Company Profiles Built to Look Like an Enterprise"
    : "Company Profile yang Terlihat Seperti Perusahaan Besar",
  subtitle = lang === "en"
    ? "First impressions happen on your website. We make sure the first thing prospective partners or investors see is the absolute best version of your business."
    : "Kesan pertama itu di website. Kami pastikan yang pertama kali dilihat calon partner atau investor kamu adalah versi terbaik dari bisnismu.",
  primaryCtaText = lang === "en" ? "Free Consultation" : "Konsultasi Gratis",
  secondaryCtaText = lang === "en" ? "View Examples" : "Lihat Contoh Company Profile",
} = Astro.props;

const heroImageUrl = "/images/services/company-profile/hero-corporate-mockup.png";
---

<section class="relative pt-24 sm:pt-28 md:pt-32 pb-16 md:pb-24 overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10 text-center">
    {/* Clean Minimal Eyebrow */}
    <div class="flex items-center justify-center gap-3 sm:gap-4 mb-4 sm:mb-6">
      <div class="h-px w-8 sm:w-16 bg-primary/20"></div>
      <span class="typography-eyebrow text-foreground/80 tracking-widest">
        {eyebrow}
      </span>
      <div class="h-px w-8 sm:w-16 bg-primary/20"></div>
    </div>

    {/* Hero Headline */}
    <h1 class="typography-hero-title mb-6 sm:mb-8 text-foreground max-w-4xl mx-auto">
      {title}
    </h1>

    {/* Subheadline */}
    <p class="typography-subtitle max-w-2xl mx-auto mb-8 sm:mb-10 text-foreground/80 leading-relaxed font-light">
      {subtitle}
    </p>

    {/* CTA Buttons */}
    <div class="flex flex-wrap items-center justify-center gap-4 mb-12 sm:mb-16">
      <a
        href={getWhatsAppLink("hero", lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-white bg-brand rounded-full hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
      >
        <span>{primaryCtaText}</span>
        <ArrowRight className="w-4 h-4" />
      </a>

      <a
        href="#portofolio"
        class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-foreground bg-white hover:bg-secondary/40 border border-border/80 rounded-full transition-colors cursor-pointer shadow-sm"
      >
        {secondaryCtaText}
      </a>
    </div>

    {/* Desktop Mockup Hero Image Showcase */}
    <div class="relative mx-auto max-w-5xl">
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-border/50 bg-white shadow-xl shadow-black/5">
        <img
          src={heroImageUrl}
          alt="Mockup Website Company Profile di Desktop - Gilabs Studio"
          class="w-full h-auto object-cover select-none"
          loading="eager"
          fetchpriority="high"
          width="1920"
          height="1080"
          decoding="async"
        />
      </div>

      {/* Floating Corporate Credibility Badge */}
      <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 bg-white/95 backdrop-blur-md border border-border/80 rounded-full px-5 py-2.5 hidden sm:flex items-center gap-3 z-20 shadow-lg shadow-black/5">
        <span class="w-2 h-2 rounded-full bg-brand"></span>
        <span class="text-xs sm:text-sm font-medium text-foreground">
          {lang === "en" ? "Enterprise Grade Design • Tender Verification Ready • Fast & Secure" : "Desain Berkelas Korporat • Siap Verifikasi Tender • Cepat & Aman"}
        </span>
      </div>
    </div>
  </div>
</section>
