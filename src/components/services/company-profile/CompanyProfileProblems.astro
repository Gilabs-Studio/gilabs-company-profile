---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const problems = [
  {
    number: "01",
    title: lang === "en" ? "Outdated Look" : "Terlihat Kuno",
    description: lang === "en"
      ? "Designs from 5 years ago make potential partners hesitate before reaching out."
      : "Desain 5 tahun lalu, calon partner ragu duluan.",
    metric: lang === "en" ? "75% judge corporate credibility by visual design" : "75% mitra menilai kredibilitas dari tampilan visual"
  },
  {
    number: "02",
    title: lang === "en" ? "Cluttered Information" : "Informasi Berantakan",
    description: lang === "en"
      ? "Vision, mission, services, and contacts have no clear hierarchy or structure."
      : "Visi misi, layanan, kontak, semua nggak jelas urutannya.",
    metric: lang === "en" ? "Evaluation boards struggle to locate key credentials" : "Panitia tender kesulitan menemukan legalitas & dokumen"
  },
  {
    number: "03",
    title: lang === "en" ? "Unconvincing" : "Nggak Meyakinkan",
    description: lang === "en"
      ? "No credibility proof, just dry walls of text without substance."
      : "Nggak ada bukti kredibilitas, cuma teks tanpa substansi.",
    metric: lang === "en" ? "Lacks verifiable outcomes and real project galleries" : "Nihil pembuktian proyek nyata dan data terverifikasi"
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Common Roadblocks" : "Masalah yang Sering Ditemui"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Older Company Profiles Often Look Like This" : "Company Profile Lama Sering Begini"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "These 3 bottlenecks are the primary reasons prospective partners and tender committees hesitate."
          : "Tiga hal ini yang paling sering bikin calon partner dan panitia tender ragu duluan sebelum mengenal bisnismu."}
      </p>
    </div>

    {/* 3 Columns Grid - Landing Page Consistent Cards (bg-white, border-border/50, shadow-sm) */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {problems.map((problem) => (
        <div class="bg-white border border-border/50 rounded-2xl p-7 sm:p-8 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
          <div>
            <div class="mb-5">
              <span class="text-3xl sm:text-4xl font-mono font-bold text-brand">
                {problem.number}
              </span>
            </div>

            <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
              {problem.title}
            </h3>

            <p class="typography-body text-muted-foreground leading-relaxed mb-6 font-light">
              {problem.description}
            </p>
          </div>

          {/* Bottom metric callout with Brand Blue dot */}
          <div class="pt-4 border-t border-border/40 flex items-center gap-2 text-xs font-medium text-foreground/70">
            <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0"></span>
            <span>{problem.metric}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
