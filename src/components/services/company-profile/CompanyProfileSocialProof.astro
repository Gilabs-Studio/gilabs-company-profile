---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const clients = [
  { name: "ADIGUNA KARYA", subtitle: "Construction & Eng.", font: "font-mono font-bold tracking-wider" },
  { name: "DOMUS LIVING", subtitle: "Architecture Studio", font: "font-serif italic font-medium tracking-wide" },
  { name: "NEXORA ENERGI", subtitle: "Renewable Energy", font: "font-sans font-black tracking-widest" },
  { name: "MARITIM NUSANTARA", subtitle: "Shipping & Logistics", font: "font-mono tracking-widest font-bold" },
  { name: "ARTHA CAPITAL", subtitle: "Private Equity & M&A", font: "font-sans font-extrabold tracking-tight" },
  { name: "PRIMA MEDIKA", subtitle: "Healthcare & Pharma", font: "font-serif tracking-widest font-semibold" }
];
---

<section class="py-10 sm:py-14 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center max-w-6xl">
    <p class="text-xs sm:text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6 sm:mb-8">
      {lang === "en"
        ? "Trusted by companies across various sectors to build their digital presence"
        : "Sudah dipercaya perusahaan dari berbagai sektor untuk membangun citra digital mereka"}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16">
      {clients.map((client) => (
        <div class="group flex flex-col items-center cursor-pointer">
          <span class={`text-base sm:text-lg md:text-xl text-foreground/40 group-hover:text-brand transition-colors select-none ${client.font}`}>
            {client.name}
          </span>
          <span class="text-[10px] text-muted-foreground/60 tracking-wider uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            {client.subtitle}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
