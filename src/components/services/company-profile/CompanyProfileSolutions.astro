---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const pillars = [
  {
    number: "01",
    title: lang === "en" ? "Pillar 1 — Professional Image" : "Pilar 1 — Citra Profesional",
    subtitle: lang === "en" ? "Design that reflects the scale and standards of your industry." : "Desain yang mencerminkan skala dan standar industri kamu.",
    image: "/images/services/company-profile/solution-prestige.jpg",
    alt: "Desain Company Profile Profesional Skala Enterprise",
    badge: lang === "en" ? "Enterprise Authority" : "Standar Korporat",
    points: [
      lang === "en" ? "Visual language tailored to your specific industry tier" : "Bahasa visual eksklusif sesuai sektor industri Anda",
      lang === "en" ? "Executive typography and international layout conventions" : "Tipografi dan tata letak berstandar internasional",
      lang === "en" ? "Flawless rendering on board-level iPads and laptops" : "Tampilan responsif sempurna di laptop klien maupun HP direksi"
    ]
  },
  {
    number: "02",
    title: lang === "en" ? "Pillar 2 — Clear Information Architecture" : "Pilar 2 — Struktur Informasi Jelas",
    subtitle: lang === "en" ? "From who you are and what you do to how to get in touch—everything is effortless to find." : "Dari siapa kamu, apa yang kamu kerjakan, sampai cara hubungi—semua mudah ditemukan.",
    image: "/images/services/web-dev/solution-design.jpg",
    alt: "Struktur Informasi Company Profile Rapi dan Terarah",
    badge: lang === "en" ? "Information Flow" : "Arsitektur Informasi",
    points: [
      lang === "en" ? "Sequential narrative flow that builds trust step-by-step" : "Alur membaca narasi yang runtut dan meyakinkan",
      lang === "en" ? "Direct access to ISO certifications, legalities, and leadership" : "Akses cepat ke halaman legalitas, sertifikasi, & tim",
      lang === "en" ? "Intuitive navigation designed for procurement & tender evaluators" : "Navigasi intuitif untuk panitia tender dan partner bisnis"
    ]
  },
  {
    number: "03",
    title: lang === "en" ? "Pillar 3 — Easy to Update" : "Pilar 3 — Mudah Diperbarui",
    subtitle: lang === "en" ? "A clean CMS that your team can easily manage without relying on developers." : "CMS yang gampang dipakai sendiri tanpa harus bergantung ke developer terus.",
    image: "/images/services/web-dev/portfolio-salesview.jpg",
    alt: "CMS Dashboard Kelola Konten Mandiri",
    badge: lang === "en" ? "Self-Serve CMS" : "CMS Mandiri",
    points: [
      lang === "en" ? "Effortless dashboard to publish news, project releases & press" : "Panel kelola berita, proyek baru, & siaran pers mandiri",
      lang === "en" ? "Seamlessly upload annual reports, PDFs, and legal updates" : "Unggah dokumen legalitas & laporan berkala dengan mudah",
      lang === "en" ? "Zero lock-in or recurring maintenance licensing fees" : "Bebas biaya langganan bulanan pihak ketiga yang membengkak"
    ]
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Value Proposition" : "Solusi & Value Proposition"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Designed to Build Lasting Trust" : "Dirancang untuk Membangun Kepercayaan"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Not just so you have a live website. Every element is structured to convince potential partners that you're the right business to work with."
          : "Bukan cuma biar kelihatan ada website-nya. Setiap elemen kami tata agar calon partner yakin kamu bisnis yang tepat."}
      </p>
    </div>

    {/* 3 Pillars Grid - Landing Page Consistent Cards (bg-white, border-border/50, shadow-sm) */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {pillars.map((pillar) => (
        <article class="bg-white border border-border/50 rounded-2xl overflow-hidden hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
          {/* Top Image Banner */}
          <div class="relative aspect-[16/10] overflow-hidden bg-muted/20 border-b border-border/40">
            <img
              src={pillar.image}
              alt={pillar.alt}
              class="w-full h-full object-cover select-none"
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
            />

            {/* Clean Badge overlay on image */}
            <div class="absolute top-3 left-3 z-10">
              <span class="text-xs font-semibold px-2.5 py-1 bg-white/95 backdrop-blur-md text-foreground rounded-full border border-border/40 shadow-xs">
                {pillar.badge}
              </span>
            </div>

            {/* Number overlay */}
            <div class="absolute bottom-3 right-4 z-10 text-xl font-mono font-bold text-white drop-shadow">
              {pillar.number}
            </div>
          </div>

          {/* Content Details */}
          <div class="p-6 sm:p-7 flex flex-col grow justify-between">
            <div>
              <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
                {pillar.title}
              </h3>

              <p class="typography-body text-muted-foreground leading-relaxed font-light mb-6">
                {pillar.subtitle}
              </p>
            </div>

            {/* Bullet Highlights */}
            <div class="pt-4 border-t border-border/40">
              <ul class="space-y-2.5 text-xs sm:text-sm text-foreground/80 font-light">
                {pillar.points.map((pt) => (
                  <li class="flex items-start gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0 mt-1.5"></span>
                    <span class="leading-snug">{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
