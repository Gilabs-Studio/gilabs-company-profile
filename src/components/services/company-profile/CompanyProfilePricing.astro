---
import { Check, ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../../lib/utils";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const packages = [
  {
    name: "BASIC",
    price: lang === "en" ? "$350" : "Rp 5.000.000",
    description: lang === "en"
      ? "Ideal for newly founded PT/CV requiring an official digital presence"
      : "Cocok untuk PT baru berdiri atau CV yang butuh hadir secara resmi",
    isPopular: false,
    features: [
      lang === "en" ? "Company profile 3-5 pages" : "Company profile 3-5 halaman",
      lang === "en" ? "Corporate clean & responsive design" : "Desain corporate clean & responsive",
      lang === "en" ? "Contact page & office location map" : "Halaman kontak & lokasi",
      lang === "en" ? "1-Year Domain (.com / .id) + Cloud Hosting" : "Domain (.com / .id) + hosting 1 tahun",
      lang === "en" ? "2x revision rounds" : "Revisi 2x"
    ]
  },
  {
    name: "STANDARD",
    price: lang === "en" ? "$950" : "Rp 15.000.000",
    description: lang === "en"
      ? "For established businesses actively pursuing enterprise clients & partners"
      : "Untuk perusahaan berkembang yang aktif cari klien & partner",
    isPopular: true,
    badge: "Popular",
    features: [
      lang === "en" ? "Company profile up to 10 pages" : "Company profile hingga 10 halaman",
      lang === "en" ? "CMS for self-managed news & project updates" : "CMS untuk update berita & proyek mandiri",
      lang === "en" ? "Filterable project portfolio showcase" : "Section portofolio / rekam jejak proyek",
      lang === "en" ? "Downloadable company brochure / PDF profile" : "Download brosur / company profile PDF",
      lang === "en" ? "Basic brand search SEO setup" : "Basic SEO untuk nama perusahaan",
      lang === "en" ? "1-Year Domain + Cloud Hosting" : "Domain + hosting 1 tahun",
      lang === "en" ? "4x revision rounds" : "Revisi 4x"
    ]
  },
  {
    name: "CUSTOM",
    price: lang === "en" ? "Contact Us" : "Hubungi Kami",
    description: lang === "en"
      ? "For holding companies, multi-subsidiary groups, or custom enterprise workflows"
      : "Untuk holding company, grup perusahaan, atau kebutuhan integrasi khusus",
    isPopular: false,
    features: [
      lang === "en" ? "Multi-subsidiary / branch architecture" : "Struktur multi-anak perusahaan / cabang",
      lang === "en" ? "Career portal with job application system" : "Halaman karir dengan sistem lamar kerja",
      lang === "en" ? "Multi-language support (ID / EN)" : "Fitur multi-bahasa (ID / EN)",
      lang === "en" ? "Internal HR / CRM systems integration" : "Integrasi sistem internal / HR",
      lang === "en" ? "Dedicated project manager" : "Dedicated project manager",
      lang === "en" ? "Regular maintenance & security warranty" : "Garansi dan maintenance berkala"
    ]
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Transparent Pricing" : "Investasi Transparan"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "An Investment in Your Enterprise Reputation" : "Investasi untuk Citra Perusahaan Kamu"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Tailored investment plans structured for your corporate maturity and operational scale."
          : "Pilihan paket fleksibel sesuai tahap dan skala operasional perusahaan Anda."}
      </p>
    </div>

    {/* 3 Pricing Cards Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg) => {
        if (pkg.isPopular) {
          return (
            <div class="relative bg-foreground text-background rounded-2xl sm:rounded-3xl p-8 sm:p-10 flex flex-col justify-between border-2 border-brand shadow-xl transition-colors">
              {/* Centered Top Border Badge */}
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                <span class="text-xs font-bold uppercase tracking-wider bg-brand text-white px-3.5 py-1 rounded-full shadow-md whitespace-nowrap">
                  {pkg.badge}
                </span>
              </div>

              <div class="space-y-6">
                <div>
                  <h3 class="typography-card-title text-background mb-2">
                    {pkg.name}
                  </h3>
                  <p class="text-sm text-background/80 font-light leading-relaxed">
                    {pkg.description}
                  </p>
                </div>

                <div class="py-5 border-y border-background/20">
                  <div class="text-3xl sm:text-4xl font-bold text-background tracking-tight">
                    {pkg.price}
                  </div>
                </div>

                <ul class="space-y-3.5 text-sm text-background/90 font-light">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-3">
                      <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                      <span class="leading-snug">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-8">
                <a
                  href={getWhatsAppLink("pricing", lang, pkg.name)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 typography-button rounded-full bg-brand text-white hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
                >
                  <span>{lang === "en" ? "Select This Plan" : "Pilih Paket Ini"}</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>
          );
        }

        return (
          <div class="bg-white border border-border/50 rounded-2xl sm:rounded-3xl p-8 sm:p-10 flex flex-col justify-between hover:border-brand/50 transition-colors shadow-sm">
            <div class="space-y-6">
              <div>
                <h3 class="typography-card-title text-foreground mb-2">
                  {pkg.name}
                </h3>
                <p class="text-sm text-muted-foreground font-light leading-relaxed">
                  {pkg.description}
                </p>
              </div>

              <div class="py-5 border-y border-border/40">
                <div class="text-3xl sm:text-4xl font-bold text-foreground tracking-tight">
                  {pkg.price}
                </div>
              </div>

              <ul class="space-y-3.5 text-sm text-muted-foreground font-light">
                {pkg.features.map((feat) => (
                  <li class="flex items-start gap-3">
                    <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                    <span class="leading-snug text-foreground/85">{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-8">
              <a
                href={getWhatsAppLink("pricing", lang, pkg.name)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 typography-button rounded-full bg-secondary/50 hover:bg-secondary border border-border/80 text-foreground transition-colors cursor-pointer"
              >
                <span>{lang === "en" ? "Select This Plan" : "Pilih Paket Ini"}</span>
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
