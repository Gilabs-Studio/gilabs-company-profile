---
import {
  Boxes,
  ShoppingCart,
  Landmark,
  Users,
  Factory,
  Network,
  TrendingUp,
  UserCheck,
  BellRing,
  FileText,
  BarChart3,
  MessageSquare,
  ArrowLeftRight
} from "lucide-react";

import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
}

const { service } = Astro.props;

const {
  featuresEyebrow,
  featuresTitle,
  featuresSubtitle,
  erpCrmModules,
} = service;

const iconMap: Record<string, any> = {
  Boxes,
  ShoppingCart,
  Landmark,
  Users,
  Factory,
  Network,
  TrendingUp,
  UserCheck,
  BellRing,
  FileText,
  BarChart3,
  MessageSquare,
};

const erpGroup = erpCrmModules?.erpGroup;
const crmGroup = erpCrmModules?.crmGroup;
const bridgeTitle = erpCrmModules?.bridgeTitle;
const bridgeDescription = erpCrmModules?.bridgeDescription;
---

<section id="modul" class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {featuresEyebrow && (
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow text-foreground/80">
            {featuresEyebrow}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
      )}

      <h2 class="typography-section-title mb-4">
        {featuresTitle}
      </h2>

      {featuresSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {featuresSubtitle}
        </p>
      )}
    </div>

    {/* 2 Big Columns Grid: ERP Side & CRM Side */}
    {erpGroup && crmGroup && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 mb-10 items-stretch">
        {/* Column 1: Sisi ERP */}
        <div class="bg-white border border-border/50 rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-6 mb-6 border-b border-border/40">
              <div>
                <span class="text-xs font-mono font-bold text-brand uppercase tracking-wider">
                  {erpGroup.badge}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-foreground mt-1">
                  {erpGroup.title}
                </h3>
              </div>
              <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center flex-shrink-0">
                <Boxes className="w-5 h-5" />
              </div>
            </div>

            <div class="space-y-5">
              {erpGroup.modules.map((mod) => {
                const IconComponent = (mod.icon && iconMap[mod.icon]) || Boxes;
                return (
                  <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-secondary/30 transition-colors">
                    <div class="w-9 h-9 rounded-lg bg-secondary/50 text-foreground flex items-center justify-center flex-shrink-0 mt-0.5">
                      <IconComponent className="w-4 h-4 text-brand" />
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-foreground leading-snug">
                        {mod.title}
                      </h4>
                      <p class="text-xs text-muted-foreground font-light leading-relaxed mt-1">
                        {mod.description}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {/* Column 2: Sisi CRM */}
        <div class="bg-white border border-border/50 rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-6 mb-6 border-b border-border/40">
              <div>
                <span class="text-xs font-mono font-bold text-brand uppercase tracking-wider">
                  {crmGroup.badge}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-foreground mt-1">
                  {crmGroup.title}
                </h3>
              </div>
              <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center flex-shrink-0">
                <TrendingUp className="w-5 h-5" />
              </div>
            </div>

            <div class="space-y-5">
              {crmGroup.modules.map((mod) => {
                const IconComponent = (mod.icon && iconMap[mod.icon]) || TrendingUp;
                return (
                  <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-secondary/30 transition-colors">
                    <div class="w-9 h-9 rounded-lg bg-secondary/50 text-foreground flex items-center justify-center flex-shrink-0 mt-0.5">
                      <IconComponent className="w-4 h-4 text-brand" />
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-foreground leading-snug">
                        {mod.title}
                      </h4>
                      <p class="text-xs text-muted-foreground font-light leading-relaxed mt-1">
                        {mod.description}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    )}

    {/* Interconnected Bridge Callout */}
    {bridgeTitle && (
      <div class="bg-[#0f172a] text-white border border-white/10 rounded-2xl p-6 sm:p-8 shadow-lg relative overflow-hidden">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 relative z-10">
          <div class="w-12 h-12 rounded-xl bg-brand text-white flex items-center justify-center flex-shrink-0 shadow-md">
            <ArrowLeftRight className="w-6 h-6 animate-pulse" />
          </div>
          <div>
            <h4 class="text-base font-bold text-white mb-1">
              {bridgeTitle}
            </h4>
            {bridgeDescription && (
              <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed">
                {bridgeDescription}
              </p>
            )}
          </div>
        </div>
      </div>
    )}
  </div>
</section>
