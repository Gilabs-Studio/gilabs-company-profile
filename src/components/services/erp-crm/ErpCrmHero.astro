---
import { ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../../lib/utils";

interface Props {
  lang: "en" | "id";
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
}

const {
  lang = "id",
  eyebrow = "Sistem ERP & CRM Custom",
  title = lang === "en"
    ? "One Unified System for Operations, Sales, and Customer Data"
    : "Satu Sistem untuk Operasional, Penjualan, dan Data Pelanggan Kamu",
  subtitle = lang === "en"
    ? "Stop running your business across dozens of disconnected spreadsheets. We build bespoke ERP and CRM platforms tailored exactly to your real operational workflows."
    : "Berhenti kerja pakai belasan spreadsheet yang nggak saling nyambung. Kami bangun ERP dan CRM yang benar-benar sesuai proses bisnis kamu.",
  primaryCtaText = lang === "en" ? "Discuss Your Needs" : "Diskusikan Kebutuhan Kamu",
  secondaryCtaText = lang === "en" ? "View Built Systems" : "Lihat Sistem yang Sudah Dibuat",
} = Astro.props;

const heroImageUrl = "/images/services/erp-crm/hero-erp-crm.png";
---

<section class="relative pt-24 sm:pt-28 md:pt-32 pb-16 md:pb-24 overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10 text-center">
    {/* Eyebrow */}
    <div class="flex items-center justify-center gap-3 sm:gap-4 mb-4 sm:mb-6">
      <div class="h-px w-8 sm:w-16 bg-primary/20"></div>
      <span class="typography-eyebrow text-foreground/80 tracking-widest">
        {eyebrow}
      </span>
      <div class="h-px w-8 sm:w-16 bg-primary/20"></div>
    </div>

    {/* Headline */}
    <h1 class="typography-hero-title mb-6 sm:mb-8 text-foreground max-w-4xl mx-auto">
      {title}
    </h1>

    {/* Subheadline */}
    <p class="typography-subtitle max-w-2xl mx-auto mb-8 sm:mb-10 text-foreground/80 leading-relaxed font-light">
      {subtitle}
    </p>

    {/* CTA Buttons */}
    <div class="flex flex-wrap items-center justify-center gap-4 mb-12 sm:mb-16">
      <a
        href={getWhatsAppLink("hero-erp-crm", lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-white bg-brand rounded-full hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
      >
        <span>{primaryCtaText}</span>
        <ArrowRight className="w-4 h-4" />
      </a>

      <a
        href="#portofolio"
        class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-foreground bg-white hover:bg-secondary/40 border border-border/80 rounded-full transition-colors cursor-pointer shadow-sm"
      >
        {secondaryCtaText}
      </a>
    </div>

    {/* Custom ERP & CRM Dashboard Showcase */}
    <div class="relative mx-auto max-w-5xl">
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-border/50 bg-[#0c1222] p-2 sm:p-3 shadow-2xl shadow-black/10">
        <div class="overflow-hidden rounded-xl sm:rounded-2xl border border-white/10 bg-[#0f172a]">
          {/* Top Mockup Browser Header Bar */}
          <div class="flex items-center justify-between px-4 py-3 bg-[#090d16] border-b border-white/10">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <div class="text-[11px] font-mono text-slate-400 bg-white/5 px-4 py-1 rounded-md border border-white/5 max-w-xs truncate">
              https://ops.company.id/dashboard/enterprise-telemetry
            </div>
            <div class="w-12"></div>
          </div>
          <img
            src={heroImageUrl}
            alt="Enterprise ERP & CRM Operations Dashboard Showcase - Gilabs"
            class="w-full h-auto object-cover select-none"
            loading="eager"
            fetchpriority="high"
            width="1920"
            height="1080"
            decoding="async"
          />
        </div>
      </div>

      {/* Floating System Integrity Badge */}
      <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 bg-white/95 backdrop-blur-md border border-border/80 rounded-full px-5 py-2.5 hidden sm:flex items-center gap-3 z-20 shadow-lg shadow-black/5">
        <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
        <span class="text-xs sm:text-sm font-medium text-foreground">
          {lang === "en" ? "Single Source of Truth • Automated Accounting & Stock • 100% Source Code Ownership" : "Satu Sumber Data Terpadu • Otomasi Akuntansi & Stok • 100% Hak Milik Source Code"}
        </span>
      </div>
    </div>
  </div>
</section>
