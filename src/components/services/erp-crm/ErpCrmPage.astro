---
import ErpCrmHero from "./ErpCrmHero.astro";
import ErpCrmProblems from "./ErpCrmProblems.astro";
import ErpCrmSolutions from "./ErpCrmSolutions.astro";
import ErpCrmModules from "./ErpCrmModules.astro";
import ErpCrmFAQ from "./ErpCrmFAQ.astro";
import ErpCrmCTA from "./ErpCrmCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="erp-crm-service-page">
  {/* 1. HERO SECTION */}
  <ErpCrmHero lang={lang} service={service} />

  {/* 2. MASALAH YANG SERING DITEMUI */}
  <ErpCrmProblems lang={lang} service={service} />

  {/* 3. SOLUSI / VALUE PROPOSITION */}
  <ErpCrmSolutions lang={lang} service={service} />

  {/* 4. STRUKTUR MODUL SISTEM (SISI ERP & CRM) */}
  <ErpCrmModules lang={lang} service={service} />

  {/* 5. FAQ */}
  <ErpCrmFAQ lang={lang} service={service} />

  {/* 6. FINAL CTA */}
  <ErpCrmCTA lang={lang} service={service} />
</div>
