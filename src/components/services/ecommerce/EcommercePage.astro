---
import EcommerceHero from "./EcommerceHero.astro";
import EcommerceSocialProof from "./EcommerceSocialProof.astro";
import EcommerceProblems from "./EcommerceProblems.astro";
import EcommerceSolutions from "./EcommerceSolutions.astro";
import EcommerceFeatures from "./EcommerceFeatures.astro";
import EcommercePortfolio from "./EcommercePortfolio.astro";
import EcommercePricing from "./EcommercePricing.astro";
import EcommerceFAQ from "./EcommerceFAQ.astro";
import EcommerceCTA from "./EcommerceCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="ecommerce-service-page">
  {/* 1. HERO SECTION */}
  <EcommerceHero
    lang={lang}
    eyebrow={service.eyebrow}
    title={service.title}
    subtitle={service.subtitle}
    primaryCtaText={service.primaryCtaText}
    secondaryCtaText={service.secondaryCtaText}
  />

  {/* 2. SOCIAL PROOF BAR */}
  <EcommerceSocialProof lang={lang} />

  {/* 3. MASALAH YANG SERING DITEMUI */}
  <EcommerceProblems lang={lang} />

  {/* 4. SOLUSI / VALUE PROPOSITION */}
  <EcommerceSolutions lang={lang} />

  {/* 5. FITUR UTAMA */}
  <EcommerceFeatures lang={lang} />

  {/* 6. PORTOFOLIO */}
  <EcommercePortfolio lang={lang} />

  {/* 7. PRICING */}
  <EcommercePricing lang={lang} />

  {/* 8. FAQ */}
  <EcommerceFAQ lang={lang} />

  {/* 9. FINAL CTA */}
  <EcommerceCTA lang={lang} />
</div>
