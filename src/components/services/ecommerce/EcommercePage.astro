---
import EcommerceHero from "./EcommerceHero.astro";
import EcommerceProblems from "./EcommerceProblems.astro";
import EcommerceSolutions from "./EcommerceSolutions.astro";
import EcommerceFeatures from "./EcommerceFeatures.astro";
import EcommerceFAQ from "./EcommerceFAQ.astro";
import EcommerceCTA from "./EcommerceCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="ecommerce-service-page">
  {/* 1. HERO SECTION */}
  <EcommerceHero lang={lang} service={service} />

  {/* 2. MASALAH YANG SERING DITEMUI */}
  <EcommerceProblems lang={lang} service={service} />

  {/* 3. SOLUSI / VALUE PROPOSITION */}
  <EcommerceSolutions lang={lang} service={service} />

  {/* 4. FITUR UTAMA */}
  <EcommerceFeatures lang={lang} service={service} />

  {/* 5. FAQ */}
  <EcommerceFAQ lang={lang} service={service} />

  {/* 6. FINAL CTA */}
  <EcommerceCTA lang={lang} service={service} />
</div>
