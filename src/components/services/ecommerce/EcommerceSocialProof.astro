---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const clients = [
  { name: "EVALIQUE BEAUTY", subtitle: "Fashion & Skincare", font: "font-serif tracking-widest font-semibold" },
  { name: "DOMUS HOME", subtitle: "Furniture & Decor", font: "font-serif italic font-medium tracking-wide" },
  { name: "TOPGUN APPAREL", subtitle: "Lifestyle Brand", font: "font-mono tracking-widest font-bold" },
  { name: "KOPI NUSANTARA", subtitle: "F&B Roastery", font: "font-sans font-black tracking-widest" },
  { name: "SAVLO DIGITAL", subtitle: "Digital Goods & Assets", font: "font-sans font-extrabold tracking-tight" },
  { name: "NEXORA RETAIL", subtitle: "Direct-to-Consumer", font: "font-mono font-bold tracking-wider" }
];
---

<section class="py-10 sm:py-14 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center max-w-6xl">
    <p class="text-xs sm:text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6 sm:mb-8">
      {lang === "en"
        ? "Trusted by fashion, F&B, and digital product brands to sell online"
        : "Dipercaya brand fashion, F&B, hingga produk digital untuk jualan online"}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16">
      {clients.map((client) => (
        <div class="group flex flex-col items-center cursor-pointer">
          <span class={`text-base sm:text-lg md:text-xl text-foreground/40 group-hover:text-brand transition-colors select-none ${client.font}`}>
            {client.name}
          </span>
          <span class="text-[10px] text-muted-foreground/60 tracking-wider uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            {client.subtitle}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
