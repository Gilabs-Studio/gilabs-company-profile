---
import { Check, ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../../lib/utils";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const packages = [
  {
    name: "BASIC",
    price: lang === "en" ? "From $350" : "Mulai Rp 5.000.000",
    description: lang === "en"
      ? "For small businesses starting their direct online sales channel"
      : "Untuk UMKM yang baru mulai jualan online",
    isPopular: false,
    features: [
      lang === "en" ? "Product catalog up to 50 items" : "Katalog produk hingga 50 item",
      lang === "en" ? "Checkout with manual bank transfer & WhatsApp" : "Checkout dengan transfer manual",
      lang === "en" ? "Responsive mobile-first design" : "Desain responsive",
      lang === "en" ? "1-Year Domain & Cloud Hosting" : "Domain & hosting 1 tahun",
      lang === "en" ? "2x revision rounds" : "Revisi 2x"
    ]
  },
  {
    name: "STANDARD",
    price: lang === "en" ? "From $950" : "Mulai Rp 15.000.000",
    description: lang === "en"
      ? "For high-growth stores requiring automated volume workflows"
      : "Untuk toko dengan volume transaksi lebih tinggi",
    isPopular: true,
    badge: "Popular",
    features: [
      lang === "en" ? "Unlimited products and categories" : "Produk unlimited",
      lang === "en" ? "Automated payment gateway (QRIS, VA, E-Wallets)" : "Payment gateway otomatis",
      lang === "en" ? "Real-time multi-courier shipping integration" : "Integrasi ongkir real-time",
      lang === "en" ? "Sales analytics, invoices & order tracking" : "Dashboard laporan penjualan",
      lang === "en" ? "4x revision rounds" : "Revisi 4x"
    ]
  },
  {
    name: "CUSTOM",
    price: lang === "en" ? "Contact Us" : "Hubungi Kami",
    description: lang === "en"
      ? "For multi-warehouse logistics or enterprise ERP sync"
      : "Untuk kebutuhan multi gudang atau multi cabang",
    isPopular: false,
    features: [
      lang === "en" ? "ERP / warehouse inventory synchronization" : "Integrasi ERP/inventory",
      lang === "en" ? "Multi-warehouse fulfillment logic" : "Multi warehouse",
      lang === "en" ? "Features tailored to your specific business model" : "Fitur sesuai model bisnis spesifik",
      lang === "en" ? "Dedicated project consultant & SLA" : "Dedicated project consultant"
    ]
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Transparent Investment" : "Investasi Transparan"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Start Selling Online with the Right Architecture" : "Mulai Jualan Online dengan Sistem yang Tepat"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Transparent packages tailored to your product catalog size and operational transaction volume."
          : "Pilihan paket fleksibel sesuai tahap pertumbuhan toko Anda, tanpa potongan komisi sepeser pun dari Gilabs."}
      </p>
    </div>

    {/* 3 Pricing Cards Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg) => {
        if (pkg.isPopular) {
          return (
            <div class="relative bg-foreground text-background rounded-2xl sm:rounded-3xl p-8 sm:p-10 flex flex-col justify-between border-2 border-brand shadow-xl transition-colors">
              {/* Centered Top Border Badge */}
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                <span class="text-xs font-bold uppercase tracking-wider bg-brand text-white px-3.5 py-1 rounded-full shadow-md whitespace-nowrap">
                  {pkg.badge}
                </span>
              </div>

              <div class="space-y-6">
                <div>
                  <h3 class="typography-card-title text-background mb-2">
                    {pkg.name}
                  </h3>
                  <p class="text-sm text-background/80 font-light leading-relaxed">
                    {pkg.description}
                  </p>
                </div>

                <div class="py-5 border-y border-background/20">
                  <div class="text-3xl sm:text-4xl font-bold text-background tracking-tight">
                    {pkg.price}
                  </div>
                </div>

                <ul class="space-y-3.5 text-sm text-background/90 font-light">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-3">
                      <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                      <span class="leading-snug">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-8">
                <a
                  href={getWhatsAppLink("pricing-ecom", lang, pkg.name)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 typography-button rounded-full bg-brand text-white hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
                >
                  <span>{lang === "en" ? "Pilih Paket Ini" : "Pilih Paket Ini"}</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>
          );
        }

        return (
          <div class="bg-white border border-border/50 rounded-2xl sm:rounded-3xl p-8 sm:p-10 flex flex-col justify-between hover:border-brand/50 transition-colors shadow-sm">
            <div class="space-y-6">
              <div>
                <h3 class="typography-card-title text-foreground mb-2">
                  {pkg.name}
                </h3>
                <p class="text-sm text-muted-foreground font-light leading-relaxed">
                  {pkg.description}
                </p>
              </div>

              <div class="py-5 border-y border-border/40">
                <div class="text-3xl sm:text-4xl font-bold text-foreground tracking-tight">
                  {pkg.price}
                </div>
              </div>

              <ul class="space-y-3.5 text-sm text-muted-foreground font-light">
                {pkg.features.map((feat) => (
                  <li class="flex items-start gap-3">
                    <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                    <span class="leading-snug text-foreground/85">{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-8">
              <a
                href={getWhatsAppLink("pricing-ecom", lang, pkg.name)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 typography-button rounded-full bg-secondary/50 hover:bg-secondary border border-border/80 text-foreground transition-colors cursor-pointer"
              >
                <span>{lang === "en" ? "Pilih Paket Ini" : "Pilih Paket Ini"}</span>
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
