---
import {
  ShoppingBag,
  ShoppingCart,
  CreditCard,
  Truck,
  Boxes,
  BarChart3,
  Tag,
  LayoutDashboard,
} from "lucide-react";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
}

const { service } = Astro.props;

const {
  featuresEyebrow,
  featuresTitle,
  featuresSubtitle,
  features = [],
} = service;

const icons = [
  ShoppingBag,
  ShoppingCart,
  CreditCard,
  Truck,
  Boxes,
  BarChart3,
  Tag,
  LayoutDashboard,
];
---

<section id="fitur" class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {featuresEyebrow && (
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow text-foreground/80">
            {featuresEyebrow}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
      )}

      <h2 class="typography-section-title mb-4">
        {featuresTitle}
      </h2>

      {featuresSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {featuresSubtitle}
        </p>
      )}
    </div>

    {/* Features Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {features.map((feature, idx) => {
        const IconComponent = icons[idx % icons.length];
        const number = feature.number || String(idx + 1).padStart(2, "0");
        return (
          <div class="bg-white border border-border/50 rounded-2xl p-6 sm:p-7 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
            <div>
              {/* Top row: Number and Icon */}
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs font-semibold text-brand tracking-wider bg-brand/5 px-2.5 py-1 rounded-md border border-brand/10">
                  {number}
                </span>
                <IconComponent className="w-5 h-5 text-brand" />
              </div>

              <h3 class="text-base sm:text-lg font-semibold text-foreground mb-2 group-hover:text-brand transition-colors">
                {feature.title}
              </h3>

              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed font-light">
                {feature.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
