---
import { ArrowRight, CheckCircle2, ChevronDown } from "lucide-react";
import { getWhatsAppLink } from "../../lib/utils";
import { servicesCatalogId, servicesCatalogEn } from "../../data/services/catalog";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;
const data = lang === "en" ? servicesCatalogEn : servicesCatalogId;
const { hero } = data;
---

<section class="relative min-h-[100dvh] flex flex-col justify-center items-center pt-24 pb-16 sm:pt-28 sm:pb-20 overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl relative z-10 text-center my-auto">
    {/* Eyebrow */}
    <div class="flex items-center justify-center gap-3 sm:gap-4 mb-4 sm:mb-6">
      <div class="h-px w-8 sm:w-16 bg-primary/20"></div>
      <span class="typography-eyebrow text-foreground/80 tracking-widest">
        {hero.eyebrow}
      </span>
      <div class="h-px w-8 sm:w-16 bg-primary/20"></div>
    </div>

    {/* Headline - 2 lines max with text-balance */}
    <h1 class="typography-hero-title mb-6 sm:mb-8 text-foreground max-w-3xl mx-auto text-balance">
      {hero.title}
    </h1>

    {/* Subheadline - 2 lines max with text-balance */}
    <p class="typography-subtitle max-w-2xl mx-auto mb-8 sm:mb-10 text-foreground/80 leading-relaxed font-light text-balance">
      {hero.subtitle}
    </p>

    {/* CTA Buttons */}
    <div class="flex flex-wrap items-center justify-center gap-4 mb-10 sm:mb-14">
      <a
        href={getWhatsAppLink("services-hero", lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-white bg-brand rounded-full hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
      >
        <span>{hero.primaryCta}</span>
        <ArrowRight className="w-4 h-4" />
      </a>

      <a
        href="#services-catalog"
        class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-foreground bg-white hover:bg-secondary/40 border border-border/80 rounded-full transition-colors cursor-pointer shadow-sm"
      >
        {hero.secondaryCta}
      </a>
    </div>

    {/* Trust Highlights */}
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 pt-6 sm:pt-8 border-t border-border/40 max-w-3xl mx-auto">
      {hero.trustPills.map((pill) => (
        <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-muted-foreground">
          <CheckCircle2 className="w-4 h-4 text-brand shrink-0" />
          <span>{pill}</span>
        </div>
      ))}
    </div>
  </div>

  {/* Subtle Scroll Down Anchor */}
  <a
    href="#services-catalog"
    aria-label="Scroll to catalog"
    class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 text-muted-foreground/50 hover:text-brand transition-colors cursor-pointer animate-bounce"
  >
    <ChevronDown className="w-5 h-5 sm:w-6 sm:h-6" />
  </a>
</section>
