---
import LandingPageHero from "./LandingPageHero.astro";
import LandingPageProblems from "./LandingPageProblems.astro";
import LandingPageSolutions from "./LandingPageSolutions.astro";
import LandingPageAudience from "./LandingPageAudience.astro";
import LandingPageFAQ from "./LandingPageFAQ.astro";
import LandingPageCTA from "./LandingPageCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="landing-page-service-page">
  {/* 1. HERO SECTION */}
  <LandingPageHero lang={lang} service={service} />

  {/* 2. MASALAH YANG SERING DITEMUI */}
  <LandingPageProblems lang={lang} service={service} />

  {/* 3. SOLUSI / VALUE PROPOSITION */}
  <LandingPageSolutions lang={lang} service={service} />

  {/* 4. COCOK UNTUK */}
  <LandingPageAudience lang={lang} service={service} />

  {/* 5. FAQ */}
  <LandingPageFAQ lang={lang} service={service} />

  {/* 6. FINAL CTA */}
  <LandingPageCTA lang={lang} service={service} />
</div>
