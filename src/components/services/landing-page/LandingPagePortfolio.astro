---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const projects = [
  {
    title: "Evalique Skin & Beauty",
    campaign: lang === "en" ? "Paid Ads Campaign & Direct Product Sales" : "Campaign Iklan Berbayar & Flash Sale Produk",
    result: lang === "en" ? "Conversion rate surged from 1.2% to 4.8%" : "Conversion rate naik dari 1.2% ke 4.8%",
    image: "/images/services/landing-page/portfolio-evalique-lp.png",
    alt: "Landing Page Evalique Beauty - Gilabs",
    tags: ["Direct WA Order", "Meta Ads Ready", "PageSpeed 98"]
  },
  {
    title: "TopGun Barber & Grooming",
    campaign: lang === "en" ? "Event Promotion & Appointment Bookings" : "Promosi Event & Reservasi Layanan Online",
    result: lang === "en" ? "Online reservations surged 240% with zero friction" : "Booking online melonjak 240% tanpa antrean manual",
    image: "/images/services/landing-page/portfolio-topgun-lp.png",
    alt: "Landing Page TopGun Barber - Gilabs",
    tags: ["Instant Booking", "Google Ads Traffic", "Mobile-First"]
  },
  {
    title: "SalesView Platform",
    campaign: lang === "en" ? "B2B Pre-Launch & Lead Generation" : "Pre-Launch B2B & Lead Generation Prospek",
    result: lang === "en" ? "Lead qualification rate increased 3.5x in 30 days" : "Lead qualification rate meningkat 3.5x dalam 30 hari",
    image: "/images/services/landing-page/portfolio-salesview-lp.png",
    alt: "Landing Page SalesView - Gilabs",
    tags: ["Lead Magnet", "CRM Sync", "Conversion Analytics"]
  }
];

const portfolioUrl = lang === "en" ? "/en/portfolio" : `/${lang}/portfolio`;
---

<section id="portofolio" class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Proven Conversions" : "Portofolio Unggulan"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Landing Pages Proven to Convert" : "Landing Page yang Sudah Terbukti Convert"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Real campaign pages tested against live paid ad traffic that deliver measurable return on investment."
          : "Halaman kampanye nyata yang telah diuji langsung dengan traffic iklan berbayar dan terbukti melipatgandakan ROI."}
      </p>
    </div>

    {/* Portfolio Grid - 3 Large Cards */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12 md:mb-16">
      {projects.map((project) => (
        <article class="bg-white border border-border/50 rounded-2xl sm:rounded-3xl overflow-hidden hover:border-brand/50 transition-colors shadow-md shadow-black/5 flex flex-col justify-between group">
          {/* Large Screenshot Image Container */}
          <div class="relative aspect-[16/10] overflow-hidden bg-muted/20 border-b border-border/40">
            <img
              src={project.image}
              alt={project.alt}
              class="w-full h-full object-cover select-none"
              loading="lazy"
              decoding="async"
              width="800"
              height="500"
            />
          </div>

          {/* Card Info */}
          <div class="p-6 sm:p-7 flex flex-col grow justify-between">
            <div>
              {/* Project Title */}
              <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
                {project.title}
              </h3>

              {/* Short Measurable Result */}
              <div class="inline-flex items-center px-3.5 py-1.5 rounded-xl border border-brand/20 bg-brand/5 text-brand font-medium text-xs mb-4">
                <span>{project.result}</span>
              </div>
            </div>

            {/* Tech Tags */}
            <div class="pt-4 border-t border-border/40 flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-[11px] font-mono font-medium bg-secondary/60 text-foreground/70 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={portfolioUrl}
                class="text-xs font-semibold text-brand hover:underline cursor-pointer"
              >
                {lang === "en" ? "Details →" : "Detail →"}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Bottom CTA button */}
    <div class="text-center">
      <a
        href={portfolioUrl}
        class="inline-flex items-center justify-center px-8 py-3.5 sm:py-4 typography-button text-foreground bg-white hover:bg-secondary/40 border border-border/80 rounded-full transition-colors cursor-pointer shadow-sm"
      >
        <span>{lang === "en" ? "View Complete Portfolio" : "Lihat Portofolio Lengkap"}</span>
      </a>
    </div>
  </div>
</section>
