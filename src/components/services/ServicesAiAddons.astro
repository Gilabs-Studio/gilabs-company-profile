---
import { LottieIcon } from '../ui/LottieIcon';

const { lang } = Astro.props;

const content = {
  id: {
    eyebrow: "Lapisan Kecerdasan",
    title: "Smart Automation &",
    titleHighlight: "Intelligent Features",
    subtitle: "Tingkatkan efisiensi operasional dengan fitur otomatisasi dan analisis cerdas.",
    description: "Bayangkan sistem Anda yang bisa berpikir. Yang bisa menganalisis data, mengambil keputusan, dan melakukan tindakan otomatis — tanpa campur tangan manusia. Itulah yang kami bangun dengan Smart Automation.",
    packages: [
      {
        name: "Auto Lead Scoring & Analysis",
        story: "Sales team Anda tidak perlu lagi menghabiskan waktu untuk menganalisis leads. Sistem kami akan otomatis menilai dan memprioritaskan leads berdasarkan data historis dan pola yang terdeteksi.",
        outcome: "Sales team fokus hanya pada leads yang berpotensi tinggi"
      },
      {
        name: "Smart Report & Analytics",
        story: "Lupakan laporan manual yang memakan waktu. Sistem kami akan otomatis mengumpulkan data, menganalisis tren, dan menghasilkan insight yang actionable untuk manajemen.",
        outcome: "Keputusan bisnis lebih cepat dan data-driven"
      },
      {
        name: "Intelligent Document Processing",
        story: "Sistem yang bisa membaca dokumen, mengekstrak informasi penting, dan menjawab pertanyaan dari konten dokumen. Seperti asisten yang tidak pernah lelah.",
        outcome: "Proses dokumen lebih cepat dan akurat"
      },
      {
        name: "Workflow Automation System",
        story: "Sistem yang bisa mengambil tindakan otomatis berdasarkan kondisi tertentu. Update pipeline di CRM, generate invoice di ERP, atau trigger workflow lainnya — semuanya otomatis.",
        outcome: "Operasional bisnis lebih efisien dan minim error"
      }
    ]
  },
  en: {
    eyebrow: "Intelligence Layer",
    title: "Smart Automation &",
    titleHighlight: "Intelligent Features",
    subtitle: "Increase operational efficiency with automation and intelligent analysis features.",
    description: "Imagine a system that can think. That can analyze data, make decisions, and take automatic actions — without human intervention. That's what we build with Smart Automation.",
    packages: [
      {
        name: "Auto Lead Scoring & Analysis",
        story: "Your sales team no longer needs to spend time analyzing leads. Our system will automatically score and prioritize leads based on historical data and detected patterns.",
        outcome: "Sales team focuses only on high-potential leads"
      },
      {
        name: "Smart Report & Analytics",
        story: "Forget time-consuming manual reports. Our system will automatically collect data, analyze trends, and generate actionable insights for management.",
        outcome: "Faster, data-driven business decisions"
      },
      {
        name: "Intelligent Document Processing",
        story: "A system that can read documents, extract important information, and answer questions from document content. Like an assistant that never tires.",
        outcome: "Faster and more accurate document processing"
      },
      {
        name: "Workflow Automation System",
        story: "A system that can take automatic actions based on certain conditions. Update pipeline in CRM, generate invoice in ERP, or trigger other workflows — all automatic.",
        outcome: "More efficient business operations with minimal errors"
      }
    ]
  }
};

const t = content[lang as keyof typeof content] as typeof content.en;
---

<section class="py-24 md:py-32 lg:py-40 relative bg-muted/30">
  <!-- Section divider with glow -->
  <div class="absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-border to-transparent"></div>
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-linear-to-r from-transparent via-indigo-500/30 to-transparent blur-sm"></div>
  
  <!-- AI gradient background effect with more depth -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>
  
  <div class="container mx-auto px-4 relative z-10">
    <!-- Section Header -->
    <div class="max-w-4xl mb-16 md:mb-24">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-400 text-sm font-medium mb-6 shadow-lg shadow-indigo-500/10">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="uppercase tracking-[0.15em]">{t.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-foreground mb-6 leading-[1.1]">
        {t.title} <br class="hidden md:block" />
        <span class="ai-gradient-text">{t.titleHighlight}</span>
      </h2>
      <p class="text-lg md:text-xl text-muted-foreground leading-relaxed mb-4 max-w-2xl">
        {t.subtitle}
      </p>
      <p class="text-base md:text-lg text-muted-foreground/80 leading-relaxed max-w-2xl">
        {t.description}
      </p>
    </div>

    <!-- AI Packages Grid - Bento Style -->
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {t.packages.map((pkg: typeof t.packages[0], index: number) => {
        return (
          <article class="group relative bg-card border border-border/50 rounded-3xl p-8 md:p-10 lg:p-12 shadow-xl shadow-foreground/10 hover:border-indigo-500/40 hover:shadow-2xl hover:shadow-indigo-500/20 hover:-translate-y-2 transition-all duration-500 overflow-hidden">
            <!-- Gradient overlay on hover -->
            <div class="absolute inset-0 bg-linear-to-br from-indigo-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <!-- Animated glow on hover -->
            <div class="absolute -inset-1 bg-linear-to-br from-indigo-500/20 via-purple-500/20 to-indigo-500/20 rounded-3xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>
            
            <!-- Number -->
            <div class="absolute top-8 right-8 md:top-10 md:right-10">
              <span class="text-6xl md:text-7xl font-bold text-foreground/[0.03] group-hover:text-indigo-500/10 transition-colors duration-500">
                0{index + 1}
              </span>
            </div>
            
            <!-- Content -->
            <div class="relative z-10">
              <!-- Icon -->
              <div class="mb-6">
                <LottieIcon 
                  src="/icon/artificial-intelligence.json" 
                  className="w-20 h-20 md:w-24 md:h-24"
                  client:only="react"
                />
              </div>
              
              <!-- Title -->
              <h3 class="text-xl md:text-2xl font-bold text-foreground mb-4 leading-tight group-hover:text-indigo-400 transition-colors duration-300">
                {pkg.name}
              </h3>
              
              <!-- Story -->
              <p class="text-muted-foreground leading-relaxed mb-6">
                {pkg.story}
              </p>
              
              <!-- Outcome -->
              <div class="flex items-start gap-3 pt-6 border-t border-border/50">
                <div class="w-6 h-6 rounded-full bg-linear-to-br from-indigo-500/20 to-purple-500/20 shadow-md shadow-indigo-500/20 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-indigo-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </div>
                <span class="text-sm font-medium text-indigo-400">{pkg.outcome}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
