---
import { ArrowRight, Sparkles } from "lucide-react";
import { getWhatsAppLink } from "../../lib/utils";
import { servicesCatalogId, servicesCatalogEn } from "../../data/services/catalog";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;
const data = lang === "en" ? servicesCatalogEn : servicesCatalogId;
const { aiAutomation } = data;
---

<section id="smart-automation" class="py-16 md:py-24 relative bg-muted/20">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80 flex items-center gap-2">
          <Sparkles className="w-3.5 h-3.5 text-brand" />
          <span>{aiAutomation.eyebrow}</span>
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4 max-w-2xl mx-auto text-balance">
        {aiAutomation.title}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light text-balance">
        {aiAutomation.subtitle}
      </p>
    </div>

    {/* 4 Impact Stat Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12 sm:mb-16 items-stretch">
      {aiAutomation.metrics.map((metric) => (
        <div class="bg-white border border-border/50 rounded-2xl p-6 sm:p-7 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group text-center">
          <div>
            <p class="text-3xl sm:text-4xl font-mono font-bold text-brand mb-2 group-hover:scale-105 transition-transform duration-200">
              {metric.stat}
            </p>
            <h3 class="typography-card-title text-foreground mb-2 text-base font-semibold">
              {metric.label}
            </h3>
            <p class="typography-body text-muted-foreground text-xs leading-relaxed font-light">
              {metric.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    {/* Use Cases Badges */}
    <div class="max-w-3xl mx-auto mb-10 text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground font-medium mb-4">
        {aiAutomation.useCasesLabel}
      </p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {aiAutomation.useCases.map((useCase) => (
          <span class="px-4 py-2 rounded-full bg-white text-foreground/80 text-xs sm:text-sm font-medium border border-border/50 shadow-xs hover:border-brand/40 transition-colors">
            {useCase}
          </span>
        ))}
      </div>
    </div>

    {/* Bottom CTA */}
    <div class="max-w-xl mx-auto text-center">
      <a
        href={getWhatsAppLink("services-ai", lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 typography-button text-white bg-brand rounded-full hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
      >
        <span>{aiAutomation.ctaText}</span>
        <ArrowRight className="w-4 h-4" />
      </a>
      <p class="text-xs text-muted-foreground mt-3 font-light">
        {aiAutomation.ctaNote}
      </p>
    </div>
  </div>
</section>
