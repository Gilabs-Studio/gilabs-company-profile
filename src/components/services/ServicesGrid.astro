---
import {
  Building2,
  Store,
  Briefcase,
  Layers,
  Smartphone,
  Globe,
  ShoppingCart,
  Award,
  Target,
  ArrowRight,
} from "lucide-react";
import { servicesCatalogId, servicesCatalogEn } from "../../data/services/catalog";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;
const data = lang === "en" ? servicesCatalogEn : servicesCatalogId;
const { catalog } = data;

const iconMap = {
  Building2,
  Store,
  Briefcase,
  Layers,
  Smartphone,
  Globe,
  ShoppingCart,
  Award,
  Target,
};
---

<section id="services-catalog" class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-14 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {catalog.eyebrow}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {catalog.title}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {catalog.subtitle}
      </p>
    </div>

    {/* Filter Buttons */}
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10 md:mb-12">
      <button
        type="button"
        data-filter="all"
        class="catalog-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-medium transition-all cursor-pointer bg-brand text-white shadow-sm shadow-brand/20"
      >
        {catalog.filterAll}
      </button>
      <button
        type="button"
        data-filter="enterprise"
        class="catalog-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-medium transition-all cursor-pointer bg-white text-foreground/80 hover:bg-secondary/60 border border-border/60"
      >
        {catalog.filterEnterprise}
      </button>
      <button
        type="button"
        data-filter="software"
        class="catalog-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-medium transition-all cursor-pointer bg-white text-foreground/80 hover:bg-secondary/60 border border-border/60"
      >
        {catalog.filterSoftware}
      </button>
      <button
        type="button"
        data-filter="web"
        class="catalog-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-medium transition-all cursor-pointer bg-white text-foreground/80 hover:bg-secondary/60 border border-border/60"
      >
        {catalog.filterWeb}
      </button>
    </div>

    {/* 9 Services Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch" id="services-grid-container">
      {catalog.items.map((item) => {
        const IconComponent = iconMap[item.icon as keyof typeof iconMap] || Layers;
        return (
          <a
            href={`/${lang}/services/${item.slug}`}
            data-category={item.category}
            class="service-card bg-white border border-border/50 rounded-2xl p-7 sm:p-8 hover:border-brand/50 transition-all duration-300 shadow-sm flex flex-col justify-between group cursor-pointer"
          >
            <div>
              {/* Header Icon + Category Badge */}
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-xl bg-brand/10 text-brand flex items-center justify-center group-hover:bg-brand group-hover:text-white transition-colors duration-200">
                  <IconComponent className="w-6 h-6" />
                </div>
                <span class="text-xs font-medium px-3 py-1 rounded-full bg-secondary/80 text-foreground/70 border border-border/40">
                  {item.categoryLabel}
                </span>
              </div>

              {/* Title */}
              <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
                {item.title}
              </h3>

              {/* Description */}
              <p class="typography-body text-muted-foreground leading-relaxed font-light text-sm mb-6">
                {item.description}
              </p>

              {/* Highlights */}
              <ul class="space-y-2 mb-6 border-t border-border/40 pt-4">
                {item.highlights.map((highlight) => (
                  <li class="flex items-center gap-2 text-xs text-foreground/80 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand/70 group-hover:bg-brand shrink-0 transition-colors"></span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* Bottom Action Link */}
            <div class="pt-4 border-t border-border/40 flex items-center justify-between text-sm font-medium text-brand">
              <span>{catalog.viewServiceText}</span>
              <ArrowRight className="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  function initCatalogFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".catalog-filter-btn");
    const serviceCards = document.querySelectorAll<HTMLElement>(".service-card");

    if (!filterButtons.length || !serviceCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        // Update button states
        filterButtons.forEach((b) => {
          b.classList.remove("bg-brand", "text-white", "shadow-sm", "shadow-brand/20");
          b.classList.add("bg-white", "text-foreground/80", "border", "border-border/60");
        });
        btn.classList.remove("bg-white", "text-foreground/80", "border", "border-border/60");
        btn.classList.add("bg-brand", "text-white", "shadow-sm", "shadow-brand/20");

        // Filter cards
        serviceCards.forEach((card) => {
          const category = card.getAttribute("data-category");
          if (filter === "all" || category === filter) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  // Run on initial load and View Transitions if enabled
  initCatalogFilter();
  document.addEventListener("astro:page-load", initCatalogFilter);
</script>
