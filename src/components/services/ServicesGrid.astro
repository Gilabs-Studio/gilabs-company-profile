---
import { pricingData } from '../../data/pricing';
import { LottieIcon } from '../ui/LottieIcon';

const { lang } = Astro.props;
const services = pricingData[lang].services;

const iconPaths = [
  '/icon/web-developer.json',
  '/icon/mobile.json',
  '/icon/system.json',
  '/icon/maintenance.json',
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
        {services.items.map((service, index) => (
          <div class="flex flex-col items-center text-center">
            <div class="w-16 h-16 md:w-20 md:h-20 mb-6 flex items-center justify-center">
              <LottieIcon 
                src={iconPaths[index]} 
                className="w-full h-full"
                client:only="react"
              />
            </div>
            <h3 class="text-base md:text-lg font-semibold text-foreground mb-3">
              {service.title}
            </h3>
            <p class="text-sm text-muted-foreground mb-4 line-clamp-3">
              {service.body[0]}
            </p>
            <p class="text-xs md:text-sm font-medium text-brand">
              {service.tagline.replace('→ ', '')}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
