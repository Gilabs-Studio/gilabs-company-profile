---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const pillars = [
  {
    number: "01",
    title: lang === "en" ? "Design That Sells" : "Desain yang Menjual",
    description: lang === "en"
      ? "Clean, intentional aesthetics focused on a singular conversion goal without clutter or confusing user friction."
      : "Tampilan bersih, fokus ke satu tujuan, nggak bikin bingung pengunjung.",
    image: "/images/services/web-dev/solution-design.jpg",
    alt: "Wireframe dan Desain Website Berkonversi Tinggi",
    badge: lang === "en" ? "Conversion-Centric" : "Fokus Konversi",
    points: [
      lang === "en" ? "Hierarchical visual flow guiding visitors to CTA" : "Hierarki visual jelas mengarahkan pengunjung ke aksi beli",
      lang === "en" ? "Frictionless form & WhatsApp quick triggers" : "Tombol kontak & form tanpa hambatan",
      lang === "en" ? "Brand consistency tailored to your market" : "Karakter visual eksklusif sesuai persona brand Anda"
    ]
  },
  {
    number: "02",
    title: lang === "en" ? "Speed as a Top Priority" : "Kecepatan Jadi Prioritas",
    description: lang === "en"
      ? "Sub-2-second load times, tested and proven on Google PageSpeed Insights for peak Core Web Vitals performance."
      : "Loading di bawah 2 detik, teruji di Google PageSpeed.",
    image: "/images/services/web-dev/solution-speed.jpg",
    alt: "Google PageSpeed 100 Score Scorecard",
    badge: lang === "en" ? "Core Web Vitals Pass" : "Google PageSpeed 100",
    points: [
      lang === "en" ? "Sub-second initial paint with edge caching" : "Loading sub-detik dengan edge CDN & asset optimization",
      lang === "en" ? "Zero bloated plugins or heavy script lags" : "Bebas plugin lambat seperti CMS lawas",
      lang === "en" ? "Optimized WebP/AVIF imagery pipeline" : "Kompresi gambar cerdas tanpa pecah"
    ]
  },
  {
    number: "03",
    title: lang === "en" ? "SEO-Ready From Day One" : "SEO-Ready dari Awal",
    description: lang === "en"
      ? "Semantically clean structure ready for Google indexing and search ranking from the very first hour online."
      : "Struktur sudah rapi buat mesin pencari sejak hari pertama online.",
    image: "/images/services/web-dev/solution-seo.jpg",
    alt: "Google Search Ranking SERP Preview",
    badge: lang === "en" ? "Structured Data & SERP" : "Optimasi Mesin Pencari",
    points: [
      lang === "en" ? "Schema.org JSON-LD rich snippets integration" : "Integrasi Schema.org JSON-LD otomatis",
      lang === "en" ? "Automated XML sitemap & Open Graph tags" : "Sitemap otomatis & preview media sosial rapi",
      lang === "en" ? "Clean URL slugs and semantic heading tags" : "Struktur heading semantik ramah Google bot"
    ]
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Our Core Philosophy" : "Solusi & Value Proposition"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "We Build for Business Impact, Not Just Aesthetics" : "Kami Bangun dari Sisi Bisnis, Bukan Cuma Desain"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Every single section is engineered to answer one critical question in your visitor's mind: why should I trust this business?"
          : "Setiap section kami rancang buat jawab satu pertanyaan di kepala pengunjung: kenapa saya harus percaya sama bisnis ini?"}
      </p>
    </div>

    {/* 3 Pillars Grid - Landing Page Consistent Cards (bg-white, border-border/50, shadow-sm) */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {pillars.map((pillar) => (
        <article class="bg-white border border-border/50 rounded-2xl overflow-hidden hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
          {/* Top Image Banner */}
          <div class="relative aspect-[16/10] overflow-hidden bg-muted/20 border-b border-border/40">
            <img
              src={pillar.image}
              alt={pillar.alt}
              class="w-full h-full object-cover select-none"
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
            />
          </div>

          {/* Content Details */}
          <div class="p-6 sm:p-7 flex flex-col grow justify-between">
            <div>
              <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
                {pillar.title}
              </h3>

              <p class="typography-body text-muted-foreground leading-relaxed font-light mb-6">
                {pillar.description}
              </p>
            </div>

            {/* Bullet Highlights */}
            <div class="pt-4 border-t border-border/40">
              <ul class="space-y-2.5 text-xs sm:text-sm text-foreground/80 font-light">
                {pillar.points.map((pt) => (
                  <li class="flex items-start gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0 mt-1.5"></span>
                    <span class="leading-snug">{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
