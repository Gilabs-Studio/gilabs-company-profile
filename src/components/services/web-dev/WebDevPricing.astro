---
import { Check, ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../../lib/utils";

interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const packages = [
  {
    name: "BASIC",
    price: lang === "en" ? "From IDR 5,000,000" : "Mulai Rp 5.000.000",
    description: lang === "en" ? "Perfect for SMEs starting their online presence" : "Cocok untuk UMKM yang baru mulai online",
    isPopular: false,
    features: [
      lang === "en" ? "Simple landing page or company profile" : "Landing page atau company profile sederhana",
      lang === "en" ? "100% responsive mobile & desktop design" : "Desain responsive",
      lang === "en" ? "1-Year free custom domain & high-speed hosting" : "Domain & hosting 1 tahun",
      lang === "en" ? "2x revision rounds" : "Revisi 2x"
    ]
  },
  {
    name: "STANDARD",
    price: lang === "en" ? "From IDR 15,000,000" : "Mulai Rp 15.000.000",
    description: lang === "en" ? "For growing businesses needing a complete web presence" : "Untuk bisnis yang butuh kehadiran lebih lengkap",
    isPopular: true,
    badge: lang === "en" ? "Most Popular" : "Paling Banyak Dipilih",
    features: [
      lang === "en" ? "Multi-page website (5-10 pages)" : "Website multi halaman (5-10 halaman)",
      lang === "en" ? "Fundamental on-page SEO & meta tags" : "SEO on-page dasar",
      lang === "en" ? "CMS integration: manage text & content easily" : "Integrasi CMS, konten bisa kamu ubah sendiri",
      lang === "en" ? "4x revision rounds" : "Revisi 4x",
      lang === "en" ? "Lead capture & WhatsApp integration" : "Integrasi tombol WhatsApp & formulir kontak"
    ]
  },
  {
    name: "CUSTOM",
    price: lang === "en" ? "Contact Us" : "Hubungi Kami",
    description: lang === "en" ? "For specific, highly tailored, and complex web architecture" : "Untuk kebutuhan spesifik dan kompleks",
    isPopular: false,
    features: [
      lang === "en" ? "Custom features tailored to business logic" : "Fitur sesuai kebutuhan bisnis",
      lang === "en" ? "Third-party systems & API integration" : "Integrasi sistem pihak ketiga",
      lang === "en" ? "Long-term scalability & cloud infra" : "Skalabilitas jangka panjang",
      lang === "en" ? "Dedicated tech consultant & SLA" : "Konsultasi dedicated"
    ]
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Transparent Pricing" : "Investasi Transparan"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Clear Investment, No Hidden Fees" : "Investasi yang Jelas, Tanpa Biaya Tersembunyi"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Transparent packages tailored to your current stage of business growth, with full source code ownership."
          : "Paket transparan yang dirancang sesuai tahap pertumbuhan bisnis Anda, dengan 100% kepemilikan source code."}
      </p>
    </div>

    {/* 3 Pricing Cards Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg) => {
        if (pkg.isPopular) {
          return (
            <div class="bg-foreground text-background rounded-2xl sm:rounded-3xl p-8 sm:p-10 flex flex-col justify-between border-2 border-brand shadow-xl transition-colors">
              <div class="space-y-6">
                {/* Popular Badge */}
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-wider bg-brand text-white px-3.5 py-1 rounded-full shadow-sm">
                    {pkg.badge}
                  </span>
                </div>

                <div>
                  <h3 class="typography-card-title text-background mb-2">
                    {pkg.name}
                  </h3>
                  <p class="text-sm text-background/80 font-light leading-relaxed">
                    {pkg.description}
                  </p>
                </div>

                <div class="py-5 border-y border-background/20">
                  <div class="text-3xl sm:text-4xl font-bold text-background tracking-tight">
                    {pkg.price}
                  </div>
                </div>

                <ul class="space-y-3.5 text-sm text-background/90 font-light">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-3">
                      <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                      <span class="leading-snug">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-8">
                <a
                  href={getWhatsAppLink("pricing", lang, pkg.name)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 typography-button rounded-full bg-brand text-white hover:bg-brand/90 transition-colors cursor-pointer shadow-md shadow-brand/20"
                >
                  <span>{lang === "en" ? "Select This Plan" : "Pilih Paket Ini"}</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>
          );
        }

        return (
          <div class="bg-white border border-border/50 rounded-2xl sm:rounded-3xl p-8 sm:p-10 flex flex-col justify-between hover:border-brand/50 transition-colors shadow-sm">
            <div class="space-y-6">
              <div>
                <h3 class="typography-card-title text-foreground mb-2">
                  {pkg.name}
                </h3>
                <p class="text-sm text-muted-foreground font-light leading-relaxed">
                  {pkg.description}
                </p>
              </div>

              <div class="py-5 border-y border-border/40">
                <div class="text-3xl sm:text-4xl font-bold text-foreground tracking-tight">
                  {pkg.price}
                </div>
              </div>

              <ul class="space-y-3.5 text-sm text-muted-foreground font-light">
                {pkg.features.map((feat) => (
                  <li class="flex items-start gap-3">
                    <Check className="w-4 h-4 text-brand flex-shrink-0 mt-0.5" />
                    <span class="leading-snug text-foreground/85">{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-8">
              <a
                href={getWhatsAppLink("pricing", lang, pkg.name)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 typography-button rounded-full bg-secondary/50 hover:bg-secondary border border-border/80 text-foreground transition-colors cursor-pointer"
              >
                <span>{lang === "en" ? "Select This Plan" : "Pilih Paket Ini"}</span>
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
