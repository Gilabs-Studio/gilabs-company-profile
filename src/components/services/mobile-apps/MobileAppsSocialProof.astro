---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const stores = [
  { name: "Google Play Store", type: "Official Android Store", font: "font-sans font-bold tracking-tight" },
  { name: "Apple App Store", type: "Official iOS Platform", font: "font-sans font-bold tracking-tight" },
  { name: "Flutter Engine", type: "Cross-Platform Framework", font: "font-mono font-semibold tracking-wide" },
  { name: "Firebase Cloud", type: "Push & Realtime Telemetry", font: "font-mono font-medium tracking-wide" },
  { name: "Supabase Mobile", type: "Auth & PostgreSQL Engine", font: "font-sans font-black tracking-wider" }
];
---

<section class="py-10 sm:py-14 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center max-w-6xl">
    <p class="text-xs sm:text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6 sm:mb-8">
      {lang === "en"
        ? "Apps we built are actively used by thousands of daily mobile users"
        : "Aplikasi yang kami bangun sudah digunakan ribuan pengguna aktif"}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16">
      {stores.map((item) => (
        <div class="group flex flex-col items-center cursor-pointer">
          <span class={`text-base sm:text-lg md:text-xl text-foreground/40 group-hover:text-brand transition-colors select-none ${item.font}`}>
            {item.name}
          </span>
          <span class="text-[10px] text-muted-foreground/60 tracking-wider uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            {item.type}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
