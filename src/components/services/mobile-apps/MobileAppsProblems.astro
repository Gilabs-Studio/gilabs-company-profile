---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const problems = [
  {
    number: "01",
    title: lang === "en" ? "Confusing UX" : "UX Membingungkan",
    description: lang === "en"
      ? "Users install, struggle with the navigation flow, and quickly uninstall because it is too cumbersome to use."
      : "User install, coba sebentar, lalu uninstall karena ribet dipakai.",
    metric: lang === "en" ? "High drop-off on first app launch" : "Tingginya angka churn pada pembukaan pertama"
  },
  {
    number: "02",
    title: lang === "en" ? "Sluggish Performance" : "Performa Lambat",
    description: lang === "en"
      ? "Laggy scrolling, high memory consumption, frequent crashes, and negative store reviews that kill discovery."
      : "Aplikasi lag, sering force close, rating jatuh di store.",
    metric: lang === "en" ? "Low app store rating under 3 stars" : "Rating anjlok di bawah 3 bintang"
  },
  {
    number: "03",
    title: lang === "en" ? "Zero Maintenance Strategy" : "Nggak Ada Rencana Maintenance",
    description: lang === "en"
      ? "When Apple or Google releases a major OS update, unmaintained apps crash and break without technical care."
      : "Update OS baru, aplikasi malah error karena nggak pernah dipelihara.",
    metric: lang === "en" ? "Incompatibility with modern devices" : "Kerusakan fitur saat pembaruan sistem operasi"
  }
];
---

<section class="py-16 md:py-24 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow text-foreground/80">
          {lang === "en" ? "Common Mobile Pitfalls" : "Masalah yang Sering Ditemui"}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>

      <h2 class="typography-section-title mb-4">
        {lang === "en" ? "Why Do Many Apps Fail in Users' Hands?" : "Kenapa Banyak Aplikasi Gagal di Tangan User?"}
      </h2>

      <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
        {lang === "en"
          ? "Three fundamental pitfalls that cause mobile apps to be uninstalled within minutes of downloading."
          : "Tiga kendala utama yang menyebabkan aplikasi ditinggalkan pengguna sesaat setelah diinstal."}
      </p>
    </div>

    {/* 3 Columns Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {problems.map((problem) => (
        <div class="bg-white border border-border/50 rounded-2xl p-7 sm:p-8 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
          <div>
            <div class="mb-5">
              <span class="text-3xl sm:text-4xl font-mono font-bold text-brand">
                {problem.number}
              </span>
            </div>

            <h3 class="typography-card-title text-foreground mb-3 group-hover:text-brand transition-colors">
              {problem.title}
            </h3>

            <p class="typography-body text-muted-foreground leading-relaxed mb-6 font-light">
              {problem.description}
            </p>
          </div>

          {/* Bottom metric callout */}
          <div class="pt-4 border-t border-border/40 flex items-center gap-2 text-xs font-medium text-foreground/70">
            <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0"></span>
            <span>{problem.metric}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
