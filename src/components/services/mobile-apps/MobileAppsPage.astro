---
import MobileAppsHero from "./MobileAppsHero.astro";
import MobileAppsProblems from "./MobileAppsProblems.astro";
import MobileAppsSolutions from "./MobileAppsSolutions.astro";
import MobileAppsTypes from "./MobileAppsTypes.astro";
import MobileAppsProcess from "./MobileAppsProcess.astro";
import MobileAppsFAQ from "./MobileAppsFAQ.astro";
import MobileAppsCTA from "./MobileAppsCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="mobile-apps-service-page">
  {/* 1. HERO SECTION */}
  <MobileAppsHero lang={lang} service={service} />

  {/* 2. MASALAH YANG SERING DITEMUI */}
  <MobileAppsProblems lang={lang} service={service} />

  {/* 3. SOLUSI / VALUE PROPOSITION */}
  <MobileAppsSolutions lang={lang} service={service} />

  {/* 4. BEBERAPA KATEGORI APLIKASI */}
  <MobileAppsTypes lang={lang} service={service} />

  {/* 5. PROSES KERJA */}
  <MobileAppsProcess lang={lang} service={service} />

  {/* 6. FAQ */}
  <MobileAppsFAQ lang={lang} service={service} />

  {/* 7. FINAL CTA */}
  <MobileAppsCTA lang={lang} service={service} />
</div>

