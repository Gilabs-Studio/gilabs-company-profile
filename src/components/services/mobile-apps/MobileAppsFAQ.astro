---
import { FAQList } from "../../react/FAQList";
import type { ServicePageData, ServiceFAQ } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
  faqs?: ServiceFAQ[];
  title?: string;
  subtitle?: string;
}

const { lang = "id", service, faqs, title, subtitle } = Astro.props;

const displayFaqs = faqs || service.faqs || [];
const sectionEyebrow = service.faqEyebrow;
const sectionTitle = title || service.faqTitle || "FAQ";
const sectionSubtitle = subtitle || service.faqSubtitle;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": displayFaqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!-- Inject FAQ Schema for Rich Google Search Snippets -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-16 md:py-24 relative z-10" id="faq">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {sectionEyebrow && (
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow text-foreground/80">
            {sectionEyebrow}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
      )}

      <h2 class="typography-section-title mb-4">
        {sectionTitle}
      </h2>

      {sectionSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {sectionSubtitle}
        </p>
      )}
    </div>

    <div class="space-y-4">
      <FAQList client:visible items={displayFaqs} itemClassName="border border-border/50 rounded-2xl overflow-hidden bg-white shadow-sm transition-colors duration-200 hover:border-brand/50 relative z-10" />
    </div>
  </div>
</section>
