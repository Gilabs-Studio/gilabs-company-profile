---
import PosSystemHero from "./PosSystemHero.astro";
import PosSystemProblems from "./PosSystemProblems.astro";
import PosSystemSolutions from "./PosSystemSolutions.astro";
import PosSystemFeatures from "./PosSystemFeatures.astro";
import PosSystemFAQ from "./PosSystemFAQ.astro";
import PosSystemCTA from "./PosSystemCTA.astro";
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang: "en" | "id";
  service: ServicePageData;
}

const { lang, service } = Astro.props;
---

<div class="pos-system-service-page">
  {/* 1. HERO SECTION */}
  <PosSystemHero lang={lang} service={service} />

  {/* 2. MASALAH YANG SERING DITEMUI */}
  <PosSystemProblems lang={lang} service={service} />

  {/* 3. SOLUSI / VALUE PROPOSITION */}
  <PosSystemSolutions lang={lang} service={service} />

  {/* 4. FITUR-FITUR UTAMA */}
  <PosSystemFeatures lang={lang} service={service} />

  {/* 5. FAQ */}
  <PosSystemFAQ lang={lang} service={service} />

  {/* 6. FINAL CTA */}
  <PosSystemCTA lang={lang} service={service} />
</div>

