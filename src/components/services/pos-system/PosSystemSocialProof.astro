---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const clients = [
  { name: "KOPI SERASI", subtitle: "Specialty Roastery & Cafe", font: "font-serif tracking-widest font-bold" },
  { name: "LAVERA BOUTIQUE", subtitle: "Fashion Retail & Apparel", font: "font-sans tracking-wider font-semibold" },
  { name: "DAPUR NUSANTARA", subtitle: "Casual Dining & Resto", font: "font-serif italic font-medium tracking-wide" },
  { name: "DAILY MART", subtitle: "Convenience & Grocery Chain", font: "font-mono font-extrabold tracking-tight" },
  { name: "BLOOM FLORIST", subtitle: "Botanical & Lifestyle Store", font: "font-sans font-black tracking-widest" },
  { name: "BAKE & CO", subtitle: "Artisan Bakery & Pastry", font: "font-mono tracking-widest font-bold" }
];
---

<section class="py-10 sm:py-14 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center max-w-6xl">
    <p class="text-xs sm:text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6 sm:mb-8">
      {lang === "en"
        ? "Trusted by restaurants, retail chains, and F&B businesses for their daily checkout operations"
        : "Digunakan oleh resto, retail, dan bisnis F&B untuk transaksi harian mereka"}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16">
      {clients.map((client) => (
        <div class="group flex flex-col items-center cursor-pointer">
          <span class={`text-base sm:text-lg md:text-xl text-foreground/40 group-hover:text-brand transition-colors select-none ${client.font}`}>
            {client.name}
          </span>
          <span class="text-[10px] text-muted-foreground/60 tracking-wider uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            {client.subtitle}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
