---
interface Props {
  lang?: "en" | "id";
}

const { lang = "id" } = Astro.props;

const clients = [
  { name: "ADIGUNA SUPPLY", subtitle: "Fleet & Inventory", font: "font-mono tracking-wider font-bold" },
  { name: "NEXORA CORPS", subtitle: "Enterprise Workflow", font: "font-serif tracking-widest font-semibold" },
  { name: "DOMUS TECH", subtitle: "Commerce & Portal", font: "font-serif italic font-medium tracking-wide" },
  { name: "SAVLO FINANCE", subtitle: "Fintech & Reporting", font: "font-sans font-extrabold tracking-tight" },
  { name: "BIO PHARMA LAB", subtitle: "Healthcare CRM", font: "font-sans font-black tracking-widest" },
  { name: "FIBER OPTICS ID", subtitle: "IoT Telemetry", font: "font-mono tracking-widest font-bold" }
];
---

<section class="py-10 sm:py-14 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center max-w-6xl">
    <p class="text-xs sm:text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6 sm:mb-8">
      {lang === "en"
        ? "Engineered dozens of custom systems across diverse business scales"
        : "Sudah membangun puluhan sistem custom untuk berbagai skala bisnis"}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16">
      {clients.map((client) => (
        <div class="group flex flex-col items-center cursor-pointer">
          <span class={`text-base sm:text-lg md:text-xl text-foreground/40 group-hover:text-brand transition-colors select-none ${client.font}`}>
            {client.name}
          </span>
          <span class="text-[10px] text-muted-foreground/60 tracking-wider uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
            {client.subtitle}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
