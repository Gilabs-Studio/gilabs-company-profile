---
import type { ServicePageData } from "../../../data/services/types";

interface Props {
  lang?: "en" | "id";
  service: ServicePageData;
}

const { service } = Astro.props;

const {
  processEyebrow,
  processTitle,
  processSubtitle,
  processSteps = [],
} = service;
---

<section id="proses" class="py-16 md:py-24 relative overflow-hidden">
  <div class="container mx-auto px-4 max-w-6xl">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      {processEyebrow && (
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow text-foreground/80">
            {processEyebrow}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
      )}

      {processTitle && (
        <h2 class="typography-section-title mb-4">
          {processTitle}
        </h2>
      )}

      {processSubtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed text-foreground/80 font-light">
          {processSubtitle}
        </p>
      )}
    </div>

    {/* Steps Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {processSteps.map((item) => (
        <div class="bg-white border border-border/50 rounded-2xl p-6 sm:p-7 hover:border-brand/50 transition-colors shadow-sm flex flex-col justify-between group">
          <div>
            {/* Step Number in Brand Blue */}
            <div class="mb-5 flex items-center justify-between">
              <span class="text-3xl sm:text-4xl font-mono font-bold text-brand">
                {item.step}
              </span>
              {item.stage && (
                <span class="text-xs font-mono text-muted-foreground/60 uppercase">
                  {item.stage}
                </span>
              )}
            </div>

            {/* Title */}
            <h3 class="text-base sm:text-lg font-bold text-foreground mb-3 group-hover:text-brand transition-colors leading-snug">
              {item.title}
            </h3>

            {/* Description */}
            <p class="text-xs sm:text-sm text-muted-foreground font-light leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

