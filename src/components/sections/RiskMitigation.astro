---
import { riskMitigationData } from '../../data/riskMitigation';
import { LottieIcon } from '../ui/LottieIcon';

const { lang } = Astro.props;
const data = riskMitigationData[lang];
---

<section class="py-24 md:py-32 bg-background relative">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow">
          {data.eyebrow}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>
      <h2 class="typography-section-title mb-6">
        {data.title.split('\n').map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <p class="typography-subtitle leading-relaxed max-w-3xl mx-auto">
        {data.subtitle}
      </p>
    </div>

    {/* Risk Mitigation Sections */}
    <div class="space-y-16 md:space-y-24">
      {data.sections.map((section, sectionIndex) => (
        <div key={sectionIndex} class="max-w-6xl mx-auto">
          <div class="text-center mb-8 md:mb-12">
            <h3 class="typography-section-title mb-4">
              {section.title}
            </h3>
            <p class="typography-subtitle max-w-3xl mx-auto">
              {section.description}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
            {section.items.map((item) => (
              <div class="bg-background/40 backdrop-blur-sm border border-border/50 rounded-2xl p-6 md:p-8 hover:border-brand/50 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col h-full">
                <div class="mb-4 md:mb-6 flex items-center justify-start">
                  <LottieIcon 
                    src={item.icon} 
                    className="w-16 h-16 md:w-20 md:h-20"
                    client:only="react"
                  />
                </div>
                <h4 class="typography-card-title mb-3 md:mb-4">
                  {item.title}
                </h4>
                <p class="typography-body leading-relaxed grow">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
