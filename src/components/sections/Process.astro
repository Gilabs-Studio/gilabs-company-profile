---
import { pricingData } from '../../data/pricing';

const { lang } = Astro.props;
const process = pricingData[lang].process;

// Function to convert markdown bold to HTML
function markdownToHtml(text: string): string {
  return text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
}
---

<section class="py-24 md:py-32">
  <div class="container mx-auto px-4">
    {/* Process Section - Minimalist White Background */}
    <section class="mb-16 sm:mb-20 md:mb-24 lg:mb-32">
      {/* Header with generous whitespace */}
      <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-12 md:mb-16 lg:mb-20 px-4">
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          <span class="typography-eyebrow">
            {process.subtitle}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        </div>
        <h2 class="typography-section-title">
          {process.title.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h2>
      </div>

      {/* Process Steps - 3 Column Layout */}
      <div class="max-w-5xl mx-auto px-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 md:gap-12">
          {process.body.map((step: string, index: number) => (
            <div class="group relative text-center">
              {/* Step number - centered */}
              <div class="flex justify-center mb-4 sm:mb-5 md:mb-6">
                <span class="flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 text-xl sm:text-2xl md:text-3xl font-bold text-foreground border-2 border-foreground rounded-full transition-colors group-hover:bg-foreground group-hover:text-background">
                  {index + 1}
                </span>
              </div>
              {/* Step content - centered */}
              <p class="typography-body-large text-foreground leading-relaxed px-2" set:html={markdownToHtml(step)} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</section>
