---
import ParallaxGallery from '../ui/ParallaxGallery';
import { templatesData } from '../../data/templatesData';

const { lang } = Astro.props;

/**
 * ============================================================================
 * PENGATURAN MANUAL URUTAN PREVIEW TEMPLATE PER KOLOM
 * ============================================================================
 * Anda dapat bebas memindahkan, menukar, menambah, atau mengurangi gambar di setiap kolom.
 * 
 * Daftar gambar preview template yang tersedia di /public/templates/:
 * - '/templates/driveloop/preview.webp'          (DriveLoop: Rental Mobil Adventure)
 * - '/templates/nusantara/preview.webp'          (Nusantara: Brand Fashion Minimalis)
 * - '/templates/la-table-eternelle/preview.webp' (La Table Éternelle: Fine Dining Mewah)
 * - '/templates/tastybite/preview.webp'          (TastyBite: Studio Kuliner / Kafe Modern)
 * - '/templates/adiguna-machinery/preview.webp'   (Adiguna: Mesin Industri & Manufaktur)
 * - '/templates/buildly/preview.webp'            (Buildly: Kontraktor Bangunan & Properti)
 * - '/templates/sura-bay/preview.webp'           (Sura Bay: Restoran & Beach Club)
 * - '/templates/shipagency-maritime/preview.webp'(Nautiva: Keagenan Kapal Pelabuhan)
 * - '/templates/gke-enterprise/preview.webp'     (GKE: Supply Chain B2B & Komponen)
 * - '/templates/ticketing-events/preview.webp'   (Tiket Konser & Festival Musik)
 * - '/templates/vistaprops/preview.webp'         (VistaProps: Real Estate Komersial)
 * - '/templates/tier4/preview.webp'              (Custom Development: Portfolio Adhara Eka)
 */

// Kolom 1 (Kiri)
const column1 = [
  '/templates/aegis/preview.webp',
  '/templates/la-table-eternelle/preview.webp',
  '/templates/ticketing-events/preview.webp',
  '/templates/driveloop/preview.webp',
];

// Kolom 2 (Tengah Kiri)
const column2 = [
  '/templates/adiguna-machinery/preview.webp',
  '/templates/la-table-eternelle/preview.webp',
  '/templates/sura-bay/preview.webp',
  '/templates/adiguna-machinery/preview.webp',
];

// Kolom 3 (Tengah Kanan)
const column3 = [
  '/templates/tastybite/preview.webp',
  '/templates/buildly/preview.webp',
  '/templates/nusantara/preview.webp',
  '/templates/gke-enterprise/preview.webp',
];

// Kolom 4 (Kanan)
const column4 = [
  '/templates/shipagency-maritime/preview.webp',
  '/templates/tier4/preview.webp',
  '/templates/vistaprops/preview.webp',
  '/templates/shipagency-maritime/preview.webp',
];
---

<section id="design-showcase" class="relative bg-background flex items-center justify-center overflow-hidden z-10 w-full">
  <h2 class="sr-only">Design Showcase</h2>
  <ParallaxGallery client:load columns={[column1, column2, column3, column4]} lang={lang} />
</section>
