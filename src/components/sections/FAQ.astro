---
import { faqData } from '../../data/faq';
import { FAQList } from '../react/FAQList';

const { lang } = Astro.props;
const data = faqData[lang];
---

<section class="py-24 relative z-10" id="faq">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="text-center mb-16">
      <h2 class="typography-section-title mb-4">{data.title}</h2>
      <p class="typography-subtitle max-w-2xl mx-auto">{data.subtitle}</p>
    </div>
    
    <div class="space-y-4">
       <FAQList client:visible items={data.items} />
    </div>
  </div>
</section>
