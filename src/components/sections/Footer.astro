---
import { Facebook, Instagram, Twitter, Youtube } from "lucide-react";
import { getWhatsAppLink } from '../../lib/utils';
import { serviceSlugPairMap } from "../../data/services/index";

const { lang } = Astro.props;

const FOOTER_LINKS = [
  {
    title: lang === 'en' ? "Company" : "Perusahaan",
    links: [
      { name: lang === 'en' ? "Home" : "Beranda", href: `/${lang}` },
      { name: lang === 'en' ? "Services" : "Layanan", href: `/${lang}/services` },
      { name: lang === 'en' ? "Work" : "Pekerjaan", href: `/${lang}/work-results` },
      { name: lang === 'en' ? "Blog" : "Blog", href: `/${lang}/blog` },
    ],
  },
  {
    title: lang === 'en' ? "Services" : "Layanan",
    links: [
      { name: lang === 'en' ? "Website Development" : "Jasa Pembuatan Website", href: `/${lang}/services/${serviceSlugPairMap["web-development"][lang]}` },
      { name: lang === 'en' ? "Software House" : "Software House Indonesia", href: `/${lang}/services/${serviceSlugPairMap["software-house"][lang]}` },
      { name: lang === 'en' ? "Custom Software" : "Custom Software & Web App", href: `/${lang}/services/${serviceSlugPairMap["custom-software"][lang]}` },
      { name: lang === 'en' ? "ERP & CRM Systems" : "Sistem ERP & CRM Custom", href: `/${lang}/services/${serviceSlugPairMap["erp-crm"][lang]}` },
      { name: lang === 'en' ? "Custom POS System" : "Aplikasi Kasir / POS Custom", href: `/${lang}/services/${serviceSlugPairMap["pos-system"][lang]}` },
    ],
  },
  {
    title: lang === 'en' ? "Support" : "Dukungan",
    links: [
      { name: lang === 'en' ? "FAQ" : "Tanya Jawab", href: `/${lang}#faq` },
      { name: lang === 'en' ? "Contact" : "Kontak", href: getWhatsAppLink('footer', lang) },
      { name: lang === 'en' ? "Privacy Policy" : "Kebijakan Privasi", href: `/${lang}/privacy` },
      { name: lang === 'en' ? "Terms of Service" : "Ketentuan Layanan", href: `/${lang}/terms` },
    ],
  },
];

const largeText = "GILABS";
---

<footer class="bg-background text-foreground pt-16 pb-10 overflow-hidden border-t border-border">
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-4">
      {/* Link Columns */}
      {FOOTER_LINKS.map((group) => (
        <div>
          <h3 class="text-foreground text-xs font-semibold uppercase tracking-widest mb-8">
            {group.title}
          </h3>
          <ul class="space-y-4">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-foreground hover:text-brand transition-colors cursor-pointer text-base"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {/* Contact & Socials */}
      <div class="space-y-12">
        <div>
          <h3 class="text-foreground text-xs font-semibold uppercase tracking-widest mb-6">
            {lang === 'en' ? "WE'D LOVE TO HELP YOU WITH EASE" : "KAMI SENANG MEMBANTU ANDA DENGAN MUDAH"}
          </h3>
          <p class="text-sm text-foreground mb-3">
            {lang === 'en'
              ? 'Gilabs is the public brand of PT Griya Innovations Labs.'
              : 'Gilabs adalah brand publik dari PT Griya Innovations Labs.'}
          </p>
          <a 
            href="mailto:hello@gilabs.id" 
            class="text-2xl md:text-3xl font-medium text-foreground hover:text-brand transition-colors cursor-pointer overflow-wrap-anywhere block"
          >
            hello@gilabs.id
          </a>
        </div>

        <div class="space-y-6">
          <h3 class="text-foreground text-xs font-semibold uppercase tracking-widest">
            {lang === 'en' ? 'Follow Us' : 'Ikuti Kami'}
          </h3>
          <div class="flex items-center gap-3">
            {[
              { icon: Facebook, label: "Facebook" },
              { icon: Instagram, label: "Instagram" },
              { icon: Twitter, label: "X" },
              { icon: Youtube, label: "YouTube" },
            ].map((item) => (
              <button
                type="button"
                class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center text-foreground hover:bg-brand hover:text-white transition-all cursor-pointer shadow-sm"
                aria-label={item.label}
              >
                <item.icon className="w-4 h-4" />
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Large Decorative Text - Aligned with Container */}
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-12 select-none pointer-events-none mb-4 py-4 overflow-hidden">
    <h2 
      class="w-full text-[25vw] md:text-[20vw] lg:text-[20rem] font-bold text-foreground/[0.08] leading-none tracking-tighter text-center whitespace-nowrap"
      style="mask-image: linear-gradient(to top, transparent 0%, black 60%); -webkit-mask-image: linear-gradient(to top, transparent 0%, black 60%);"
    >
      {largeText}
    </h2>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-12">
    {/* Bottom Bar */}
    <div class="pt-8 border-t border-border grid grid-cols-1 md:grid-cols-3 items-center gap-6 text-sm text-foreground">
      <p class="text-center md:text-left">
        &copy; {new Date().getFullYear()} PT Griya Innovations Labs (Gilabs). All rights reserved.
      </p>
      <div class="flex justify-center gap-8">
        <a href={`/${lang}/terms`} class="hover:text-brand transition-colors cursor-pointer">
          {lang === 'en' ? 'Terms & Conditions' : 'Syarat & Ketentuan'}
        </a>
      </div>
      <div class="flex justify-center md:justify-end gap-8">
        <a href={`/${lang}/privacy`} class="hover:text-brand transition-colors cursor-pointer">
          {lang === 'en' ? 'Privacy Policy' : 'Kebijakan Privasi'}
        </a>
      </div>
    </div>
  </div>
</footer>
