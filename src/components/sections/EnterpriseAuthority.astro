---
import { enterpriseAuthorityData } from '../../data/enterpriseAuthority';
import { LottieIcon } from '../ui/LottieIcon';

const { lang } = Astro.props;
const data = enterpriseAuthorityData[lang];
---

<section class="py-24 md:py-32 bg-background relative border-b border-border/50">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow">
          {data.eyebrow}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>
      <h2 class="typography-section-title mb-6">
        {data.title.split('\n').map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <p class="typography-subtitle leading-relaxed max-w-3xl mx-auto">
        {data.subtitle}
      </p>
    </div>

    {/* Credentials Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 mb-16 md:mb-20">
      {data.credentials.map((credential) => (
        <div class="bg-background/40 backdrop-blur-sm border border-border/50 rounded-2xl p-6 md:p-8 hover:border-brand/50 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col h-full">
          <div class="mb-4 md:mb-6 flex items-center justify-start">
            <LottieIcon 
              src={credential.icon} 
              className="w-16 h-16 md:w-20 md:h-20"
              client:only="react"
            />
          </div>
          {credential.stat && (
            <div class="mb-3">
              <span class="inline-block px-3 py-1.5 bg-brand/10 text-brand text-xs font-bold rounded-full tracking-wide">
                {credential.stat}
              </span>
            </div>
          )}
          <h3 class="typography-card-title mb-3 md:mb-4">
            {credential.title}
          </h3>
          <p class="typography-body leading-relaxed grow">
            {credential.description}
          </p>
        </div>
      ))}
    </div>

    {/* Positioning Statement */}
    <div class="max-w-4xl mx-auto bg-foreground text-background rounded-3xl p-8 md:p-12 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-10 pointer-events-none">
        <div class="absolute -top-1/2 -left-1/2 w-full h-full bg-brand/30 rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10">
        <h3 class="typography-section-title mb-6 md:mb-8 text-center">
          {data.positioning.title.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h3>
        <ul class="space-y-4 md:space-y-6">
          {data.positioning.points.map((point) => (
            <li class="flex items-start gap-4">
              <div class="w-2 h-2 rounded-full bg-brand mt-2 shrink-0"></div>
              <p class="text-background/90 typography-body leading-relaxed grow">
                {point}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
