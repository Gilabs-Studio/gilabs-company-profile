---
import { pricingData } from '../../data/pricing';
import { servicesIntroData } from '../../data/servicesIntro';
import { WhatsAppIcon } from '../react/WhatsAppIcon';
import { getWhatsAppLink } from '../../lib/utils';

const { lang } = Astro.props;
const ctaData = pricingData[lang].ctaSection;
const owningData = servicesIntroData[lang].cta;
---

<section class="py-12 sm:py-16 md:py-24 lg:py-32 relative">
  <div class="container mx-auto px-4">
    <div class="bg-foreground text-background rounded-2xl sm:rounded-3xl p-8 sm:p-12 md:p-16 lg:p-28 text-center relative overflow-hidden shadow-2xl shadow-brand/20">
      {/* Background decoration */}
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-20 pointer-events-none">
        <div class="absolute -top-1/2 -left-1/2 w-full h-full bg-brand/30 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-1/2 -right-1/2 w-full h-full bg-brand/30 rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 px-2 sm:px-4">
        <h2 class="typography-hero-title mb-6 sm:mb-8 md:mb-10 max-w-4xl mx-auto">
          {owningData.title.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h2>
        <div class="space-y-2 sm:space-y-3 text-white mb-8 sm:mb-10 md:mb-16 max-w-3xl mx-auto">
          {ctaData.subtitle.map(line => (
            <p>{line}</p>
          ))}
        </div>
        
        <a 
          href={getWhatsAppLink('footer', lang)} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-3 sm:gap-4 px-4 sm:px-6 py-2 sm:py-4 bg-background text-foreground typography-button rounded-full hover:scale-105 transition-all hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] active:scale-95 whitespace-nowrap"
        >
          {ctaData.button}
          <WhatsAppIcon client:load className="w-5 h-5 sm:w-6 sm:h-6" />
        </a>
      </div>
    </div>
  </div>
</section>
