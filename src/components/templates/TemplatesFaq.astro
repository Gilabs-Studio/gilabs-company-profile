---
import { FAQList } from '../react/FAQList';
import { templatesPageContent } from '../../data/templatesData';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
const t = templatesPageContent[lang];

const faqItems = t.faqs.map(item => ({
  question: item.q,
  answer: item.a
}));
---

<section class="py-20 md:py-24 relative z-10 border-t border-border/60" id="faq">
  <div class="container mx-auto px-4 max-w-4xl">
    {/* FAQ Header */}
    <div class="text-center mb-12 md:mb-16">
      <h2 class="typography-section-title mb-4">
        {t.faqTitle}
      </h2>
      <p class="typography-subtitle max-w-2xl mx-auto">
        {t.faqSubtitle}
      </p>
    </div>

    {/* FAQ Accordion */}
    <div class="space-y-4">
      <FAQList 
        client:visible 
        items={faqItems} 
      />
    </div>
  </div>
</section>

