---
import type { ServiceFeature } from "../../data/services/types";

interface Props {
  lang?: "en" | "id";
  title: string;
  subtitle: string;
  features: ServiceFeature[];
}

const { lang = "id", title, subtitle, features } = Astro.props;
const eyebrow = lang === "en" ? "Engineering Standards" : "Standar Rekayasa";
---

<section class="py-24 md:py-32 bg-background border-b border-border/50 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow">
          {eyebrow}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>
      <h2 class="typography-section-title mb-6">
        {title}
      </h2>
      <p class="typography-subtitle leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {features.map((feature, idx) => (
        <div class="bg-white border border-border/50 rounded-2xl md:rounded-3xl p-6 sm:p-8 hover:border-brand/50 transition-all duration-300 hover:shadow-xl hover:shadow-brand/5 hover:-translate-y-1 flex flex-col space-y-3 shadow-sm">
          <div class="w-8 h-8 rounded-full bg-brand/10 text-brand flex items-center justify-center text-xs font-mono font-bold">
            0{idx + 1}
          </div>
          <h3 class="typography-card-title text-foreground">
            {feature.title}
          </h3>
          <p class="typography-body leading-relaxed grow">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
