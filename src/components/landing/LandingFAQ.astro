---
import type { ServiceFAQ } from "../../data/services/types";
import { FAQList } from "../react/FAQList";

interface Props {
  lang?: "en" | "id";
  title: string;
  subtitle?: string;
  faqs: ServiceFAQ[];
}

const { lang = "id", title, subtitle, faqs } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!-- Inject FAQ Schema for Rich Google SERP snippets -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-20 md:py-28 bg-background border-b border-border/50 relative z-10" id="faq">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="text-center mb-12 md:mb-16 px-4">
      <h2 class="typography-section-title mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="typography-subtitle max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>

    <div class="space-y-4">
      <FAQList client:visible items={faqs} />
    </div>
  </div>
</section>

