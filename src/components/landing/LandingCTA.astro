---
import { ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../lib/utils";

interface Props {
  lang: "en" | "id";
  title: string;
  subtitle: string;
  buttonText: string;
}

const { lang, title, subtitle, buttonText } = Astro.props;
---

<section class="py-16 sm:py-20 md:py-28 lg:py-32 bg-background relative">
  <div class="container mx-auto px-4">
    {/* Dark Container Combination - Identical to FinalCTA & EnterpriseAuthority on Landing Page */}
    <div class="bg-foreground text-background rounded-2xl sm:rounded-3xl p-8 sm:p-12 md:p-16 lg:p-24 text-center relative overflow-hidden shadow-2xl shadow-brand/20 max-w-5xl mx-auto">
      {/* Background radial blur decoration */}
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-20 pointer-events-none">
        <div class="absolute -top-1/2 -left-1/2 w-full h-full bg-brand/30 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-1/2 -right-1/2 w-full h-full bg-brand/30 rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 px-2 sm:px-4">
        <h2 class="typography-hero-title mb-6 sm:mb-8 text-background max-w-3xl mx-auto">
          {title}
        </h2>
        
        <p class="typography-subtitle text-background/80 mb-8 sm:mb-12 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>

        <div class="pt-2">
          <a
            href={getWhatsAppLink("final-cta-landing", lang)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4 bg-background text-foreground typography-button rounded-full hover:scale-105 transition-all hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] active:scale-95 whitespace-nowrap cursor-pointer"
          >
            <span>{buttonText}</span>
            <ArrowRight className="w-5 h-5 text-foreground" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
