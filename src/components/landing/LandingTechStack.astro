---
import type { TechStackItem } from "../../data/services/types";

interface Props {
  lang?: "en" | "id";
  title: string;
  subtitle: string;
  techStack: TechStackItem[];
}

const { lang = "id", title, subtitle, techStack } = Astro.props;
const eyebrow = lang === "en" ? "Production-Grade Tech" : "Teknologi Modern";
---

<section class="py-24 md:py-32 bg-background border-b border-border/50 relative">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 px-4">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
        <span class="typography-eyebrow">
          {eyebrow}
        </span>
        <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
      </div>
      <h2 class="typography-section-title mb-6">
        {title}
      </h2>
      <p class="typography-subtitle leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {techStack.map((tech) => (
        <div class="bg-white border border-border/50 rounded-2xl md:rounded-3xl p-6 text-center space-y-2 hover:border-brand/50 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 shadow-sm">
          <span class="text-[11px] font-mono uppercase text-brand tracking-wider font-semibold block">
            {tech.category}
          </span>
          <h3 class="typography-card-title text-foreground">
            {tech.name}
          </h3>
          <p class="typography-body text-xs text-muted-foreground leading-relaxed">
            {tech.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
