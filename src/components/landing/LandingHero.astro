---
import { ArrowRight } from "lucide-react";
import { getWhatsAppLink } from "../../lib/utils";

interface Props {
  lang: "en" | "id";
  eyebrow?: string;
  title: string;
  subtitle: string;
  illustration: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  lang,
  eyebrow,
  title,
  subtitle,
  illustration,
  primaryCtaText = lang === "en" ? "Free Consultation" : "Konsultasi Gratis",
  secondaryCtaText = lang === "en" ? "View Portfolio" : "Lihat Portofolio",
  secondaryCtaHref = "/" + lang + "/work-results"
} = Astro.props;

const clientLogos = [
  { name: "indōnesia", font: "font-serif tracking-widest text-base sm:text-lg" },
  { name: "NEXORA", font: "font-mono font-bold tracking-widest text-sm sm:text-base" },
  { name: "Domus", font: "font-sans font-semibold tracking-wider text-base sm:text-lg" },
  { name: "BRANDX", font: "font-sans font-black tracking-widest text-sm sm:text-base" },
  { name: "Lumina", font: "font-serif italic font-medium tracking-wide text-base sm:text-lg" }
];
---

<section class="relative min-h-screen flex flex-col justify-center items-center overflow-hidden pt-20 sm:pt-24 pb-16 sm:pb-20 bg-background border-b border-border/50">
  <div class="container mx-auto px-6 lg:px-12 relative z-10 my-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center py-6">
      
      {/* Left Column: Typography & CTAs */}
      <div class="lg:col-span-7 space-y-6 text-left">
        {/* Eyebrow - rendered only when present */}
        {eyebrow && (
          <div class="flex items-center gap-3 sm:gap-4 mb-2">
            <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
            <span class="typography-eyebrow">
              {eyebrow}
            </span>
            <div class="h-px w-6 sm:w-12 bg-primary/10"></div>
          </div>
        )}

        <h1 class="typography-hero-title mb-4 md:mb-6 text-foreground tracking-tight leading-[1.15]">
          {title}
        </h1>

        <p class="typography-subtitle leading-relaxed max-w-2xl font-light mb-8">
          {subtitle}
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href={getWhatsAppLink("hero-landing", lang)}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 text-sm sm:text-base font-semibold text-white transition-all duration-200 bg-brand rounded-full hover:bg-brand/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand shadow-lg hover:shadow-brand/40 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            <span>{primaryCtaText}</span>
            <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>

          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center px-6 sm:px-7 py-3 sm:py-3.5 text-sm sm:text-base font-medium text-foreground bg-secondary/50 hover:bg-secondary border border-border/80 rounded-full transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            {secondaryCtaText}
          </a>
        </div>
      </div>

      {/* Right Column: Hand-Drawn Sketch PNG Illustration (Transparent BG) */}
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="relative w-full max-w-md lg:max-w-none flex items-center justify-center p-2">
          <img
            src={illustration}
            alt={title}
            class="w-full h-auto object-contain max-h-[380px] select-none"
            loading="eager"
            fetchpriority="high"
            width="600"
            height="450"
          />
        </div>
      </div>

    </div>
  </div>

  {/* Social Proof Client Bar */}
  <div class="relative z-10 container mx-auto px-6 lg:px-12 pt-8 sm:pt-12">
    <div class="text-center space-y-4">
      <p class="text-xs font-medium text-muted-foreground uppercase tracking-widest">
        {lang === "en" ? "Trusted by forward-thinking businesses across industries" : "Dipercaya oleh bisnis dari berbagai industri"}
      </p>
      <div class="flex items-center justify-center gap-6 sm:gap-12 md:gap-16 flex-wrap opacity-50 hover:opacity-80 transition-opacity">
        {clientLogos.map((logo) => (
          <span class={logo.font + " text-foreground select-none"}>
            {logo.name}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
