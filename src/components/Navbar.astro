---
import { Menu, X, ChevronDown } from "lucide-react";
import { getWhatsAppLink } from "../lib/utils";
import { serviceSlugPairMap, getAlternateServiceSlug } from "../data/services/index";

interface Props {
  lang?: string;
}

const { lang: rawLang = "id" } = Astro.props;
const lang: "id" | "en" = rawLang === "en" ? "en" : "id";
const pathPrefix = `/${lang}`;

const links = [
  { href: `${pathPrefix}/templates`, label: lang === "en" ? "Product" : "Produk", isDropdown: true, dropdownType: "product" },
  { href: `${pathPrefix}/services`, label: lang === "en" ? "Services" : "Layanan", isDropdown: true, dropdownType: "services" },
  { href: `${pathPrefix}/solutions`, label: lang === "en" ? "Solutions" : "Solusi" },
  { href: `${pathPrefix}/work-results`, label: lang === "en" ? "Our Work" : "Hasil Pekerjaan" },
];

const productLinks = [
  {
    href: "https://salesview.id",
    label: "Product ERP",
    desc: lang === "en" ? "Enterprise internal operational & sales management ERP" : "Sistem ERP internal operasional & manajemen penjualan",
    external: true,
  },
  {
    href: `${pathPrefix}/templates`,
    label: lang === "en" ? "Turnkey Website" : "Website Siap Pakai",
    desc: lang === "en" ? "Landing page & company profile websites ready to go live" : "Website landing page & profil perusahaan siap online terima beres",
    external: false,
  },
];

const serviceLinks = [
  {
    category: lang === "en" ? "Bespoke Web & Industry Solutions" : "Website Khusus & Industri",
    items: [
      { href: `${pathPrefix}/website-premium`, label: lang === "en" ? "Premium Bespoke Web" : "Website Premium Custom", desc: lang === "en" ? "High-end without templates" : "Desain eksklusif tanpa template" },
      { href: `${pathPrefix}/website-corporate`, label: lang === "en" ? "Corporate & Enterprise" : "Website Corporate & Holding", desc: lang === "en" ? "Multi-branch & investor ready" : "Standar holding & tata kelola" },
      { href: `${pathPrefix}/website-klinik`, label: lang === "en" ? "Clinics & Hospitals" : "Website Klinik & Rumah Sakit", desc: lang === "en" ? "Doctor schedule & booking" : "Jadwal dokter & registrasi" },
      { href: `${pathPrefix}/website-kontraktor-properti`, label: lang === "en" ? "Contractor & Property" : "Website Kontraktor & Properti", desc: lang === "en" ? "Project catalog & spec sheets" : "Katalog proyek & listing unit" },
      { href: `${pathPrefix}/website-umkm`, label: lang === "en" ? "Affordable SME Website" : "Website UMKM Cepat Online", desc: lang === "en" ? "Fast go-live for local business" : "Solusi go-digital cepat & terjangkau" },
      { href: `${pathPrefix}/website-toko-online`, label: lang === "en" ? "E-Commerce Online Store" : "Website Toko Online Mandiri", desc: lang === "en" ? "Direct checkout without marketplace fee" : "Katalog & checkout tanpa potongan fee" },
      { href: `${pathPrefix}/services/${serviceSlugPairMap["web-development"][lang]}`, label: lang === "en" ? "Web Development (Core)" : "Jasa Pembuatan Website", desc: lang === "en" ? "Modern high-speed web apps" : "Web modern Next.js & React" },
      { href: `${pathPrefix}/services/${serviceSlugPairMap["company-profile"][lang]}`, label: lang === "en" ? "Web Company Profile" : "Web Company Profile", desc: lang === "en" ? "Professional company branding" : "Reputasi kredibel & konversi tinggi" },
    ]
  },
  {
    category: lang === "en" ? "Software House & Enterprise Systems" : "Software House & Sistem Internal",
    items: [
      { href: `${pathPrefix}/software-house`, label: lang === "en" ? "Software House for Startups" : "Software House Startup & UMKM", desc: lang === "en" ? "Agile sprint & technical partner" : "Partner teknologi terpercaya" },
      { href: `${pathPrefix}/aplikasi-custom`, label: lang === "en" ? "Enterprise Mobile Apps" : "Aplikasi Mobile Perusahaan", desc: lang === "en" ? "iOS & Android enterprise app" : "Aplikasi iOS & Android khusus internal" },
      { href: `${pathPrefix}/sistem-informasi`, label: lang === "en" ? "Management Information System" : "Sistem Informasi Manajemen (SIM)", desc: lang === "en" ? "Operational centralized dashboards" : "Otomasi alur kerja & pelaporan" },
      { href: `${pathPrefix}/services/${serviceSlugPairMap["erp-crm"][lang]}`, label: lang === "en" ? "Custom ERP & CRM" : "Sistem ERP & CRM Custom", desc: lang === "en" ? "Warehouse, inventory & pipeline" : "Integrasi stok gudang & sales pipeline" },
      { href: `${pathPrefix}/services/${serviceSlugPairMap["pos-system"][lang]}`, label: lang === "en" ? "Multi-Branch POS" : "Aplikasi Kasir / POS Custom", desc: lang === "en" ? "Real-time sync retail & F&B" : "Kasir cabang & inventaris terpadu" },
      { href: `${pathPrefix}/services/${serviceSlugPairMap["custom-software"][lang]}`, label: lang === "en" ? "Custom Software Engineering" : "Custom Software & Web App", desc: lang === "en" ? "Bespoke internal systems & API" : "Arsitektur database & API kustom" },
    ]
  }
];

const cityLinks = [
  { href: `${pathPrefix}/jasa-website-jakarta`, name: "Jakarta" },
  { href: `${pathPrefix}/jasa-website-surabaya`, name: "Surabaya" },
  { href: `${pathPrefix}/jasa-website-bandung`, name: "Bandung" },
  { href: `${pathPrefix}/jasa-website-semarang`, name: "Semarang" },
  { href: `${pathPrefix}/jasa-website-yogyakarta`, name: "Yogyakarta" },
  { href: `${pathPrefix}/jasa-website-bali`, name: "Bali" },
  { href: `${pathPrefix}/jasa-website-medan`, name: "Medan" },
  { href: `${pathPrefix}/jasa-website-makassar`, name: "Makassar" },
  { href: `${pathPrefix}/jasa-website-malang`, name: "Malang" },
  { href: `${pathPrefix}/jasa-website-solo`, name: "Solo" },
];

const currentPath = Astro.url.pathname;
let switchLangPath: string;

const serviceMatch = currentPath.match(/^\/(en|id)\/services\/([^\/]+)\/?$/);
if (serviceMatch) {
  const currentSlug = serviceMatch[2];
  const targetLang = lang === "id" ? "en" : "id";
  const altSlug = getAlternateServiceSlug(currentSlug, targetLang);
  switchLangPath = altSlug ? `/${targetLang}/services/${altSlug}` : `/${targetLang}/services`;
} else {
  if (lang === "id") {
    if (currentPath === "/") {
      switchLangPath = "/en";
    } else if (currentPath.startsWith("/id/")) {
      switchLangPath = currentPath.replace(/^\/id/, "/en");
    } else if (currentPath === "/id") {
      switchLangPath = "/en";
    } else {
      switchLangPath = `/en${currentPath}`;
    }
  } else {
    if (currentPath === "/en" || currentPath === "/en/") {
      switchLangPath = "/";
    } else if (currentPath.startsWith("/en/")) {
      switchLangPath = currentPath.replace(/^\/en/, "/id");
    } else {
      switchLangPath = currentPath.replace(/^\/en/, "") || "/";
    }
  }
}
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out" id="navbar">
  <!-- Progressive blur background layer -->
  <div 
    id="navbar-bg" 
    class="absolute inset-0 -z-10 pointer-events-none transition-opacity duration-300 opacity-0"
    aria-hidden="true"
  >
    <!-- Base frosted glass background -->
    <div class="absolute inset-0 bg-background/80 backdrop-blur-md border-b border-border/40 shadow-xs shadow-black/5"></div>
    <!-- Progressive blur feather (smooth gradient mask at bottom edge) -->
    <div class="absolute top-full left-0 right-0 h-5 bg-gradient-to-b from-background/40 to-transparent backdrop-blur-xs [mask-image:linear-gradient(to_bottom,black_0%,transparent_100%)] pointer-events-none"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between relative">
    <!-- Brand Logo (Left) -->
    <div class="flex items-center flex-1 justify-start">
      <a href={pathPrefix} id="navbar-brand-logo" class="flex items-center relative z-50 cursor-pointer hover:opacity-90 transition-opacity" aria-label="Gilabs Home">
        <img 
          id="navbar-logo-img"
          src="/Logo Putih 3 crop.png" 
          alt="Gilabs" 
          class="h-8 sm:h-9 w-auto object-contain transition-opacity duration-300" 
          width="125" 
          height="36" 
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- Desktop Menu (Center) -->
    <div class="hidden md:flex items-center justify-center gap-1 lg:gap-2">
      {links.map(link => {
        if (link.isDropdown && link.dropdownType === "product") {
          return (
            <div class="relative group py-2">
              <a 
                href={link.href} 
                class="text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary/60 px-3.5 py-2 rounded-lg transition-all duration-200 cursor-pointer flex items-center gap-1"
              >
                {link.label}
                <ChevronDown className="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-70" />
              </a>

              {/* Product Hover Dropdown Menu */}
              <div class="absolute top-full left-0 w-80 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="bg-background/98 backdrop-blur-xl border border-border/60 rounded-xl p-3 shadow-xl shadow-black/5 space-y-1">
                  {productLinks.map((item) => (
                    <a
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                      class="block p-3 rounded-lg hover:bg-secondary/70 transition-colors cursor-pointer group/item"
                    >
                      <div class="text-xs font-semibold text-foreground group-hover/item:text-brand flex items-center justify-between">
                        <span>{item.label}</span>
                        {item.external && (
                          <span class="text-[10px] text-muted-foreground font-mono">salesview.id ↗</span>
                        )}
                      </div>
                      <div class="text-[11px] text-muted-foreground mt-0.5 leading-snug">
                        {item.desc}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        }

        if (link.isDropdown && link.dropdownType === "services") {
          return (
            <div class="relative group py-2">
              <a 
                href={link.href} 
                class="text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary/60 px-3.5 py-2 rounded-lg transition-all duration-200 cursor-pointer flex items-center gap-1"
              >
                {link.label}
                <ChevronDown className="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-70" />
              </a>

              {/* Hover Dropdown Mega Menu */}
              <div class="absolute top-full left-1/2 -translate-x-1/2 w-[940px] max-w-[95vw] pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="bg-background/98 backdrop-blur-xl border border-border/60 rounded-xl p-6 shadow-2xl shadow-black/10">
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    {/* Column 1: Websites (5 cols) */}
                    <div class="lg:col-span-5 space-y-2">
                      <div class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground/70 pb-1.5 border-b border-border/40 flex items-center justify-between">
                        <span>{serviceLinks[0].category}</span>
                        <span class="text-[10px] font-mono text-muted-foreground/50">01</span>
                      </div>
                      <ul class="space-y-0.5">
                        {serviceLinks[0].items.map((item) => (
                          <li>
                            <a
                              href={item.href}
                              class="group/item block py-1.5 px-2.5 rounded-lg hover:bg-secondary/70 transition-colors cursor-pointer"
                            >
                              <div class="text-xs font-semibold text-foreground group-hover/item:text-brand transition-colors">
                                {item.label}
                              </div>
                              <div class="text-[11px] text-muted-foreground/80 leading-snug">
                                {item.desc}
                              </div>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>

                    {/* Column 2: Software & Systems (4 cols) */}
                    <div class="lg:col-span-4 space-y-2">
                      <div class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground/70 pb-1.5 border-b border-border/40 flex items-center justify-between">
                        <span>{serviceLinks[1].category}</span>
                        <span class="text-[10px] font-mono text-muted-foreground/50">02</span>
                      </div>
                      <ul class="space-y-0.5">
                        {serviceLinks[1].items.map((item) => (
                          <li>
                            <a
                              href={item.href}
                              class="group/item block py-1.5 px-2.5 rounded-lg hover:bg-secondary/70 transition-colors cursor-pointer"
                            >
                              <div class="text-xs font-semibold text-foreground group-hover/item:text-brand transition-colors">
                                {item.label}
                              </div>
                              <div class="text-[11px] text-muted-foreground/80 leading-snug">
                                {item.desc}
                              </div>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>

                    {/* Column 3: Regional Hubs (3 cols) */}
                    <div class="lg:col-span-3 space-y-2">
                      <div class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground/70 pb-1.5 border-b border-border/40 flex items-center justify-between">
                        <span>{lang === "en" ? "Local City Hubs" : "Layanan Per Kota"}</span>
                        <span class="text-[10px] font-mono text-muted-foreground/50">03</span>
                      </div>
                      <p class="text-[11px] text-muted-foreground leading-relaxed pt-0.5">
                        {lang === "en" ? "Dedicated localized engineering for key business cities:" : "Layanan rekayasa web lokal untuk pusat bisnis utama di Indonesia:"}
                      </p>
                      <div class="grid grid-cols-2 gap-1 pt-1">
                        {cityLinks.map((city) => (
                          <a
                            href={city.href}
                            class="px-2 py-1.5 rounded-md text-xs font-medium text-foreground/85 hover:text-brand hover:bg-secondary/70 transition-colors cursor-pointer text-center border border-border/30 hover:border-brand/30"
                          >
                            {city.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>

                  {/* Bottom Footer Row */}
                  <div class="mt-4 pt-3.5 border-t border-border/40 flex items-center justify-between text-xs">
                    <a
                      href={`${pathPrefix}/services`}
                      class="font-semibold text-brand hover:underline inline-flex items-center gap-1 cursor-pointer"
                    >
                      {lang === "en" ? "View Full Services Directory" : "Buka Direktori Lengkap Semua Layanan"} →
                    </a>
                    <a
                      href={getWhatsAppLink("navbar-mega", lang)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-muted-foreground hover:text-foreground font-medium inline-flex items-center gap-1 cursor-pointer"
                    >
                      <span>{lang === "en" ? "Free Architecture Consultation" : "Konsultasi & Estimasi Arsitektur"}</span>
                      <span class="text-[11px]">↗</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        }

        return (
          <a 
            href={link.href} 
            class="text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary/60 px-3.5 py-2 rounded-lg transition-all duration-200 cursor-pointer"
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <!-- Actions: Language & CTA (Right) -->
    <div class="hidden md:flex items-center justify-end flex-1 gap-3">
      <a 
        href={switchLangPath} 
        class="text-xs font-medium border border-border/80 px-2.5 py-1.5 rounded-lg hover:bg-secondary/70 hover:border-border transition-colors uppercase cursor-pointer text-muted-foreground hover:text-foreground"
        aria-label="Switch Language"
      >
        {lang === "en" ? "ID" : "EN"}
      </a>
      <a 
        href={getWhatsAppLink("navbar", lang)} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-xs sm:text-sm font-semibold bg-brand text-white px-4 py-2 sm:px-5 sm:py-2.5 rounded-lg hover:bg-brand/90 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 hover:shadow-lg hover:shadow-brand/25 cursor-pointer inline-flex items-center"
      >
        {lang === "en" ? "Contact Us" : "Hubungi Kami"}
      </a>
    </div>

    {/* Mobile Toggle */}
    <button id="menu-toggle" class="md:hidden ml-auto relative z-50 p-2 text-foreground cursor-pointer" aria-label="Toggle Menu">
      <span id="icon-menu" class="block">
        <Menu className="w-6 h-6" />
      </span>
      <span id="icon-close" class="hidden">
        <X className="w-6 h-6" />
      </span>
    </button>
  </div>
</nav>

<script>
  const navbar = document.getElementById("navbar");
  const navbarBg = document.getElementById("navbar-bg");

  let lastScrollY = window.scrollY;
  let ticking = false;

  function updateNavbar() {
    if (!navbar) return;
    
    const currentScrollY = window.scrollY;
    
    // Top of page: completely transparent, no blur background
    if (currentScrollY <= 20) {
      navbar.style.transform = "translateY(0)";
      if (navbarBg) {
        navbarBg.classList.add("opacity-0");
        navbarBg.classList.remove("opacity-100");
      }
      lastScrollY = currentScrollY;
      ticking = false;
      return;
    }
    
    // Scrolled into page:
    // When scrolling down past 80px, hide navbar
    if (currentScrollY > lastScrollY && currentScrollY > 80) {
      navbar.style.transform = "translateY(-100%)";
    } else {
      // When scrolling up or stationary, show navbar with progressive blur background
      navbar.style.transform = "translateY(0)";
      if (navbarBg) {
        navbarBg.classList.remove("opacity-0");
        navbarBg.classList.add("opacity-100");
      }
    }
    
    lastScrollY = currentScrollY;
    ticking = false;
  }

  // Initialize on page load
  updateNavbar();

  window.addEventListener("scroll", () => {
    if (!ticking) {
      window.requestAnimationFrame(updateNavbar);
      ticking = true;
    }
  }, { passive: true });
</script>
