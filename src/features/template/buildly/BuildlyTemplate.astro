---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import BuildlyLanding from './BuildlyLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'buildly-property')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-white text-[#0B0B0F] font-sans antialiased selection:bg-[#ECE8FF] selection:text-[#5B46E5]">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="buildly-property" lang={lang} />

  <!-- Complete Buildly Landing Page mounted with client:load -->
  <BuildlyLanding client:load lang={lang} />

</body>
</html>
