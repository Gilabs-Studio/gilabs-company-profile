---
import { getWhatsAppLink } from '../../../lib/utils';
import '../../../styles/globals.css';
import NusantaraLanding from './NusantaraLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const templateTitle = lang === 'en' 
  ? "Template: Nusantara • Luxury Minimalist Fashion & Apparel" 
  : "Template: Nusantara • Brand Fashion & Apparel Minimalis";
const templatePrice = "Rp 1.289.000";
const buyUrl = getWhatsAppLink('template', lang, templateTitle);
const catalogUrl = `/${lang}/templates`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <style is:global>
    @font-face {
      font-family: 'Plus Jakarta Sans';
      src: url('/fonts/PlusJakartaSans-Variable.ttf') format('truetype');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #D5D4CF;
      color: #111111;
    }

    ::selection {
      background-color: #111111;
      color: #D5D4CF;
    }
  </style>
</head>
<body class="bg-[#D5D4CF] text-[#111111] antialiased">

  <!-- Top Sticky Demo Header Bar -->
  <header class="sticky top-0 z-50 bg-[#0c1220] text-white px-4 py-2.5 text-xs flex items-center justify-between border-b border-slate-800 shadow-md">
    <div class="flex items-center gap-3">
      <a 
        href={catalogUrl} 
        class="text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-medium"
      >
        <span>←</span>
        <span>{lang === 'en' ? 'Back to Catalog' : 'Kembali ke Katalog'}</span>
      </a>
      <span class="text-neutral-600 hidden sm:inline">|</span>
      <span class="font-semibold text-neutral-200 hidden sm:inline">{templateTitle}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-neutral-300 font-mono hidden md:inline">{templatePrice}</span>
      <a
        href={buyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#2563EB] hover:bg-blue-600 text-white font-medium px-3.5 py-1.5 rounded text-xs transition-colors cursor-pointer"
      >
        {lang === 'en' ? 'Purchase Template' : 'Beli Template Ini'}
      </a>
    </div>
  </header>

  <!-- Complete Nusantara Landing Page mounted with client:load -->
  <NusantaraLanding client:load lang={lang} />

</body>
</html>
