---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import NusantaraLanding from './NusantaraLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'nusantara')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <style is:global>
    @font-face {
      font-family: 'Plus Jakarta Sans';
      src: url('/fonts/PlusJakartaSans-Variable.ttf') format('truetype');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #D5D4CF;
      color: #111111;
    }

    ::selection {
      background-color: #111111;
      color: #D5D4CF;
    }
  </style>
</head>
<body class="bg-[#D5D4CF] text-[#111111] antialiased">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="nusantara" lang={lang} />

  <!-- Complete Nusantara Landing Page mounted with client:load -->
  <NusantaraLanding client:load lang={lang} />

</body>
</html>
