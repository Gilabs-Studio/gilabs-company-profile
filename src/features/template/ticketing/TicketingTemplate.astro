---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import TicketingLanding from './TicketingLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'ticketing-events')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    @keyframes shine {
      0% {
        background-position: 0% 0%;
      }
      50% {
        background-position: 100% 100%;
      }
      to {
        background-position: 0% 0%;
      }
    }
    .animate-shine {
      animation: shine 14s linear infinite;
    }
  </style>
</head>
<body class="bg-black text-white font-sans antialiased selection:bg-amber-500 selection:text-black">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="ticketing-events" lang={lang} />

  <!--  Complete Ticketing Landing Page mounted with client:load  -->
  <TicketingLanding client:load locale={lang} />

</body>
</html>
