---
import { polinesContentData } from '../data/content';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
const currentLang = (lang === 'en' ? 'en' : 'id') as 'id' | 'en';
const t = polinesContentData[currentLang].footer;
const departments = polinesContentData[currentLang].campusLife.departments;
const megaAdmissions = polinesContentData[currentLang].nav.megaMenu.admissions.links;
---

<!-- ==========================================
     STICKY REVEAL FOOTER (Sticky Bottom-0 Z-0)
     ========================================== -->
<footer id="site-footer" class="footer sticky bottom-0 z-0 bg-[#0A0807] text-[#E6E1D6] border-t border-orange-500/15 overflow-hidden">
  <div class="max-w-[92rem] mx-auto px-6 md:px-14 py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 lg:gap-14 mb-16">
      
      <!-- Col 1 & 2: Brand & Address -->
      <div class="md:col-span-2 flex flex-col items-start gap-5 text-left">
        <a href="#root" class="flex flex-col items-start gap-2.5 group">
          <img 
            src="/templates/polines/logo-lorem-white.svg" 
            alt="Lorem Polytechnic Institute" 
            class="h-9 sm:h-10 w-auto object-contain transition-opacity duration-200 group-hover:opacity-90" 
          />
          <span class="text-xs uppercase tracking-widest text-[#FF5A1F] font-medium">
            {t.tagline}
          </span>
        </a>

        <p class="text-xs text-white/70 font-light leading-relaxed max-w-sm mt-2">
          {t.address}
        </p>

        <p class="text-xs text-white/60 font-light">
          {t.contact}
        </p>

        <!-- Social Icons (Sharp Lancip) -->
        <div class="flex items-center gap-2 pt-2">
          <a 
            href="#root" 
            aria-label="LinkedIn Lorem Polytechnic"
            class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/70 hover:text-[#FF5A1F] hover:border-[#FF5A1F] transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a 
            href="#root" 
            aria-label="Instagram Lorem Polytechnic"
            class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/70 hover:text-[#FF5A1F] hover:border-[#FF5A1F] transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
          <a 
            href="#root" 
            aria-label="YouTube Lorem Polytechnic"
            class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/70 hover:text-[#FF5A1F] hover:border-[#FF5A1F] transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 3: Jurusan -->
      <div class="flex flex-col gap-3 text-left">
        <h4 class="text-xs uppercase tracking-widest text-[#FF5A1F] font-semibold mb-1">
          {t.colDepartmentsTitle}
        </h4>
        {departments.map((dept) => (
          <a 
            href="#kehidupan-kampus" 
            data-el="nav-link"
            class="text-sm text-white/75 hover:text-[#FF5A1F] transition-colors cursor-pointer"
          >
            {dept.title}
          </a>
        ))}
      </div>

      <!-- Col 4: Layanan Publik & PMB -->
      <div class="flex flex-col gap-3 text-left">
        <h4 class="text-xs uppercase tracking-widest text-[#FF5A1F] font-semibold mb-1">
          {t.colPortalsTitle}
        </h4>
        {megaAdmissions.map((link) => (
          <a 
            href={link.href} 
            data-el="nav-link"
            class="text-sm text-white/75 hover:text-[#FF5A1F] transition-colors cursor-pointer"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Col 5: Newsletter / Kontak Cepat -->
      <div class="flex flex-col text-left">
        <h4 class="text-xs uppercase tracking-widest text-[#FF5A1F] font-semibold mb-3">
          {t.newsletterTitle}
        </h4>
        <p class="text-xs text-white/70 font-light mb-4 leading-relaxed">
          {t.newsletterDesc}
        </p>
        <form 
          onsubmit={`event.preventDefault(); alert('${t.newsletterSuccess}');`} 
          class="relative w-full flex items-center"
        >
          <input 
            type="email" 
            placeholder="Alamat email Anda" 
            required 
            class="w-full bg-transparent border-b border-white/30 pb-2.5 pr-8 text-sm text-white placeholder-white/40 focus:outline-none focus:border-[#FF5A1F] rounded-none"
          />
          <button 
            type="submit" 
            aria-label="Submit newsletter" 
            class="absolute right-0 bottom-2 text-white/70 hover:text-[#FF5A1F] transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 13 13">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M11.2539 6.11092L5.87125 0.728237L6.47607 0.123413L12.8768 6.52413L6.82855 12.5724L6.22373 11.9676L11.225 6.96627L0.61396 6.96627L0.61396 6.11092L11.2539 6.11092Z" />
            </svg>
          </button>
        </form>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50 font-light border-t border-white/10">
      <p>{t.copyright}</p>
      <div class="flex items-center gap-6">
        <a href="#profil" class="hover:text-white transition-colors cursor-pointer">Tentang Kami</a>
        <a href="#kehidupan-kampus" class="hover:text-white transition-colors cursor-pointer">Fasilitas</a>
        <a href="#pmb" class="hover:text-white transition-colors cursor-pointer">Pendaftaran</a>
      </div>
    </div>
  </div>
</footer>
