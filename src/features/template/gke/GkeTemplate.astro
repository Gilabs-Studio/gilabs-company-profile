---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import GkeLanding from './GkeLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'gke-enterprise')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-white text-slate-900 font-sans antialiased selection:bg-blue-600 selection:text-white">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="gke-enterprise" lang={lang} />

  <!--  Exact GKE Framer Motion Animated Landing  -->
  <GkeLanding client:load lang={lang} />

</body>
</html>

