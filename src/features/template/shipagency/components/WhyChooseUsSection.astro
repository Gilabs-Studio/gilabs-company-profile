---
interface Props {
  lang: 'id' | 'en';
}

const { lang } = Astro.props;

const advantages = [
  {
    title: lang === 'en' ? 'Fast Process' : 'Proses Cepat',
    desc: lang === 'en'
      ? 'Fund disbursement significantly faster than conventional banks.'
      : 'Pencairan dana lebih cepat dari bank konvensional.',
    icon: 'helm'
  },
  {
    title: lang === 'en' ? 'Competitive Rates' : 'Bunga Kompetitif',
    desc: lang === 'en'
      ? 'Financing rates that are attractive and completely transparent.'
      : 'Biaya pembiayaan yang atraktif dan transparan.',
    icon: 'dollar'
  },
  {
    title: lang === 'en' ? 'Flexible Tenor' : 'Tenor Fleksibel',
    desc: lang === 'en'
      ? 'Customized payment schedule aligning with your maritime business cash flow.'
      : 'Menyesuaikan dengan arus kas bisnis Anda.',
    icon: 'gear'
  },
  {
    title: lang === 'en' ? 'Backed by Professionals' : 'Didukung Tim Profesional',
    desc: lang === 'en'
      ? 'Seasoned specialists with decades of experience in maritime financing.'
      : 'Tim berpengalaman di bidang pembiayaan maritim.',
    icon: 'shield'
  }
];
---

<section
  id="keunggulan"
  class="relative w-full bg-white py-12 sm:py-16 px-4 sm:px-8 lg:px-12 flex items-center justify-center"
>
  <!-- Dark Navy Container with Rounded Corners matching user reference media_1791948052642.png -->
  <div class="relative w-full max-w-7xl rounded-2xl sm:rounded-3xl bg-[#041a3d] border border-blue-500/20 overflow-hidden p-8 sm:p-12 lg:p-14 shadow-2xl">
    
    <!-- Exact Tug / Supply Vessel Background from Reference -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <img
        src="/templates/shipagency/images/ship-keunggulan.webp"
        alt="Maritime Supply Vessel"
        class="w-full h-full object-cover object-center opacity-45 mix-blend-luminosity scale-105"
        loading="lazy"
      />
      <!-- Vignette Gradient to blend seamlessly with left text and right features -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#041a3d] via-[#041a3d]/60 via-35% to-[#041a3d]/90"></div>
    </div>

    <div class="relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Copy & Action -->
      <div class="lg:col-span-5 flex flex-col items-start">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-600/30 border border-blue-400/40 text-blue-300 text-[11px] font-bold uppercase tracking-wider mb-4">
          <span>{lang === 'en' ? 'WHY CHOOSE US' : 'KEUNGGULAN KAMI'}</span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight tracking-tight">
          {lang === 'en' ? (
            <>Why Choose<br />Financing from Us?</>
          ) : (
            <>Kenapa Memilih<br />Pembiayaan dari Kami?</>
          )}
        </h2>

        <p class="text-blue-200/90 text-xs sm:text-sm leading-relaxed mt-4 max-w-sm font-light">
          {lang === 'en'
            ? 'We understand the unique challenges in the maritime sector; thus we provide swift, safe, and dependable financing solutions.'
            : 'Kami memahami tantangan di industri maritim, oleh karena itu kami hadir dengan solusi pembiayaan yang cepat, aman, dan terpercaya.'}
        </p>

        <div class="mt-7">
          <a
            href="#kontak"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white hover:bg-slate-100 active:bg-slate-200 text-[#041a3d] font-bold text-xs sm:text-sm tracking-wide shadow-xl transition-all hover:-translate-y-0.5 cursor-pointer"
          >
            <span>{lang === 'en' ? 'Apply Now' : 'Ajukan Sekarang'}</span>
            <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: 2x2 Feature Grid with Blue Circular Badges -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-y-7 gap-x-8 w-full">
        {advantages.map((item) => (
          <div class="flex items-start gap-4">
            <!-- Circular Blue Badge Icon -->
            <div class="w-12 h-12 rounded-full bg-[#0d346b] border border-blue-400/40 text-white flex items-center justify-center shrink-0 shadow-md">
              {item.icon === 'helm' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="4" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v4m0 12v4M2 12h4m12 0h4m-3.07-6.93l-2.83 2.83m-8.48 8.48l-2.83 2.83m0-14.14l2.83 2.83m8.48 8.48l2.83 2.83" />
                </svg>
              )}
              {item.icon === 'dollar' && (
                <span class="text-xl font-black font-sans text-white">$</span>
              )}
              {item.icon === 'gear' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
              {item.icon === 'shield' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
            </div>

            <div>
              <h3 class="text-sm sm:text-base font-bold text-white mb-1">
                {item.title}
              </h3>
              <p class="text-xs text-blue-200/80 leading-relaxed font-light">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
