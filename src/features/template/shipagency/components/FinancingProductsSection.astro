---
interface Props {
  lang: 'id' | 'en';
}

const { lang } = Astro.props;

const products = [
  {
    title: lang === 'en' ? 'Fleet Financing' : 'Pembiayaan Armada',
    desc: lang === 'en' 
      ? 'For acquiring new vessels, second-hand ships, and comprehensive fleet maintenance needs.' 
      : 'Untuk pembelian kapal baru, kapal bekas, dan kebutuhan perawatan armada.',
    icon: 'ship'
  },
  {
    title: lang === 'en' ? 'Equipment Financing' : 'Pembiayaan Peralatan',
    desc: lang === 'en'
      ? 'For procuring heavy machinery, port clearance equipment, and operational gear.'
      : 'Untuk pengadaan alat berat, peralatan pelabuhan, dan perlengkapan operasional.',
    icon: 'gear'
  },
  {
    title: lang === 'en' ? 'Crew Financing' : 'Pembiayaan Kru',
    desc: lang === 'en'
      ? 'For crew operational expenses, maritime specialized training, and international certifications.'
      : 'Untuk kebutuhan biaya operasional kru, pelatihan, dan sertifikasi.',
    icon: 'crew'
  },
  {
    title: lang === 'en' ? 'Working Capital' : 'Modal Kerja',
    desc: lang === 'en'
      ? 'To preserve business liquidity and guarantee seamless operational day-to-day cashflow.'
      : 'Untuk menjaga likuiditas bisnis dan kelancaran arus kas operasional.',
    icon: 'wallet'
  }
];
---

<section
  id="produk"
  class="relative min-h-[100dvh] w-full bg-[#f8fafc] text-slate-900 flex flex-col justify-center items-center py-20 sm:py-24 px-6 sm:px-12 lg:px-16 border-t border-slate-100"
>
  <div class="mx-auto max-w-7xl w-full flex flex-col items-center">
    <!-- Section Top Header & Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold uppercase tracking-wider mb-3">
      <span>{lang === 'en' ? 'FINANCING PRODUCTS' : 'PRODUK PEMBIAYAAN'}</span>
    </div>

    <h2 class="text-2xl sm:text-4xl lg:text-4xl font-black text-[#0c2340] text-center tracking-tight max-w-3xl leading-tight">
      {lang === 'en' 
        ? 'Financing Options Tailored to Your Specific Needs' 
        : 'Pilihan Pembiayaan yang Sesuai dengan Kebutuhan Anda'}
    </h2>

    <p class="text-slate-600 text-xs sm:text-sm text-center max-w-2xl mt-3 leading-relaxed">
      {lang === 'en'
        ? 'We deliver diverse structured financing solutions to empower every operational and business expansion phase in the maritime domain.'
        : 'Kami menyediakan berbagai solusi pembiayaan untuk mendukung setiap aspek operasional dan pengembangan bisnis maritim.'}
    </p>

    <!-- 4 Feature Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full mt-12 sm:mt-14">
      {products.map((item) => (
        <div class="bg-white rounded-2xl border border-blue-100/90 p-7 shadow-xs hover:shadow-xl hover:border-blue-300 transition-all duration-300 flex flex-col justify-between hover:-translate-y-1.5 cursor-pointer group">
          <div>
            <!-- Icon Box -->
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
              {item.icon === 'ship' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v4m0 0H8m4 0h4M3 13h18l-2 7H5l-2-7zm2-3l2-4h10l2 4H5z" />
                </svg>
              )}
              {item.icon === 'gear' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
              {item.icon === 'crew' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              )}
              {item.icon === 'wallet' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
              )}
            </div>

            <!-- Card Heading -->
            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2.5">
              {item.title}
            </h3>

            <!-- Card Description -->
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <!-- Bottom Action Link -->
          <div class="mt-7 pt-4 border-t border-slate-100 flex items-center text-xs font-bold text-blue-600 group-hover:text-blue-700">
            <span>{lang === 'en' ? 'Learn More' : 'Pelajari Selengkapnya'}</span>
            <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
