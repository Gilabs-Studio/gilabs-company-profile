---
interface Props {
  lang: 'id' | 'en';
}

const { lang } = Astro.props;
---

<section
  id="solusi"
  class="relative min-h-[100dvh] w-full bg-white text-slate-900 flex items-center justify-center py-20 sm:py-24 px-6 sm:px-12 lg:px-16 overflow-hidden"
>
  <div class="mx-auto max-w-7xl w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
    <!-- Left Column: Copy & Value Proposition -->
    <div class="lg:col-span-6 flex flex-col items-start space-y-6">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold uppercase tracking-wider">
        <span>{lang === 'en' ? 'FINANCIAL SOLUTIONS FOR MARITIME INDUSTRY' : 'SOLUSI KEUANGAN UNTUK INDUSTRI MARITIM'}</span>
      </div>

      <!-- Main Heading -->
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#0c2340] leading-[1.2] tracking-tight">
        {lang === 'en' 
          ? 'Financing to Support Your Fleet Operations' 
          : 'Pembiayaan untuk Mendukung Operasional Armada Anda'}
      </h2>

      <!-- Description Paragraph -->
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-xl">
        {lang === 'en'
          ? 'We provide flexible and rapid financing solutions for vessel operations, crew welfare, and overall maritime business growth.'
          : 'Kami menyediakan solusi pembiayaan yang fleksibel dan cepat untuk kebutuhan operasional kapal, kru, dan pengembangan bisnis maritim Anda.'}
      </p>

      <!-- 3 Key Features Row -->
      <div class="flex flex-wrap items-center gap-6 sm:gap-8 pt-2">
        <!-- Feature 1 -->
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-bold text-slate-800">
            {lang === 'en' ? 'Fast & Easy Process' : 'Proses Cepat & Mudah'}
          </span>
        </div>

        <!-- Feature 2 -->
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-bold text-slate-800">
            {lang === 'en' ? 'Competitive Rates' : 'Bunga Kompetitif'}
          </span>
        </div>

        <!-- Feature 3 -->
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-bold text-slate-800">
            {lang === 'en' ? 'Flexible Tenor' : 'Tenor Fleksibel'}
          </span>
        </div>
      </div>

      <!-- Action Button -->
      <div class="pt-4">
        <a
          href="#kontak"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#1e61d5] hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm tracking-wide shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
        >
          <span>{lang === 'en' ? 'Apply for Financing' : 'Ajukan Pembiayaan'}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Visual Composite Graphic (Arch Vessel + Floating Financial Card) -->
    <div class="lg:col-span-6 relative flex items-center justify-center lg:justify-end">
      <!-- Decorative Background Organic Waves / Bubbles -->
      <div class="absolute -top-10 -right-6 w-80 h-80 bg-blue-100/50 rounded-full blur-2xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-6 w-72 h-72 bg-sky-100/60 rounded-full blur-xl pointer-events-none"></div>

      <!-- Main Container with Arch Cutout Image -->
      <div class="relative w-full max-w-[480px]">
        <!-- Arch Framed Cargo Vessel Image -->
        <div class="relative w-full h-[360px] sm:h-[420px] rounded-t-[140px] rounded-b-[40px] overflow-hidden shadow-2xl border-4 border-white bg-slate-100">
          <img
            src="/templates/shipagency/images/financing-vessel.webp"
            alt="Cargo Ship Maritime Financing"
            class="w-full h-full object-cover object-center scale-105 hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-blue-950/40 via-transparent to-transparent"></div>
        </div>

        <!-- Floating Glass Card (Rp 5.000.000.000 + Chart) -->
        <div class="absolute bottom-12 -left-4 sm:-left-8 z-20 bg-white/95 backdrop-blur-md rounded-2xl p-5 shadow-2xl border border-slate-100 w-[270px] sm:w-[310px] animate-in fade-in zoom-in duration-500">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">
              {lang === 'en' ? 'Flexible Calculation' : 'Perhitungan Fleksibel'}
            </span>
            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">
              <span>✓</span>
              <span>{lang === 'en' ? 'Fast' : 'Cepat'}</span>
            </span>
          </div>

          <div class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mt-1.5">
            Rp 5.000.000.000
          </div>

          <!-- Bar Chart Representation -->
          <div class="flex items-end justify-between gap-2 h-14 mt-3 pt-2 border-t border-slate-100">
            <div class="w-full bg-blue-300 rounded-t h-[30%]"></div>
            <div class="w-full bg-blue-300 rounded-t h-[45%]"></div>
            <div class="w-full bg-blue-300 rounded-t h-[60%]"></div>
            <div class="w-full bg-blue-400 rounded-t h-[40%]"></div>
            <div class="w-full bg-blue-400 rounded-t h-[75%]"></div>
            <div class="w-full bg-blue-500 rounded-t h-[95%]"></div>
            <div class="w-full bg-blue-500 rounded-t h-[70%]"></div>
            <div class="w-full bg-blue-600 rounded-t h-[100%]"></div>
          </div>
        </div>

        <!-- Dark Blue Caption Banner under arch -->
        <div class="relative -mt-6 z-10 mx-auto w-[90%] bg-[#0e3b6f] text-white text-center py-3.5 px-6 rounded-2xl shadow-xl shadow-blue-950/20">
          <p class="text-xs sm:text-sm font-medium tracking-wide">
            {lang === 'en'
              ? 'Financial support for smooth fleet vessel operations.'
              : 'Dukungan finansial untuk kelancaran operasional kapal Anda.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
