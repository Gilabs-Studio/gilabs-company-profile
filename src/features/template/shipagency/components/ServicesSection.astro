---
interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
const isEn = lang === 'en';

const tag = "OUR SERVICES";
const title = isEn 
  ? "Ship Agency Outsourcing Solutions" 
  : "Solusi Outsourcing Agen Perkapalan";
const description = isEn
  ? "We provide experienced professionals ready to support your vessel operations and shipping company efficiently and reliably."
  : "Kami menyediakan tenaga profesional dan berpengalaman yang siap mendukung operasional kapal dan perusahaan pelayaran Anda secara efisien dan terpercaya.";

const services = [
  {
    icon: 'users',
    title: "Crew Management",
    desc: isEn
      ? "Provision of competent, well-trained crew members adhering to international standards."
      : "Penyediaan kru kapal yang kompeten, terlatih, dan sesuai standar internasional."
  },
  {
    icon: 'fileText',
    title: "Technical Support",
    desc: isEn
      ? "Vessel technical support including maintenance, repairs, and technical inspections."
      : "Dukungan teknis kapal termasuk perawatan, perbaikan, dan inspeksi."
  },
  {
    icon: 'package',
    title: "Logistics Support",
    desc: isEn
      ? "Procurement of vessel supplies ranging from spare parts and equipment to full logistics."
      : "Pengadaan kebutuhan kapal mulai dari suku cadang, perlengkapan, hingga logistik."
  },
  {
    icon: 'shieldCheck',
    title: "Compliance & Document",
    desc: isEn
      ? "Handling of vessel documentation and certification in accordance with national and international regulations."
      : "Pengurusan dokumen kapal dan sertifikasi sesuai regulasi nasional dan internasional."
  }
];
---

<section
  id="services"
  class="relative z-20 min-h-screen bg-[#030618] py-12 sm:py-20 px-4 sm:px-10 border-t border-[#030618] flex flex-col justify-center"
>
  <div class="max-w-7xl mx-auto relative z-10 w-full">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-2 sm:gap-6 mb-6 sm:mb-14 text-center lg:text-left">
      <div class="mx-auto lg:mx-0">
        <span class="text-emerald-400 font-mono text-[10px] sm:text-xs font-semibold uppercase tracking-wider block mb-1 sm:mb-2">
          {tag}
        </span>
        <h2 class="text-white text-xl sm:text-4xl font-bold tracking-tight max-w-xl leading-tight mx-auto lg:mx-0">
          {title}
        </h2>
      </div>
      <p class="text-slate-300 text-xs sm:text-base leading-relaxed max-w-lg mx-auto lg:text-right">
        {description}
      </p>
    </div>

    <!-- 4 Cards Grid - 2 columns on mobile, 4 columns on desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-6 w-full">
      {services.map((item) => (
        <div
          style="border-radius: 0.875rem;"
          class="bg-gradient-to-b from-[#14223d]/90 via-[#0d162a]/90 to-[#070c19]/95 border border-[#1d2f50]/60 p-3.5 sm:p-7 flex flex-col justify-between min-h-[125px] sm:min-h-[230px] shadow-xl shadow-black/40 backdrop-blur-md group hover:border-emerald-500/50 transition-all duration-300"
        >
          <div>
            <!-- Green Circle Icon -->
            <div
              style="border-radius: 50%;"
              class="w-7 h-7 sm:w-12 sm:h-12 bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-2 sm:mb-6 shrink-0 group-hover:bg-emerald-500 group-hover:text-slate-950 transition-all duration-300"
            >
              {item.icon === 'users' && (
                <svg class="w-3.5 h-3.5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              )}
              {item.icon === 'fileText' && (
                <svg class="w-3.5 h-3.5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              )}
              {item.icon === 'package' && (
                <svg class="w-3.5 h-3.5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              )}
              {item.icon === 'shieldCheck' && (
                <svg class="w-3.5 h-3.5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
            </div>
            <!-- Title -->
            <h3 class="text-white text-xs sm:text-lg font-bold mb-1 sm:mb-3 tracking-tight group-hover:text-emerald-300 transition-colors leading-snug">
              {item.title}
            </h3>
            <!-- Description -->
            <p class="text-slate-300/85 text-[10px] sm:text-sm leading-snug line-clamp-3 sm:line-clamp-none">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
