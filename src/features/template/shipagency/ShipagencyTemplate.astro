---
import { getWhatsAppLink } from '../../../lib/utils';
import '../../../styles/globals.css';

import ShipagencyNavbar from './components/ShipagencyNavbar.astro';
import HeroSection from './components/HeroSection.astro';
import FinancingSolutionSection from './components/FinancingSolutionSection.astro';
import FinancingProductsSection from './components/FinancingProductsSection.astro';
import WhyChooseUsSection from './components/WhyChooseUsSection.astro';
import ApplicationProcessSection from './components/ApplicationProcessSection.astro';
import AchievementsSection from './components/AchievementsSection.astro';
import TestimonialsSection from './components/TestimonialsSection.astro';
import FaqSection from './components/FaqSection.astro';
import ShipagencyFooter from './components/ShipagencyFooter.astro';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const templateTitle = lang === 'en' 
  ? "Template 04: Maritime Port Agency & Fleet Financing" 
  : "Template 04: Keagenan Kapal Pelabuhan & Pembiayaan Maritim";
const templatePrice = "Rp 1.400.000";
const buyUrl = getWhatsAppLink('template', lang, templateTitle);
const catalogUrl = `/${lang}/templates`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-emerald-500 selection:text-slate-950 min-h-screen">

  <!-- Top Sticky Demo Header Bar -->
  <header class="sticky top-0 z-50 bg-[#0f172a] text-white px-4 py-2.5 text-xs flex items-center justify-between border-b border-slate-800 shadow-md">
    <div class="flex items-center gap-3">
      <a 
        href={catalogUrl} 
        class="text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-medium"
      >
        <span>←</span>
        <span>{lang === 'en' ? 'Back to Catalog' : 'Kembali ke Katalog'}</span>
      </a>
      <span class="text-slate-600 hidden sm:inline">|</span>
      <span class="font-semibold text-slate-200 hidden sm:inline">{templateTitle}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-slate-300 font-mono hidden md:inline">{templatePrice}</span>
      <a
        href={buyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#2563EB] hover:bg-blue-600 text-white font-medium px-3.5 py-1.5 rounded text-xs transition-colors cursor-pointer"
      >
        {lang === 'en' ? 'Purchase Template' : 'Beli Template Ini'}
      </a>
    </div>
  </header>

  <!-- Sticky Maritime Floating Navbar -->
  <ShipagencyNavbar lang={lang} />

  <!-- Main Sections Orchestration (1 Section = 1 Window Layout Cadence) -->
  <main class="w-full">
    <!-- 01. Hero Section (100dvh) -->
    <HeroSection lang={lang} />

    <!-- 02. Financing Solutions Section (100dvh) -->
    <FinancingSolutionSection lang={lang} />

    <!-- 03. Financing Products 4-Card Section (100dvh) -->
    <FinancingProductsSection lang={lang} />

    <!-- 04. Why Choose Us Section with Vessel Watermark (100dvh) -->
    <WhyChooseUsSection lang={lang} />

    <!-- 05. Application Process 4-Step Flow (100dvh) -->
    <ApplicationProcessSection lang={lang} />

    <!-- 06. Achievements & Track Record Section (90-100dvh) -->
    <AchievementsSection lang={lang} />

    <!-- 07. Testimonials Carousel Section (100dvh) -->
    <TestimonialsSection lang={lang} />

    <!-- 08. FAQ 2-Column Accordion Section (100dvh) -->
    <FaqSection lang={lang} />
  </main>

  <!-- 09. Dark Navy Footer -->
  <ShipagencyFooter lang={lang} />

</body>
</html>
