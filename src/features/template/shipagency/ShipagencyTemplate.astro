---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';

import ShipagencyNavbar from './components/ShipagencyNavbar.astro';
import HeroSection from './components/HeroSection.astro';
import ServicesSection from './components/ServicesSection.astro';
import ShipagencyTestimonials from './components/ShipagencyTestimonials';
import AboutStatsScrollSection from './components/AboutStatsScrollSection';
import ShipagencyFooter from './components/ShipagencyFooter.astro';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'shipagency-maritime')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-emerald-500 selection:text-slate-950 min-h-screen">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="shipagency-maritime" lang={lang} />

  <!-- Sticky Maritime Floating Navbar -->
  <ShipagencyNavbar lang={lang} />

  <!-- Main Sections Orchestration (Exactly Matching docs/ship Full Landing Page) -->
  <main class="w-full">
    <!-- 01. Hero Section (100dvh) with Parallax & Entrance Animation -->
    <HeroSection lang={lang} />

    <!-- 02. Services Section (4 Cards Grid) -->
    <ServicesSection lang={lang} />

    <!-- 02.5. Testimonials Section (Interactive Maritime Client Endorsements) -->
    <ShipagencyTestimonials client:load lang={lang} />

    <!-- 03. About & Stats Scroll Frame Animation Section (Canvas Frame Playback 1-95) -->
    <AboutStatsScrollSection client:load lang={lang} />
  </main>

  <!-- 04. Dark Maritime Footer -->
  <ShipagencyFooter lang={lang} />

</body>
</html>
