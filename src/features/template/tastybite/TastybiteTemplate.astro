---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import TastybiteLanding from './TastybiteLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'tastybite')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Outfit:wght@400;500;600;700;800;900&family=Patrick+Hand&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style is:global>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #ffffff;
      color: #121518;
    }
    
    .font-outfit {
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif !important;
    }

    .font-doodle {
      font-family: 'Caveat', 'Patrick Hand', cursive !important;
    }

    ::selection {
      background-color: #ffd000;
      color: #121518;
    }
  </style>
</head>
<body class="bg-white text-[#121518] antialiased">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="tastybite" lang={lang} />

  <!-- Complete Tastybite Landing Page mounted with client:load -->
  <TastybiteLanding client:load lang={lang} />

</body>
</html>
