---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import LaTableEternelleLanding from './LaTableEternelleLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'la-table-eternelle')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style is:global>
    @font-face {
      font-family: 'Pinyon Script';
      src: url('/fonts/PinyonScript-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Cormorant Garamond';
      src: url('/fonts/CormorantGaramond-Italic.ttf') format('truetype');
      font-weight: 400;
      font-style: italic;
      font-display: swap;
    }
    @font-face {
      font-family: 'Playfair Display';
      src: url('/fonts/PlayfairDisplay-Italic.ttf') format('truetype');
      font-weight: 400;
      font-style: italic;
      font-display: swap;
    }

    .font-script {
      font-family: 'Pinyon Script', 'Alex Brush', cursive !important;
    }
    .font-latin {
      font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
      font-style: italic !important;
    }
    .font-cursive {
      font-family: 'Pinyon Script', cursive !important;
    }
    .font-serif-luxury {
      font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
      font-style: italic !important;
    }
    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF6EC 0%, #E8C8A9 35%, #D4AF37 70%, #9F7244 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      display: inline-block !important;
    }
  </style>
</head>
<body class="bg-[#080808] text-white font-sans antialiased selection:bg-[#901513] selection:text-white">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="la-table-eternelle" lang={lang} />

  <!-- Complete La Table Éternelle Landing Page mounted with client:load -->
  <LaTableEternelleLanding client:load lang={lang} />

</body>
</html>
