---
import { getWhatsAppLink } from '../../../lib/utils';
import '../../../styles/globals.css';
import LaTableEternelleLanding from './LaTableEternelleLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const templateTitle = lang === 'en' 
  ? "Template 06: La Table Éternelle • Luxury Fine Dining & Hospitality" 
  : "Template 06: La Table Éternelle • Restoran Fine Dining Mewah";
const templatePrice = "Rp 689.000";
const buyUrl = getWhatsAppLink('template', lang, templateTitle);
const catalogUrl = `/${lang}/templates`;
---

<!DOCTYPE html>
<html lang={lang} class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style is:global>
    @font-face {
      font-family: 'Pinyon Script';
      src: url('/fonts/PinyonScript-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Cormorant Garamond';
      src: url('/fonts/CormorantGaramond-Italic.ttf') format('truetype');
      font-weight: 400;
      font-style: italic;
      font-display: swap;
    }
    @font-face {
      font-family: 'Playfair Display';
      src: url('/fonts/PlayfairDisplay-Italic.ttf') format('truetype');
      font-weight: 400;
      font-style: italic;
      font-display: swap;
    }

    .font-script {
      font-family: 'Pinyon Script', 'Alex Brush', cursive !important;
    }
    .font-latin {
      font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
      font-style: italic !important;
    }
    .font-cursive {
      font-family: 'Pinyon Script', cursive !important;
    }
    .font-serif-luxury {
      font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
      font-style: italic !important;
    }
    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF6EC 0%, #E8C8A9 35%, #D4AF37 70%, #9F7244 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      display: inline-block !important;
    }
  </style>
</head>
<body class="bg-[#080808] text-white font-sans antialiased selection:bg-[#901513] selection:text-white">

  <!-- Top Sticky Demo Header Bar -->
  <header class="sticky top-0 z-50 bg-[#0c1220] text-white px-4 py-2.5 text-xs flex items-center justify-between border-b border-slate-800 shadow-md">
    <div class="flex items-center gap-3">
      <a 
        href={catalogUrl} 
        class="text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-medium"
      >
        <span>←</span>
        <span>{lang === 'en' ? 'Back to Catalog' : 'Kembali ke Katalog'}</span>
      </a>
      <span class="text-neutral-600 hidden sm:inline">|</span>
      <span class="font-semibold text-neutral-200 hidden sm:inline">{templateTitle}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-neutral-300 font-mono hidden md:inline">{templatePrice}</span>
      <a
        href={buyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#2563EB] hover:bg-blue-600 text-white font-medium px-3.5 py-1.5 rounded text-xs transition-colors cursor-pointer"
      >
        {lang === 'en' ? 'Purchase Template' : 'Beli Template Ini'}
      </a>
    </div>
  </header>

  <!-- Complete La Table Éternelle Landing Page mounted with client:load -->
  <LaTableEternelleLanding client:load lang={lang} />

</body>
</html>
