---
import TemplateDemoHeader from '../../../components/templates/TemplateDemoHeader.astro';
import { templatesData } from '../../../data/templatesData';
import '../../../styles/globals.css';
import SuraBayLanding from './SuraBayLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const template = templatesData.find((t) => t.id === 'sura-bay')!;
const templateTitle = lang === 'en' && template.titleEn ? template.titleEn : template.title;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style is:global>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0e0f0d;
      color: #ffffff;
      overflow-x: hidden;
    }
    
    .font-script {
      font-family: 'Alex Brush', cursive !important;
    }

    .font-serif {
      font-family: 'Playfair Display', Georgia, serif !important;
    }

    .font-sans {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
    }

    ::selection {
      background-color: #C59A53;
      color: #0E0F0D;
    }
  </style>
</head>
<body class="bg-[#0e0f0d] text-white antialiased selection:bg-[#C59A53] selection:text-[#0E0F0D]">

  <!-- Top Sticky Demo Header Bar -->
  <TemplateDemoHeader templateId="sura-bay" lang={lang} />

  <!-- Complete Sura Bay Landing Page mounted with client:load -->
  <SuraBayLanding client:load lang={lang} />

</body>
</html>
