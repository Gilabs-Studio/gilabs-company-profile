---
import { getWhatsAppLink } from '../../../lib/utils';
import '../../../styles/globals.css';
import VistaPropsLanding from './VistaPropsLanding';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const templateTitle = lang === 'en' 
  ? "Template 03: Lorem • Commercial Real Estate & Industrial Hubs" 
  : "Template 03: Lorem • Real Estate Komersial & Kawasan Industri";
const templatePrice = "Rp 2.800.000";
const buyUrl = getWhatsAppLink('template', lang, templateTitle);
const catalogUrl = `/${lang}/templates`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Libre+Franklin:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

  <style is:global>
    @font-face {
      font-family: 'Pinyon Script';
      src: url('/fonts/PinyonScript-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --all-colors--background: #edebe4;
      --all-colors--black: black;
      --all-colors--blue: #265073;
      --all-colors--blue-hover: #1c4669;
      --all-colors--dark-gold: #d43331;
      --all-colors--dark-grey: #1e1e1e;
      --all-colors--gold: #baa184;
      --all-colors--medium-gold: #815d32;
      --all-colors--white: white;
      --button-radius: 100rem;
      --input-radius: .75rem;
      --site-width: 1440px;
      --type-all-fonts--primary-font: "Libre Franklin", sans-serif;
      --type-all-fonts--secondary-font: "Libre Baskerville", serif;
      --type-all-fonts--heading-font: "Avenir ltpro Roman", "Libre Franklin", sans-serif;
    }

    .font-script {
      font-family: 'Pinyon Script', cursive !important;
    }

    body {
      font-family: var(--type-all-fonts--primary-font);
      background-color: #ffffff;
      color: var(--all-colors--dark-grey);
      margin: 0;
      padding: 0;
    }

    ::selection {
      background-color: var(--all-colors--dark-gold);
      color: #ffffff;
    }
  </style>
</head>
<body class="bg-white text-[#1e1e1e] antialiased">

  <!-- Top Sticky Demo Header Bar -->
  <header class="sticky top-0 z-50 bg-[#0c1220] text-white px-4 py-2.5 text-xs flex items-center justify-between border-b border-slate-800 shadow-md">
    <div className="flex items-center gap-3" style="display: flex; align-items: center; gap: 0.75rem;">
      <a 
        href={catalogUrl} 
        class="text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-medium"
      >
        <span>←</span>
        <span>{lang === 'en' ? 'Back to Catalog' : 'Kembali ke Katalog'}</span>
      </a>
      <span class="text-neutral-600 hidden sm:inline">|</span>
      <span class="font-semibold text-neutral-200 hidden sm:inline">{templateTitle}</span>
    </div>

    <div className="flex items-center gap-3" style="display: flex; align-items: center; gap: 0.75rem;">
      <span class="text-neutral-300 font-mono hidden md:inline">{templatePrice}</span>
      <a
        href={buyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#2563EB] hover:bg-blue-600 text-white font-medium px-3.5 py-1.5 rounded text-xs transition-colors cursor-pointer"
      >
        {lang === 'en' ? 'Purchase Template' : 'Beli Template Ini'}
      </a>
    </div>
  </header>

  <!-- Mount VistaPropsLanding with client:load -->
  <VistaPropsLanding client:load lang={lang} />

</body>
</html>
