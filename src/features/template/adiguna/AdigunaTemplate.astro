---
import { getWhatsAppLink } from '../../../lib/utils';
import '../../../styles/globals.css';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const templateTitle = lang === 'en' 
  ? "Template 01: Industrial Machinery & Precision Manufacturing" 
  : "Template 01: Mesin Industri & Manufaktur Presisi";
const templatePrice = "Rp 1.250.000";
const buyUrl = getWhatsAppLink('template', lang, templateTitle);
const catalogUrl = `/${lang}/templates`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{templateTitle} - Live Demo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-[#f6f3ee] text-neutral-950 font-sans antialiased selection:bg-amber-400 selection:text-black">

  <!--  Top Sticky Demo Header Bar  -->
  <header class="sticky top-0 z-50 bg-[#0f172a] text-white px-4 py-2.5 text-xs flex items-center justify-between border-b border-slate-800 shadow-md">
    <div class="flex items-center gap-3">
      <a 
        href={catalogUrl} 
        class="text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-medium"
      >
        <span>←</span>
        <span>{lang === 'en' ? 'Back to Catalog' : 'Kembali ke Katalog'}</span>
      </a>
      <span class="text-slate-600 hidden sm:inline">|</span>
      <span class="font-semibold text-slate-200 hidden sm:inline">{templateTitle}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-slate-300 font-mono hidden md:inline">{templatePrice}</span>
      <a
        href={buyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#2563EB] hover:bg-blue-600 text-white font-medium px-3.5 py-1.5 rounded-sm text-xs transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
      >
        {lang === 'en' ? 'Purchase Template' : 'Beli Template Ini'}
      </a>
    </div>
  </header>

  <!--  Minimalist Floating Navigation  -->
  <header
    id="nav-container"
    class="fixed inset-x-0 top-[41px] z-40 px-4 pt-4 sm:px-6 lg:px-8 transition-all duration-300 pointer-events-none"
  >
    <nav
      id="main-nav"
      class="mx-auto flex h-[80px] max-w-7xl items-center justify-between px-0 transition-all duration-300 text-white border-transparent bg-transparent shadow-none pointer-events-auto"
    >
      <!--  Brand Logo: Hexagonal Glyph LOREM IPSUM  -->
      <a href="#beranda" class="group flex items-center gap-3 cursor-pointer">
        <div class="flex items-center gap-2.5">
          <svg class="h-8 w-8 text-amber-400 shrink-0" viewBox="0 0 40 40" fill="none">
            <polygon points="20,2 38,12 38,28 20,38 2,28 2,12" stroke="currentColor" stroke-width="2" fill="none"/>
            <circle cx="20" cy="20" r="3.5" fill="currentColor"/>
          </svg>
          <div>
            <span class="text-base font-bold tracking-tight text-white block leading-tight">
              LOREM <span class="font-light text-neutral-400">IPSUM</span>
            </span>
            <span class="text-[9px] uppercase tracking-widest text-white/50 block font-mono">
              Precision Machinery
            </span>
          </div>
        </div>
      </a>

      <!--  Nav Links  -->
      <div class="hidden items-center gap-8 lg:flex">
        <a href="#beranda" class="text-sm font-medium text-white/70 hover:text-white transition-colors cursor-pointer">
          {lang === 'en' ? 'Home' : 'Beranda'}
        </a>
        <a href="#tentang" class="text-sm font-medium text-white/70 hover:text-white transition-colors cursor-pointer">
          {lang === 'en' ? 'About Us' : 'Tentang Kami'}
        </a>
        <a href="#produk" class="text-sm font-medium text-white/70 hover:text-white transition-colors cursor-pointer">
          {lang === 'en' ? 'Products' : 'Produk'}
        </a>
        <a href="#proses" class="text-sm font-medium text-white/70 hover:text-white transition-colors cursor-pointer">
          {lang === 'en' ? 'Process' : 'Layanan'}
        </a>
        <a href="#testimoni" class="text-sm font-medium text-white/70 hover:text-white transition-colors cursor-pointer">
          {lang === 'en' ? 'Testimonials' : 'Testimoni'}
        </a>
        <a href="#kontak" class="text-sm font-medium text-white/70 hover:text-white transition-colors cursor-pointer">
          {lang === 'en' ? 'Contact' : 'Kontak'}
        </a>
      </div>

      <!--  Right Nav Actions  -->
      <div class="hidden items-center gap-4 lg:flex">
        <a
          href={`/${lang === 'id' ? 'en' : 'id'}/templates/demo/adiguna`}
          class="inline-flex h-9 items-center gap-1.5 px-3 border border-white/20 text-xs font-mono font-medium text-white/80 hover:text-white hover:border-white/50 transition-colors cursor-pointer"
        >
          <span>{lang.toUpperCase()}</span>
          <span class="text-neutral-500">|</span>
          <span class="text-neutral-400">{lang === 'id' ? 'EN' : 'ID'}</span>
        </a>
        <a
          href="#kontak"
          class="inline-flex h-9 items-center gap-2 bg-white px-4 text-xs font-semibold text-neutral-950 transition-all duration-300 hover:bg-amber-400 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
        >
          <span>{lang === 'en' ? 'Contact' : 'Hubungi'}</span>
          <span class="font-mono">→</span>
        </a>
      </div>
    </nav>
  </header>

  <script>
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        nav?.classList.add('bg-neutral-950/90', 'px-6', 'shadow-xl', 'backdrop-blur-md', 'border', 'border-white/10');
        nav?.classList.remove('border-transparent', 'bg-transparent', 'px-0', 'shadow-none');
      } else {
        nav?.classList.remove('bg-neutral-950/90', 'px-6', 'shadow-xl', 'backdrop-blur-md', 'border', 'border-white/10');
        nav?.classList.add('border-transparent', 'bg-transparent', 'px-0', 'shadow-none');
      }
    }, { passive: true });
  </script>

  <!--  01. HERO SECTION (Dark Entrance with Machine Background, 2 Text Elements)  -->
  <section
    id="beranda"
    class="relative min-h-[calc(100svh-41px)] flex items-end overflow-hidden bg-neutral-950 px-6 pb-20 pt-32 text-white sm:px-8 lg:px-12"
  >
    <div class="absolute inset-0 h-full w-full pointer-events-none">
      <img
        src="/templates/adiguna/landing/v2/hero-machine.jpg"
        alt="Precision Industrial CNC Machine"
        class="w-full h-full object-cover object-center opacity-55"
        loading="eager"
      />
    </div>

    <!--  Dark Atmospheric Gradients  -->
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/65 to-neutral-950/20 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/85 via-neutral-950/45 to-transparent pointer-events-none"></div>

    <div class="relative z-10 mx-auto w-full max-w-7xl">
      <div class="max-w-3xl">
        <h1 class="text-5xl font-semibold leading-[0.98] tracking-tight sm:text-7xl lg:text-8xl text-white">
          Lorem Ipsum<br />Dolor Amet
        </h1>

        <p class="mt-7 max-w-2xl text-base sm:text-lg leading-relaxed text-white/70">
          {lang === 'en'
            ? "High-precision machinery systems and industrial tooling engineered for modern manufacturing excellence."
            : "Penyedia solusi permesinan presisi dan perkakas industri berstandar tinggi untuk kebutuhan manufaktur modern."}
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#produk"
            class="group inline-flex h-12 items-center justify-center gap-2.5 bg-white px-7 text-sm font-semibold text-neutral-950 transition-all duration-300 hover:bg-amber-400 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            <span>{lang === 'en' ? 'View Products' : 'Lihat Produk'}</span>
            <span class="font-mono transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          <a
            href="#kontak"
            class="inline-flex h-12 items-center justify-center border border-white/30 px-7 text-sm font-semibold text-white transition-all duration-300 hover:border-white hover:bg-white/10 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            {lang === 'en' ? 'Technical Consultation' : 'Konsultasi Teknis'}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!--  02. TENTANG KAMI: Solusi Mesin CNC untuk Masa Depan Industri  -->
  <section
    id="tentang"
    class="px-6 py-24 sm:px-8 lg:px-12 lg:py-32 bg-[#f6f3ee]"
  >
    <div class="mx-auto max-w-7xl">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!--  Left Column  -->
        <div class="lg:col-span-5">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 block">
            {lang === 'en' ? 'ABOUT US' : 'TENTANG KAMI'}
          </span>
          <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-neutral-950 leading-[1.1]">
            {lang === 'en' ? 'Precision CNC Solutions for Industrial Future' : 'Solusi Mesin CNC untuk Masa Depan Industri'}
          </h2>
          <p class="mt-5 text-sm sm:text-base leading-relaxed text-neutral-600">
            {lang === 'en'
              ? "We supply CNC machinery, precision tooling, and expert after-sales engineering to help your facility elevate productivity, accuracy, and operational efficiency."
              : "Kami menyediakan mesin CNC, peralatan presisi, dan layanan purna jual terbaik untuk membantu industri Anda meningkatkan produktivitas, akurasi, dan efisiensi produksi."}
          </p>
          <a
            href="#kontak"
            class="mt-8 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-950 hover:text-amber-600 transition-colors cursor-pointer"
          >
            <span>{lang === 'en' ? 'Learn more' : 'Pelajari lebih lanjut'}</span>
            <span class="font-mono">→</span>
          </a>
        </div>

        <!--  Right Column: 2x2 Feature Grid with Amber Icons  -->
        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6">
          <div class="bg-white p-7 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
            <div>
              <svg class="size-7 text-amber-500 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/>
              </svg>
              <h3 class="text-base font-semibold text-neutral-950">
                {lang === 'en' ? 'High Precision' : 'Presisi Tinggi'}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">
                {lang === 'en' ? 'Maximum accuracy for the highest manufacturing yield.' : 'Akurasi maksimal untuk hasil produksi terbaik.'}
              </p>
            </div>
          </div>

          <div class="bg-white p-7 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
            <div>
              <svg class="size-7 text-amber-500 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              <h3 class="text-base font-semibold text-neutral-950">
                {lang === 'en' ? 'Latest Technology' : 'Teknologi Terkini'}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">
                {lang === 'en' ? 'Delivering CNC machinery from world-class global builders.' : 'Menghadirkan mesin CNC dari brand ternama dunia.'}
              </p>
            </div>
          </div>

          <div class="bg-white p-7 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
            <div>
              <svg class="size-7 text-amber-500 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <h3 class="text-base font-semibold text-neutral-950">
                {lang === 'en' ? 'Full Support' : 'Dukungan Penuh'}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">
                {lang === 'en' ? 'Professional engineering team ready to assist on-site.' : 'Tim teknisi profesional siap membantu kapan saja.'}
              </p>
            </div>
          </div>

          <div class="bg-white p-7 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
            <div>
              <svg class="size-7 text-amber-500 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
              </svg>
              <h3 class="text-base font-semibold text-neutral-950">
                {lang === 'en' ? 'Production Efficiency' : 'Efisiensi Produksi'}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">
                {lang === 'en' ? 'Targeted solutions to minimize manufacturing cycle times.' : 'Solusi tepat untuk menekan biaya dan waktu produksi.'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--  03. PRODUK UNGGULAN (4-Column Grid matching reference mockup)  -->
  <section
    id="produk"
    class="px-6 py-24 sm:px-8 lg:px-12 lg:py-32 bg-[#f6f3ee]"
  >
    <div class="mx-auto max-w-7xl">
      <!--  Header  -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-12">
        <div>
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 block">
            {lang === 'en' ? 'CNC MACHINERY' : 'MESIN CNC'}
          </span>
          <h2 class="mt-2 text-3xl sm:text-5xl font-semibold tracking-tight text-neutral-950">
            {lang === 'en' ? 'Featured Products' : 'Produk Unggulan'}
          </h2>
        </div>
        <a
          href="#kontak"
          class="font-mono text-xs uppercase tracking-wider text-neutral-700 hover:text-black transition-colors flex items-center gap-1.5 cursor-pointer"
        >
          <span>{lang === 'en' ? 'View All Products' : 'Lihat Semua Produk'}</span>
          <span class="font-mono">→</span>
        </a>
      </div>

      <!--  4 Product Cards Grid  -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!--  Card 1: VF-2SS  -->
        <article class="bg-white p-5 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
          <div>
            <div class="aspect-4/3 overflow-hidden bg-neutral-100 mb-4 flex items-center justify-center">
              <img
                src="/templates/adiguna/landing/v2/product-vmc.jpg"
                alt="VF-2SS Machining Center"
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-400 font-semibold block">HAAS</span>
            <h3 class="mt-1 font-semibold text-lg text-neutral-950">VF-2SS</h3>
            <p class="mt-2 text-xs leading-relaxed text-neutral-600">
              {lang === 'en'
                ? "Vertical Machining Center with high cutting performance and outstanding precision."
                : "Vertical Machining Center dengan performa tinggi dan presisi luar biasa."}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-neutral-100">
            <a
              href="#kontak"
              class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-950 hover:text-amber-600 transition-colors cursor-pointer"
            >
              <span>{lang === 'en' ? 'Product Details' : 'Detail Produk'}</span>
              <span class="font-mono">→</span>
            </a>
          </div>
        </article>

        <!--  Card 2: NLX 2500  -->
        <article class="bg-white p-5 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
          <div>
            <div class="aspect-4/3 overflow-hidden bg-neutral-100 mb-4 flex items-center justify-center">
              <img
                src="/templates/adiguna/landing/v2/product-lathe.jpg"
                alt="NLX 2500 Lathe"
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-400 font-semibold block">DMG MORI</span>
            <h3 class="mt-1 font-semibold text-lg text-neutral-950">NLX 2500</h3>
            <p class="mt-2 text-xs leading-relaxed text-neutral-600">
              {lang === 'en'
                ? "CNC Turning Lathe with high rigidity and high turning efficiency."
                : "Mesin bubut CNC dengan teknologi canggih dan efisiensi tinggi."}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-neutral-100">
            <a
              href="#kontak"
              class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-950 hover:text-amber-600 transition-colors cursor-pointer"
            >
              <span>{lang === 'en' ? 'Product Details' : 'Detail Produk'}</span>
              <span class="font-mono">→</span>
            </a>
          </div>
        </article>

        <!--  Card 3: MB-56VA  -->
        <article class="bg-white p-5 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
          <div>
            <div class="aspect-4/3 overflow-hidden bg-neutral-100 mb-4 flex items-center justify-center">
              <img
                src="/templates/adiguna/landing/v2/product-edm.jpg"
                alt="MB-56VA Machining Center"
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-400 font-semibold block">OKUMA</span>
            <h3 class="mt-1 font-semibold text-lg text-neutral-950">MB-56VA</h3>
            <p class="mt-2 text-xs leading-relaxed text-neutral-600">
              {lang === 'en'
                ? "5-Axis Machining Center engineered for high mold complexity."
                : "5-Axis Machining Center untuk kompleksitas cetakan tinggi."}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-neutral-100">
            <a
              href="#kontak"
              class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-950 hover:text-amber-600 transition-colors cursor-pointer"
            >
              <span>{lang === 'en' ? 'Product Details' : 'Detail Produk'}</span>
              <span class="font-mono">→</span>
            </a>
          </div>
        </article>

        <!--  Card 4: ST-20  -->
        <article class="bg-white p-5 shadow-xs border border-neutral-200/60 flex flex-col justify-between">
          <div>
            <div class="aspect-4/3 overflow-hidden bg-neutral-100 mb-4 flex items-center justify-center p-2">
              <img
                src="/templates/adiguna/landing/v2/product-st20.png"
                alt="ST-20 Turning Center"
                class="w-full h-full object-contain object-center"
                loading="lazy"
              />
            </div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-400 font-semibold block">HAAS AUTOMATION</span>
            <h3 class="mt-1 font-semibold text-lg text-neutral-950">ST-20</h3>
            <p class="mt-2 text-xs leading-relaxed text-neutral-600">
              {lang === 'en'
                ? "Precision turning center designed for mass shaft component production."
                : "Mesin bubut presisi tinggi untuk produksi massal komponen industri."}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-neutral-100">
            <a
              href="#kontak"
              class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-950 hover:text-amber-600 transition-colors cursor-pointer"
            >
              <span>{lang === 'en' ? 'Product Details' : 'Detail Produk'}</span>
              <span class="font-mono">→</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!--  04. PROSES KERJA: Dari Konsultasi hingga Instalasi, Kami Mendampingi  -->
  <section
    id="proses"
    class="px-6 py-24 sm:px-8 lg:px-12 lg:py-32 bg-[#f6f3ee]"
  >
    <div class="mx-auto max-w-7xl">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!--  Left Column: Macro Machining Action Photo  -->
        <div class="lg:col-span-6">
          <div class="aspect-4/3 sm:aspect-16/10 overflow-hidden shadow-sm border border-neutral-200/60 bg-neutral-100">
            <img
              src="/templates/adiguna/landing/v2/process-action.jpg"
              alt="CNC Milling Spindle Machining Action"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
        </div>

        <!--  Right Column: 4 Numbered Steps  -->
        <div class="lg:col-span-6">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 block">
            {lang === 'en' ? 'WORK PROCESS' : 'PROSES KERJA'}
          </span>
          <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-neutral-950 leading-[1.1]">
            {lang === 'en' ? 'From Consultation to Installation, We Support You' : 'Dari Konsultasi hingga Instalasi, Kami Mendampingi'}
          </h2>
          <p class="mt-4 text-sm sm:text-base leading-relaxed text-neutral-600 mb-8">
            {lang === 'en'
              ? "We ensure every step proceeds smoothly, from machine selection and commissioning to operator qualification."
              : "Kami memastikan setiap tahap berjalan lancar, mulai dari pemilihan mesin, instalasi, hingga pelatihan operator."}
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <span class="size-8 rounded-full bg-amber-400 text-neutral-950 font-mono text-xs font-bold flex items-center justify-center shrink-0">
                01
              </span>
              <div>
