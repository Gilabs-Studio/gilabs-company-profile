  <script>
    const testimonials = [
      {
        quote: "“Sejak menggunakan mesin CNC dari sini, produktivitas kami meningkat signifikan. Tim mereka juga sangat responsif dan profesional dalam memberikan dukungan teknis.”",
        author: "Andi Pratama",
        company: "PT Maju Bersama Manufacturing"
      },
      {
        quote: "“Akurasi berulang pada mesin ini memungkinkan bengkel kami menjaga toleransi ketat komponen presisi tanpa kendala selama proses produksi massal.”",
        author: "Hendra Wicaksono",
        company: "PT Dirgantara Presisi Nusantara"
      },
      {
        quote: "“Dukungan teknisi lokal dan ketersediaan komponen suku cadang siap kirim memangkas risiko downtime lini produksi kami hingga 70%.”",
        author: "Marcus Vance",
        company: "Apex Powertrain Systems"
      }
    ];

    let currentIndex = 0;
    const quoteEl = document.getElementById('testi-quote');
    const authorEl = document.getElementById('testi-author');
    const companyEl = document.getElementById('testi-company');
    const prevBtn = document.getElementById('prev-testi');
    const nextBtn = document.getElementById('next-testi');

    function updateTestimonial(index: number) {
      if (quoteEl && authorEl && companyEl) {
        quoteEl.textContent = testimonials[index].quote;
        authorEl.textContent = testimonials[index].author;
        companyEl.textContent = testimonials[index].company;
      }
    }

    prevBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + testimonials.length) % testimonials.length;
      updateTestimonial(currentIndex);
    });

    nextBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % testimonials.length;
      updateTestimonial(currentIndex);
    });
  </script>

