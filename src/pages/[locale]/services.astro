---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import ServicesHeroMinimal from '../../components/services/ServicesHeroMinimal.astro';
import ServicesCardsCatalog from '../../components/services/ServicesCardsCatalog.astro';
import ServicesCtaMinimal from '../../components/services/ServicesCtaMinimal.astro';
import { serviceSlugPairMap } from '../../data/services/index';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale as 'en' | 'id';

const siteUrl = 'https://gilabs.id';
const canonical = locale === 'en' ? `${siteUrl}/en/services` : `${siteUrl}/${locale}/services`;
const pageTitle = locale === 'en'
  ? `Gilabs Services | Robust Software for Your Business Scale`
  : `Layanan Gilabs | Software Tangguh untuk Skala Bisnis Anda`;
const pageDescription = locale === 'id'
  ? 'Direktori lengkap layanan software house dan rekayasa web Gilabs: website bespoke, corporate, klinik, kontraktor, UMKM, toko online, mobile apps, ERP & CRM kustom, serta sistem informasi manajemen.'
  : 'Comprehensive directory of Gilabs software engineering and bespoke web services: corporate web, healthcare, property, SME, e-commerce, mobile apps, ERP & CRM, and management information systems.';

// Services ItemList Schema
const serviceListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": locale === 'id' ? "Layanan Gilabs Software House & Web Development" : "Gilabs Software House & Web Development Services",
  "description": pageDescription,
  "url": canonical,
  "numberOfItems": 14,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Website Premium Custom" : "Premium Bespoke Website Development",
        "url": `${siteUrl}/${locale}/website-premium`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Website Corporate & Holding" : "Corporate & Enterprise Website Development",
        "url": `${siteUrl}/${locale}/website-corporate`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Website Klinik & Rumah Sakit" : "Clinics & Hospitals Healthcare Website",
        "url": `${siteUrl}/${locale}/website-klinik`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 4,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Website Kontraktor & Properti" : "Contractor & Real Estate Website",
        "url": `${siteUrl}/${locale}/website-kontraktor-properti`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 5,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Website UMKM" : "Affordable SME Business Website",
        "url": `${siteUrl}/${locale}/website-umkm`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 6,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Website Toko Online" : "Independent E-Commerce Web Store",
        "url": `${siteUrl}/${locale}/website-toko-online`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 7,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Software House untuk UMKM & Startup" : "Software House for Startups & SMEs",
        "url": `${siteUrl}/${locale}/software-house`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 8,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Aplikasi Mobile Perusahaan" : "Enterprise Mobile App Development",
        "url": `${siteUrl}/${locale}/aplikasi-custom`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 9,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Sistem Informasi Manajemen" : "Management Information System (MIS) Development",
        "url": `${siteUrl}/${locale}/sistem-informasi`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 10,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Sistem ERP & CRM Custom" : "Custom ERP & CRM System Development",
        "url": `${siteUrl}/${locale}/services/${serviceSlugPairMap["erp-crm"][locale]}`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 11,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Aplikasi Kasir POS Multi-Cabang" : "Multi-Outlet POS / Cashier System Development",
        "url": `${siteUrl}/${locale}/services/${serviceSlugPairMap["pos-system"][locale]}`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 12,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Custom Software Engineering" : "Custom Software Development",
        "url": `${siteUrl}/${locale}/services/${serviceSlugPairMap["custom-software"][locale]}`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 13,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Website Kustom" : "Custom Web Development",
        "url": `${siteUrl}/${locale}/services/${serviceSlugPairMap["web-development"][locale]}`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 14,
      "item": {
        "@type": "Service",
        "name": locale === 'id' ? "Jasa Pembuatan Web Company Profile" : "Company Profile Website Development",
        "url": `${siteUrl}/${locale}/services/${serviceSlugPairMap["company-profile"][locale]}`,
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    }
  ]
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": locale === 'id' ? "Layanan" : "Services",
      "item": canonical
    }
  ]
};
---

<Layout 
  lang={lang} 
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={locale === 'id' 
    ? 'layanan software house Indonesia, jasa pembuatan ERP custom, jasa pembuatan CRM custom, jasa pembuatan POS perusahaan, jasa pembuatan HRIS Indonesia, jasa pembuatan finance system perusahaan, pengembangan dashboard operasional, pengembangan workflow approval system, web development Indonesia, mobile app development, AI integration, custom software development, jasa pembuatan aplikasi perusahaan, sistem internal perusahaan'
    : 'software house services Indonesia, custom ERP development services, custom CRM development services, POS system development, HRIS development, finance system development, operational dashboard development, workflow approval system development, web development services Indonesia, mobile app development services, AI integration services, custom enterprise software development'}
>
  <!-- Service List + Breadcrumb Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceListSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  
  <Navbar lang={lang} />
  
  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    <ServicesHeroMinimal lang={lang} />
    <ServicesCardsCatalog lang={lang} />
    <ServicesCtaMinimal lang={lang} />
  </main>
  
  <Footer lang={lang} />
</Layout>
