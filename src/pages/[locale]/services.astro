---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import ServicesHero from '../../components/services/ServicesHero.astro';
import ServicesGrid from '../../components/services/ServicesGrid.astro';
import ServicesPackages from '../../components/services/ServicesPackages.astro';
import ServicesErpCrm from '../../components/services/ServicesErpCrm.astro';
import ServicesAiAddons from '../../components/services/ServicesAiAddons.astro';
import ServicesCta from '../../components/services/ServicesCta.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale as 'en' | 'id';

const siteUrl = 'https://gilabs.id';
const canonical = locale === 'en' ? `${siteUrl}/en/services` : `${siteUrl}/${locale}/services`;
const pageTitle = locale === 'en'
  ? `Gilabs Services | ERP, CRM, HRIS, Finance & Internal Systems Development`
  : `Layanan Gilabs | ERP, CRM, HRIS, Finance & Pengembangan Sistem Internal`;
const pageDescription = locale === 'id'
  ? 'Gilabs by PT Griya Innovations Labs menyediakan jasa pengembangan ERP, CRM, POS, HRIS, finance system, dashboard operasional, workflow approval, web app, mobile app, dan custom software untuk perusahaan di Indonesia.'
  : 'Gilabs by PT Griya Innovations Labs provides ERP, CRM, POS, HRIS, finance system, operational dashboard, workflow approval, web app, mobile app, and custom software development services for companies in Indonesia.';

// Services ItemList Schema
const serviceListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": locale === 'id' ? "Layanan Gilabs Software House" : "Gilabs Software House Services",
  "description": pageDescription,
  "url": canonical,
  "numberOfItems": 8,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Service",
        "name": "ERP System Development",
        "description": locale === 'id'
          ? "Pengembangan sistem ERP kustom untuk manufaktur, distribusi, dan retail"
          : "Custom ERP system development for manufacturing, distribution, and retail",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "Service",
        "name": "CRM System Development",
        "description": locale === 'id'
          ? "Platform CRM enterprise untuk manajemen sales pipeline, lead, dan pelanggan"
          : "Enterprise CRM platform for sales pipeline, lead, and customer management",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Service",
        "name": "POS System Development",
        "description": locale === 'id'
          ? "Sistem kasir dan penjualan untuk retail, F&B, dan multi-outlet"
          : "Point of Sale system for retail, F&B, and multi-outlet businesses",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 4,
      "item": {
        "@type": "Service",
        "name": "HRIS Development",
        "description": locale === 'id'
          ? "Sistem HR digital untuk absensi, payroll, rekrutmen, dan manajemen kinerja"
          : "Digital HR system for attendance, payroll, recruitment, and performance management",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 5,
      "item": {
        "@type": "Service",
        "name": "Finance System Development",
        "description": locale === 'id'
          ? "Sistem keuangan perusahaan: akuntansi, invoicing, laporan keuangan"
          : "Company finance systems: accounting, invoicing, financial reporting",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 6,
      "item": {
        "@type": "Service",
        "name": "Web Development",
        "description": locale === 'id'
          ? "Pengembangan website dan web application dengan Next.js, React, TypeScript"
          : "Website and web application development with Next.js, React, TypeScript",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 7,
      "item": {
        "@type": "Service",
        "name": "Mobile App Development",
        "description": locale === 'id'
          ? "Pengembangan aplikasi mobile iOS dan Android dengan Flutter"
          : "iOS and Android mobile app development with Flutter",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    },
    {
      "@type": "ListItem",
      "position": 8,
      "item": {
        "@type": "Service",
        "name": "AI Integration",
        "description": locale === 'id'
          ? "Integrasi AI/LLM ke dalam sistem bisnis untuk chatbot, analitik, dan otomasi"
          : "AI/LLM integration into business systems for chatbots, analytics, and automation",
        "provider": { "@id": "https://gilabs.id/#organization" }
      }
    }
  ]
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": locale === 'id' ? "Layanan" : "Services",
      "item": canonical
    }
  ]
};
---

<Layout 
  lang={lang} 
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={locale === 'id' 
    ? 'layanan software house Indonesia, jasa pembuatan ERP custom, jasa pembuatan CRM custom, jasa pembuatan POS perusahaan, jasa pembuatan HRIS Indonesia, jasa pembuatan finance system perusahaan, pengembangan dashboard operasional, pengembangan workflow approval system, web development Indonesia, mobile app development, AI integration, custom software development, jasa pembuatan aplikasi perusahaan, sistem internal perusahaan'
    : 'software house services Indonesia, custom ERP development services, custom CRM development services, POS system development, HRIS development, finance system development, operational dashboard development, workflow approval system development, web development services Indonesia, mobile app development services, AI integration services, custom enterprise software development'}
>
  <!-- Service List + Breadcrumb Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceListSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  
  <Navbar lang={lang} />
  
  <main class="min-h-screen bg-background">
    <ServicesHero lang={lang} />
    <ServicesGrid lang={lang} />
    <ServicesPackages lang={lang} />
    <ServicesErpCrm lang={lang} />
    <ServicesAiAddons lang={lang} />
    <ServicesCta lang={lang} />
  </main>
  
  <Footer lang={lang} />
</Layout>
