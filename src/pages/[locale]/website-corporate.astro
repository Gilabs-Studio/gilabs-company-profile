---
import SeoLandingPage from "../../components/seo-landing/SeoLandingPage.astro";
import { websiteCorporateId, websiteCorporateEn } from "../../data/seoLanding/websiteCorporate";

export function getStaticPaths() {
  return [
    { params: { locale: "id" } },
    { params: { locale: "en" } },
  ];
}

const { locale } = Astro.params;
const lang = (locale as "en" | "id") || "id";
const data = lang === "en" ? websiteCorporateEn : websiteCorporateId;
---

<SeoLandingPage data={data} lang={lang} />
