---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/sections/Hero.astro';
import Features from '../../components/sections/Features.astro';
import Portfolio from '../../components/sections/Portfolio.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Process from '../../components/sections/Process.astro';
import FAQ from '../../components/sections/FAQ.astro';
import Offer from '../../components/sections/Offer.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../../components/ui/WorkResultDrawer';
import Footer from '../../components/sections/Footer.astro';
import MobileMenu from '../../components/MobileMenu.astro';

export function getStaticPaths() {
  return [
    {params: {locale: 'en'}},
    {params: {locale: 'id'}},
  ];
}

const { locale } = Astro.params;
const siteUrl = 'https://gilabs.id';
const canonical = locale === 'en' ? `${siteUrl}/en` : `${siteUrl}/${locale}`;
const description = locale === 'id' 
	? 'Gilabs by PT Griya Innovations Labs adalah software house Indonesia yang fokus pada pengembangan sistem internal kompleks: ERP, CRM, POS, HRIS, finance system, dashboard operasional, workflow approval, dan custom software enterprise.'
	: 'Gilabs by PT Griya Innovations Labs is an Indonesia software house focused on complex internal systems: ERP, CRM, POS, HRIS, finance systems, operational dashboards, workflow approvals, and custom enterprise software.';
const title = locale === 'id'
	? 'Gilabs | PT Griya Innovations Labs - Software House Sistem Internal Kompleks'
	: 'Gilabs | PT Griya Innovations Labs - Complex Internal Systems Software House';
const keywords = locale === 'id'
	? 'Gilabs, PT Griya Innovations Labs, software house Indonesia, software house Semarang, jasa pengembangan sistem internal perusahaan, jasa pembuatan ERP custom Indonesia, jasa pembuatan CRM perusahaan, jasa pembuatan POS custom, jasa pembuatan HRIS Indonesia, jasa pembuatan finance system, pengembangan dashboard operasional, pengembangan workflow approval system, custom software enterprise Indonesia, vendor sistem internal kompleks'
	: 'Gilabs, PT Griya Innovations Labs, Indonesia software house, Semarang software house, complex internal systems development, custom ERP development Indonesia, custom CRM development company, HRIS software development, finance system development, operational dashboard development, workflow approval system development, enterprise software vendor Indonesia';

// FAQ Schema for homepage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apakah Gilabs adalah PT Griya Innovations Labs?" : "Is Gilabs the same as PT Griya Innovations Labs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Ya. Gilabs adalah brand publik dari PT Griya Innovations Labs, software house Indonesia yang fokus pada pengembangan sistem internal kompleks untuk perusahaan."
          : "Yes. Gilabs is the public brand of PT Griya Innovations Labs, an Indonesia software house focused on developing complex internal systems for companies."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apa itu software house?" : "What is a software house?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Software house adalah perusahaan yang spesialis dalam pengembangan software kustom sesuai kebutuhan bisnis. Berbeda dengan produk SaaS, software house membangun sistem yang benar-benar disesuaikan dengan alur kerja dan proses bisnis Anda."
          : "A software house is a company specializing in custom software development tailored to business needs. Unlike SaaS products, a software house builds systems truly adapted to your workflow and business processes."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apa saja layanan Gilabs?" : "What services does Gilabs offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs menyediakan layanan: pembuatan ERP, CRM, POS, HRIS, finance system, dashboard operasional, workflow approval system, web development, mobile app development, UI/UX design, dan integrasi AI."
          : "Gilabs offers: ERP development, CRM development, POS systems, HRIS, finance systems, operational dashboards, workflow approval systems, web development, mobile app development, UI/UX design, and AI integration."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Berapa lama waktu pengembangan software?" : "How long does software development take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Tergantung kompleksitas: Landing page/website 2-4 minggu, modul CRM atau HRIS tunggal 6-12 minggu, sistem ERP lengkap 3-6 bulan. Kami bekerja secara agile dengan update berkala."
          : "It depends on complexity: Landing pages/websites 2-4 weeks, single CRM or HRIS module 6-12 weeks, full ERP system 3-6 months. We work agile with regular updates."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apakah Gilabs melayani seluruh Indonesia?" : "Does Gilabs serve all of Indonesia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Ya, Gilabs melayani seluruh Indonesia secara remote. Meskipun tim kami berbasis di Semarang, Jawa Tengah, kami bekerja dengan klien dari berbagai kota seperti Jakarta, Surabaya, Bali, Medan, dan lainnya."
          : "Yes, Gilabs serves all of Indonesia remotely. Although our team is based in Semarang, Central Java, we work with clients from various cities including Jakarta, Surabaya, Bali, Medan, and others."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Teknologi apa yang digunakan Gilabs?" : "What technologies does Gilabs use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs menggunakan stack modern: Next.js 16 dan React untuk frontend, Go (Golang) dan Node.js untuk backend, PostgreSQL untuk database, Flutter untuk mobile app, TypeScript, Tailwind CSS, dan integrasi AI (Cerebras, OpenAI)."
          : "Gilabs uses a modern stack: Next.js 16 and React for frontend, Go (Golang) and Node.js for backend, PostgreSQL for database, Flutter for mobile apps, TypeScript, Tailwind CSS, and AI integration (Cerebras, OpenAI)."
      }
    }
  ]
};
---

<Layout 
	lang={locale} 
	title={title}
	description={description}
	canonical={canonical}
	keywords={keywords}
	ogImage="https://gilabs.id/og-image.png"
>
  <!-- FAQ Schema for homepage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  
  <Navbar lang={locale} />
  
  <!-- Work Result Drawer Component -->
  <WorkResultDrawer client:load lang={locale} />
  
  <main>
    {/* 1. Hero */}
    <Hero lang={locale} />
    
    {/* 2. Showcase - Projects First */}
    <Showcase lang={locale} />

    {/* 3. Portfolio */}
    <Portfolio lang={locale} />

    {/* 4. Services */}
    <Offer lang={locale} />

    {/* 5. Process */}
    <Process lang={locale} />

    {/* 6. FAQ */}
    <FAQ lang={locale} />

    {/* 8. Trust & Final CTA */}
    <FinalCTA lang={locale} />
  </main>
  <Footer lang={locale} />
</Layout>
