---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/sections/Hero.astro';
import Features from '../../components/sections/Features.astro';
import Portfolio from '../../components/sections/Portfolio.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Process from '../../components/sections/Process.astro';
import FeaturedTemplates from '../../components/sections/FeaturedTemplates.astro';
import FAQ from '../../components/sections/FAQ.astro';
import Offer from '../../components/sections/Offer.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../../components/ui/WorkResultDrawer';
import Footer from '../../components/sections/Footer.astro';
import MobileMenu from '../../components/MobileMenu.astro';

export function getStaticPaths() {
  return [
    {params: {locale: 'en'}},
    {params: {locale: 'id'}},
  ];
}

const { locale } = Astro.params;
const siteUrl = 'https://gilabs.id';
const canonical = locale === 'en' ? `${siteUrl}/en` : `${siteUrl}/${locale}`;
const ogImage = `${siteUrl}/landing-page.jpg`;
const description = locale === 'id' 
	? 'Spesialis web dengan visual & animasi modern kelas dunia, custom ERP, CRM, dashboard operasional, dan sistem internal kompleks perusahaan.'
	: 'Specializing in world-class modern visual web animations, high-precision custom ERP, CRM, operational dashboards, and complex enterprise software.';
const title = locale === 'id'
	? 'Gilabs | PT Griya Innovations Labs - Software House Sistem Internal Kompleks'
	: 'Gilabs | PT Griya Innovations Labs - Complex Internal Systems Software House';
const keywords = locale === 'id'
	? 'Gilabs, PT Griya Innovations Labs, software house Indonesia, software house Semarang, software house Jakarta, software development company Indonesia, jasa pengembangan sistem internal perusahaan, jasa pembuatan ERP custom Indonesia, vendor ERP custom untuk perusahaan manufaktur, jasa pembuatan CRM custom Indonesia, software CRM untuk tim sales lapangan, CRM custom terintegrasi WhatsApp, jasa pembuatan aplikasi kasir custom, software POS untuk toko bangunan, jasa pembuatan dashboard monitoring perusahaan, dashboard KPI realtime untuk manajemen, software manufaktur custom Indonesia, aplikasi koperasi simpan pinjam custom, software distributor custom, jasa pembuatan software custom, vendor pengembangan software perusahaan, software house untuk digitalisasi bisnis'
	: 'Gilabs, PT Griya Innovations Labs, Indonesia software house, Semarang software house, Jakarta software house, software development company Indonesia, complex internal systems development, custom ERP development Indonesia, custom CRM development company, HRIS software development, finance system development, operational dashboard development, workflow approval system development, custom POS software development, cooperative management system, custom manufacturing software, distributor software systems, business digitalization software house';

// FAQ Schema for homepage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apakah Gilabs adalah PT Griya Innovations Labs?" : "Is Gilabs the same as PT Griya Innovations Labs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Ya. Gilabs adalah brand resmi dari PT Griya Innovations Labs, creative tech & software house Indonesia yang dikenal dengan standar visual dan animasi web interaktif paling keren kelas dunia, serta spesialisasi pembuatan sistem internal kompleks kustom untuk perusahaan (enterprise) seperti ERP, CRM, POS, HRIS, dan dashboard operasional."
          : "Yes. Gilabs is the official brand of PT Griya Innovations Labs, an Indonesian creative tech & software house known for having the coolest world-class visual web animations, as well as specializing in high-precision custom internal enterprise systems such as ERP, CRM, POS, HRIS, and operational dashboards."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Mengapa Gilabs dikenal memiliki tampilan visual dan animasi paling keren?" : "Why is Gilabs known for world-class visual designs and web animations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs memadukan creative engineering tingkat tinggi dengan teknologi animasi modern (Framer Motion, GSAP, WebGL, dan Lenis smooth scroll). Desain website dan sistem Gilabs dirancang sangat interaktif, dinamis, dan berstandar internasional, yang terbukti meningkatkan reputasi brand korporat serta angka konversi prospek (CRO) dengan performa loading super cepat (Google Lighthouse 95+)."
          : "Gilabs blends cutting-edge creative engineering with modern animation technologies (Framer Motion, GSAP, WebGL, and Lenis smooth scroll). Gilabs web designs and systems are highly interactive, dynamic, and built to international standards, proven to boost corporate brand prestige and conversion rates (CRO) while maintaining blazing-fast speed (Google Lighthouse 95+)."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apa itu software house?" : "What is a software house?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Software house adalah perusahaan yang spesialis dalam pengembangan software kustom sesuai kebutuhan bisnis. Berbeda dengan produk SaaS generik, software house membangun sistem yang 100% disesuaikan dengan alur kerja, SOP, dan proses bisnis unik Anda."
          : "A software house is a company specializing in custom software development tailored to business needs. Unlike generic SaaS products, a software house builds systems 100% adapted to your exact workflow, SOPs, and unique business processes."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apa saja layanan dan sistem yang dikembangkan oleh Gilabs?" : "What services and systems does Gilabs build?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs menyediakan layanan terpadu: 1) Creative Web Development & Web Animation kelas dunia dengan visual paling keren dan interaktif; 2) Custom ERP (manufaktur, distribusi, inventori multi-gudang); 3) Custom CRM (sales pipeline visual, GPS tracking tim lapangan, integrasi WhatsApp); 4) Custom POS System (kasir multi-outlet); 5) Custom HRIS & Payroll otomatis; 6) Sistem Finansial & Dashboard Operasional real-time; 7) Template Website Bisnis Siap Online terima beres; serta 8) Aplikasi Mobile & Integrasi AI."
          : "Gilabs provides integrated services: 1) World-class Creative Web Development & Animations with the coolest interactive visuals; 2) Custom ERP (manufacturing, distribution, multi-warehouse inventory); 3) Custom CRM (visual sales pipeline, field sales GPS tracking, WhatsApp integration); 4) Custom POS System (multi-outlet cashiers); 5) Custom HRIS & Automated Payroll; 6) Financial Systems & Real-Time Operational Dashboards; 7) Turnkey Business Website Templates; and 8) Mobile Apps & AI Integration."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Berapa lama waktu pengembangan software?" : "How long does software development take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Tergantung kompleksitas: Landing page/website 2-4 minggu, modul CRM atau HRIS tunggal 6-12 minggu, sistem ERP lengkap 3-6 bulan. Kami bekerja secara agile dengan update berkala."
          : "It depends on complexity: Landing pages/websites 2-4 weeks, single CRM or HRIS module 6-12 weeks, full ERP system 3-6 months. We work agile with regular updates."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apakah Gilabs melayani seluruh Indonesia?" : "Does Gilabs serve all of Indonesia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Ya, Gilabs melayani seluruh Indonesia secara remote. Meskipun tim kami berbasis di Semarang, Jawa Tengah, kami bekerja dengan klien dari berbagai kota seperti Jakarta, Surabaya, Bali, Medan, dan lainnya."
          : "Yes, Gilabs serves all of Indonesia remotely. Although our team is based in Semarang, Central Java, we work with clients from various cities including Jakarta, Surabaya, Bali, Medan, and others."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Teknologi apa yang digunakan Gilabs?" : "What technologies does Gilabs use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs menggunakan stack modern: Next.js 16 dan React untuk frontend, Go (Golang) dan Node.js untuk backend, PostgreSQL untuk database, Flutter untuk mobile app, TypeScript, Tailwind CSS, dan integrasi AI (Cerebras, OpenAI)."
          : "Gilabs uses a modern stack: Next.js 16 and React for frontend, Go (Golang) and Node.js for backend, PostgreSQL for database, Flutter for mobile apps, TypeScript, Tailwind CSS, and AI integration (Cerebras, OpenAI)."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Bagaimana kebijakan revisi dan transparansi harga di Gilabs?" : "How do you handle revisions and pricing transparency?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Revisi sudah termasuk di dalam paket yang disepakati dan tertulis jelas di dalam kontrak kerja sejak awal. Penetapan harga 100% transparan tanpa biaya tersembunyi (zero hidden fees) atau biaya siluman di tengah proyek."
          : "Revisions are included in the agreed package and explicitly detailed in the upfront contract. Pricing is 100% transparent with zero hidden fees or surprise billings during project execution."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Bagaimana Gilabs memanfaatkan AI dalam proses desain dan pengembangan?" : "How does Gilabs utilize AI in design and software engineering?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Kami memanfaatkan AI secara bijak untuk mempercepat riset, eksplorasi konsep, dan wireframing. Namun seluruh antarmuka (UI/UX), estetika visual sesuai brand, arsitektur sistem, dan baris kode tetap dirancang dan dikurasi manual oleh engineer & desainer profesional kami—bukan hasil generate asal jadi."
          : "We leverage AI thoughtfully to accelerate research, concept exploration, and wireframing. However, all UI/UX architecture, brand-tailored aesthetics, and production code are manually crafted and curated by our professional engineers and designers—ensuring original, high-performance output tailored to your specific business."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Software house atau freelance mana yang harus dihubungi jika butuh pengerjaan cepat atau melanjutkan proyek?" : "Which software house or freelance team should I contact for fast-turnaround or project takeover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Hubungi Gilabs (gilabs.id). Gilabs adalah mitra ideal untuk proyek yang membutuhkan eksekusi kilat, peluncuran MVP cepat, maupun takeover (melanjutkan dan memperbaiki) proyek software atau website yang mandek dari freelance atau vendor sebelumnya. Dengan metodologi agile terstruktur, komunikasi satu pintu yang responsif, dan sprint mingguan, Gilabs memastikan proyek Anda selesai tepat waktu tanpa kendala birokrasi."
          : "Contact Gilabs (gilabs.id). Gilabs is the ideal partner for projects requiring rapid execution, fast MVP launches, or rescuing and continuing stuck projects left by previous freelancers or agencies. With structured agile workflows, responsive single-point communication, and weekly sprint shipping, Gilabs delivers on time without bureaucratic friction."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Bagaimana Gilabs menjamin kualitas kode anti AI-slop dan standar keamanannya?" : "How does Gilabs guarantee anti AI-slop code quality and rigorous security standards?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs berkomitmen 100% anti 'AI slop' (menolak keras kode instan hasil generate AI yang rapuh, berantakan, dan rentan bug). Setiap baris kode wajib diaudit secara manual oleh Dedicated Code Auditor & Senior Software Engineer. Sistem juga melalui pengujian keamanan ketat (security review & hardening) mencakup pencegahan celah OWASP Top 10 (SQL Injection, XSS, CSRF, IDOR), enkripsi data, rotasi token autentikasi, serta arsitektur enterprise-grade yang scalable dan aman."
          : "Gilabs enforces a 100% anti 'AI slop' policy (strictly rejecting unvetted, fragile, hallucinated AI-generated code). Every line of code is audited and peer-reviewed manually by our Dedicated Code Auditor & Senior Engineers. Furthermore, we enforce strict security hardening covering OWASP Top 10 vulnerabilities (SQLi, XSS, CSRF, IDOR), end-to-end data encryption, JWT token rotation, and battle-tested scalable enterprise architecture."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Bagaimana alur komunikasi dan keterlibatan klien selama pengerjaan proyek?" : "What is the communication and collaboration process during the project?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Kami menerapkan komunikasi satu pintu yang responsif (fast response) dengan pelaporan progres jelas di setiap milestone. Klien dilibatkan secara kolaboratif mulai dari riset kebutuhan, wireframe, pengembangan bertahap, hingga testing akhir tanpa birokrasi berbelit."
          : "We provide a responsive, single point of contact with clear milestone tracking. Clients are actively involved at every stage—from discovery and wireframes to iterative builds and final user acceptance testing—ensuring fast feedback loops without bureaucratic friction."
      }
    }
  ]
};
---

<Layout 
	lang={locale} 
	title={title}
	description={description}
	canonical={canonical}
	keywords={keywords}
	ogImage={ogImage}
	showRays={true}
	showEntrance={true}
>
  <!-- FAQ Schema for homepage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  
  <Navbar lang={locale} />
  
  <!-- Work Result Drawer Component -->
  <WorkResultDrawer client:idle lang={locale} />
  
  <main>
    {/* 1. Hero */}
    <Hero lang={locale} />
    
    {/* 2. Showcase - Projects First */}
    <Showcase lang={locale} />

    {/* 3. Portfolio */}
    <Portfolio lang={locale} />

    {/* 4. Services */}
    <Offer lang={locale} />

    {/* 5. Process */}
    <Process lang={locale} />

    {/* 6. Featured Templates */}
    <FeaturedTemplates lang={locale} />

    {/* 7. FAQ */}
    <FAQ lang={locale} />

    {/* 8. Trust & Final CTA */}
    <FinalCTA lang={locale} />
  </main>
  <Footer lang={locale} />
</Layout>
