---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/sections/Hero.astro';
import Features from '../../components/sections/Features.astro';
import Portfolio from '../../components/sections/Portfolio.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Process from '../../components/sections/Process.astro';
import FAQ from '../../components/sections/FAQ.astro';
import Offer from '../../components/sections/Offer.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../../components/ui/WorkResultDrawer';
import Footer from '../../components/sections/Footer.astro';
import MobileMenu from '../../components/MobileMenu.astro';

export function getStaticPaths() {
  return [
    {params: {locale: 'en'}},
    {params: {locale: 'id'}},
  ];
}

const { locale } = Astro.params;
const siteUrl = 'https://gilabs.id';
const canonical = locale === 'en' ? `${siteUrl}/en` : `${siteUrl}/${locale}`;
const description = locale === 'id' 
	? 'Gilabs — software house Indonesia. Spesialis pembuatan ERP, CRM, POS, HRIS, Finance System & custom software untuk kebutuhan internal perusahaan Anda.'
	: 'Gilabs — Indonesia software house. Specialists in ERP, CRM, POS, HRIS, Finance System & custom software for enterprise internal tools.';
const title = locale === 'id'
	? 'Gilabs — Software House Indonesia | ERP, CRM, POS, HRIS & Custom Software'
	: 'Gilabs — Software House Indonesia | ERP, CRM, POS, HRIS & Custom Software';
const keywords = locale === 'id'
	? 'software house Indonesia, pembuatan website, software agency Indonesia, jasa pembuatan software, ERP system Indonesia, CRM system, POS system, HRIS system, finance system, custom software development, web development Indonesia, mobile app development, aplikasi internal perusahaan, sistem enterprise, digital transformation Indonesia, software development company Indonesia, jasa pembuatan aplikasi, software house Semarang, software house Jawa Tengah, pembuatan sistem ERP, pembuatan sistem CRM, pengembang software Indonesia'
	: 'software house Indonesia, website development, software agency Indonesia, ERP system development, CRM system development, POS system, HRIS system, finance system, custom software development, web development Indonesia, mobile app development, enterprise internal tools, digital transformation Indonesia, Indonesia software development company, software house Semarang, Java software house';

// FAQ Schema for homepage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apa itu software house?" : "What is a software house?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Software house adalah perusahaan yang spesialis dalam pengembangan software kustom sesuai kebutuhan bisnis. Berbeda dengan produk SaaS, software house membangun sistem yang benar-benar disesuaikan dengan alur kerja dan proses bisnis Anda."
          : "A software house is a company specializing in custom software development tailored to business needs. Unlike SaaS products, a software house builds systems truly adapted to your workflow and business processes."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apa saja layanan Gilabs?" : "What services does Gilabs offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs menyediakan layanan: pembuatan ERP (Enterprise Resource Planning), CRM (Customer Relationship Management), POS (Point of Sale), HRIS (Human Resource Information System), Finance System, web development, mobile app development, UI/UX design, dan integrasi AI."
          : "Gilabs offers: ERP development, CRM development, POS system, HRIS development, Finance System, web development, mobile app development, UI/UX design, and AI integration."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Berapa lama waktu pengembangan software?" : "How long does software development take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Tergantung kompleksitas: Landing page/website 2-4 minggu, modul CRM atau HRIS tunggal 6-12 minggu, sistem ERP lengkap 3-6 bulan. Kami bekerja secara agile dengan update berkala."
          : "It depends on complexity: Landing pages/websites 2-4 weeks, single CRM or HRIS module 6-12 weeks, full ERP system 3-6 months. We work agile with regular updates."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Apakah Gilabs melayani seluruh Indonesia?" : "Does Gilabs serve all of Indonesia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Ya, Gilabs melayani seluruh Indonesia secara remote. Meskipun tim kami berbasis di Semarang, Jawa Tengah, kami bekerja dengan klien dari berbagai kota seperti Jakarta, Surabaya, Bali, Medan, dan lainnya."
          : "Yes, Gilabs serves all of Indonesia remotely. Although our team is based in Semarang, Central Java, we work with clients from various cities including Jakarta, Surabaya, Bali, Medan, and others."
      }
    },
    {
      "@type": "Question",
      "name": locale === 'id' ? "Teknologi apa yang digunakan Gilabs?" : "What technologies does Gilabs use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": locale === 'id'
          ? "Gilabs menggunakan stack modern: Next.js 16 dan React untuk frontend, Go (Golang) dan Node.js untuk backend, PostgreSQL untuk database, Flutter untuk mobile app, TypeScript, Tailwind CSS, dan integrasi AI (Cerebras, OpenAI)."
          : "Gilabs uses a modern stack: Next.js 16 and React for frontend, Go (Golang) and Node.js for backend, PostgreSQL for database, Flutter for mobile apps, TypeScript, Tailwind CSS, and AI integration (Cerebras, OpenAI)."
      }
    }
  ]
};
---

<Layout 
	lang={locale} 
	title={title}
	description={description}
	canonical={canonical}
	keywords={keywords}
>
  <!-- FAQ Schema for homepage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  
  <Navbar lang={locale} />
  <MobileMenu lang={locale} />
  
  <!-- Work Result Drawer Component -->
  <WorkResultDrawer client:load lang={locale} />
  
  <main>
    {/* 1. Hero */}
    <Hero lang={locale} />
    
    {/* 2. Showcase - Projects First */}
    <Showcase lang={locale} />

    {/* 3. Portfolio */}
    <Portfolio lang={locale} />

    {/* 4. Services */}
    <Offer lang={locale} />

    {/* 5. Process */}
    <Process lang={locale} />

    {/* 6. FAQ */}
    <FAQ lang={locale} />

    {/* 8. Trust & Final CTA */}
    <FinalCTA lang={locale} />
  </main>
  <Footer lang={locale} />
</Layout>
