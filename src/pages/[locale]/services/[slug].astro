---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/sections/Footer.astro";
import LandingHero from "../../../components/landing/LandingHero.astro";
import LandingProblems from "../../../components/landing/LandingProblems.astro";
import LandingFeatures from "../../../components/landing/LandingFeatures.astro";
import LandingPackages from "../../../components/landing/LandingPackages.astro";
import LandingTechStack from "../../../components/landing/LandingTechStack.astro";
import LandingFAQ from "../../../components/landing/LandingFAQ.astro";
import LandingCTA from "../../../components/landing/LandingCTA.astro";
import WebDevPage from "../../../components/services/web-dev/WebDevPage.astro";
import CompanyProfilePage from "../../../components/services/company-profile/CompanyProfilePage.astro";
import LandingPageService from "../../../components/services/landing-page/LandingPageService.astro";
import EcommercePage from "../../../components/services/ecommerce/EcommercePage.astro";
import SoftwareHousePage from "../../../components/services/software-house/SoftwareHousePage.astro";
import CustomSoftwarePage from "../../../components/services/custom-software/CustomSoftwarePage.astro";
import MobileAppsPage from "../../../components/services/mobile-apps/MobileAppsPage.astro";
import ErpCrmPage from "../../../components/services/erp-crm/ErpCrmPage.astro";
import PosSystemPage from "../../../components/services/pos-system/PosSystemPage.astro";
import WorkResultDrawer from "../../../components/ui/WorkResultDrawer";
import {
  serviceSlugsId,
  serviceSlugsEn,
  getServiceData,
  getServiceKey,
  getAlternateServiceSlug,
} from "../../../data/services/index";

export function getStaticPaths() {
  const paths = [];

  // Indonesian localized paths
  for (const slug of serviceSlugsId) {
    paths.push({
      params: { locale: "id", slug },
    });
  }

  // English localized paths
  for (const slug of serviceSlugsEn) {
    paths.push({
      params: { locale: "en", slug },
    });
  }

  // Cross paths for 301 redirects (if user visits alternate language slug)
  for (const slug of serviceSlugsEn) {
    paths.push({
      params: { locale: "id", slug },
    });
  }
  for (const slug of serviceSlugsId) {
    paths.push({
      params: { locale: "en", slug },
    });
  }

  return paths;
}

const { locale, slug } = Astro.params;
const lang = locale as "en" | "id";

// Auto 301 redirect if user accesses cross-language slug
const targetSlug = lang === "en"
  ? (serviceSlugsEn.includes(slug) ? slug : getAlternateServiceSlug(slug, "en"))
  : (serviceSlugsId.includes(slug) ? slug : getAlternateServiceSlug(slug, "id"));

if (targetSlug && slug !== targetSlug) {
  return Astro.redirect(`/${lang}/services/${targetSlug}`, 301);
}

const service = getServiceData(slug, lang);

if (!service) {
  return Astro.redirect("/404");
}

const serviceKey = getServiceKey(slug);
const idSlug = getAlternateServiceSlug(slug, "id") || slug;
const enSlug = getAlternateServiceSlug(slug, "en") || slug;

const siteUrl = "https://gilabs.id";
const canonical = `${siteUrl}/${lang}/services/${slug}`;
const alternateUrls = {
  id: `${siteUrl}/id/services/${idSlug}`,
  en: `${siteUrl}/en/services/${enSlug}`,
  "x-default": `${siteUrl}/en/services/${enSlug}`,
};

// Service Schema JSON-LD
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "serviceType": service.eyebrow,
  "description": service.metaDescription,
  "url": canonical,
  "provider": {
    "@type": "Organization",
    "@id": "https://gilabs.id/#organization",
    "name": "Gilabs (PT Griya Innovations Labs)",
    "url": "https://gilabs.id"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "offers": service.packages.map(pkg => ({
    "@type": "Offer",
    "name": pkg.name,
    "price": pkg.price.replace(/[^0-9]/g, "") || "0",
    "priceCurrency": lang === "id" ? "IDR" : "USD",
    "description": pkg.description
  }))
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === "id" ? "Layanan" : "Services",
      "item": `${siteUrl}/${lang}/services`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.eyebrow,
      "item": canonical
    }
  ]
};
---

<Layout
  lang={lang}
  title={service.metaTitle}
  description={service.metaDescription}
  canonical={canonical}
  keywords={service.keywords.join(", ")}
  alternateUrls={alternateUrls}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="min-h-screen relative z-10">
    {serviceKey === "web-development" ? (
      <WebDevPage lang={lang} service={service} />
    ) : serviceKey === "company-profile" ? (
      <CompanyProfilePage lang={lang} service={service} />
    ) : serviceKey === "landing-page" ? (
      <LandingPageService lang={lang} service={service} />
    ) : serviceKey === "ecommerce" ? (
      <EcommercePage lang={lang} service={service} />
    ) : serviceKey === "software-house" ? (
      <SoftwareHousePage lang={lang} service={service} />
    ) : serviceKey === "custom-software" ? (
      <CustomSoftwarePage lang={lang} service={service} />
    ) : serviceKey === "mobile-apps" ? (
      <MobileAppsPage lang={lang} service={service} />
    ) : serviceKey === "erp-crm" ? (
      <ErpCrmPage lang={lang} service={service} />
    ) : serviceKey === "pos-system" ? (
      <PosSystemPage lang={lang} service={service} />
    ) : (
      <>
        <LandingHero
          lang={lang}
          eyebrow={service.eyebrow}
          title={service.title}
          subtitle={service.subtitle}
          illustration={service.heroIllustration}
          primaryCtaText={service.primaryCtaText}
          secondaryCtaText={service.secondaryCtaText}
          secondaryCtaHref={`/${lang}/work-results`}
        />

        <LandingProblems
          lang={lang}
          title={service.problemsTitle}
          subtitle={service.problemsSubtitle}
          problems={service.problems}
        />

        <LandingFeatures
          lang={lang}
          title={service.featuresTitle}
          subtitle={service.featuresSubtitle}
          features={service.features}
        />

        <LandingPackages
          lang={lang}
          title={service.packagesTitle}
          subtitle={service.packagesSubtitle}
          packages={service.packages}
        />

        <LandingTechStack
          lang={lang}
          title={service.techStackTitle}
          subtitle={service.techStackSubtitle}
          techStack={service.techStack}
        />

        <LandingFAQ
          lang={lang}
          title={service.faqTitle}
          subtitle={service.faqSubtitle}
          faqs={service.faqs}
        />

        <LandingCTA
          lang={lang}
          title={service.ctaTitle}
          subtitle={service.ctaSubtitle}
          buttonText={service.ctaButton}
        />
      </>
    )}
  </main>

  <WorkResultDrawer client:idle lang={lang} />

  <Footer lang={lang} />
</Layout>
