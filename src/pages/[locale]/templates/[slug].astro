---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/sections/Footer.astro';
import TemplateDetailView from '../../../components/templates/TemplateDetailView.astro';
import { templatesData, tiersData } from '../../../data/templatesData';

export function getStaticPaths() {
  const paths = [];
  for (const locale of ['id', 'en']) {
    for (const item of templatesData) {
      paths.push({
        params: { locale, slug: item.slug },
        props: { template: item },
      });
    }
  }
  return paths;
}

const { template } = Astro.props;
const { locale } = Astro.params;
const lang = (locale === 'en' ? 'en' : 'id') as 'id' | 'en';

const siteUrl = 'https://gilabs.id';
const canonical = lang === 'en' ? `${siteUrl}/en/templates/${template.slug}` : `${siteUrl}/templates/${template.slug}`;

const alternateUrls = {
  en: `${siteUrl}/en/templates/${template.slug}`,
  id: `${siteUrl}/templates/${template.slug}`,
  'x-default': `${siteUrl}/templates/${template.slug}`,
};

const tier = tiersData.find((t) => t.tierNumber === template.tier) || tiersData[0];
const numericPrice = parseInt(tier.pricing.price.replace(/[^0-9]/g, ''), 10);
const title = lang === 'en' && template.titleEn ? template.titleEn : template.title;

const pageTitle = lang === 'en'
  ? `${title} - Turnkey Website Solution & Ready-to-Use Layout | Gilabs`
  : `${title} - Jasa Pembuatan Website Siap Online | Gilabs`;

const pageDescription = lang === 'en'
  ? `${template.description.en} Complete turnkey website service including custom domain, cloud hosting, business email, and full setup.`
  : `${template.description.id} Termasuk nama domain, cloud hosting cepat, SSL, email bisnis, dan bantuan tim teknis terima beres.`;

const keywords = lang === 'en'
  ? `${title}, turnkey website service, business website development, company profile website, Gilabs software house`
  : `${title}, jasa pembuatan website bisnis, website siap online, website company profile terima beres, Gilabs software house`;

// Structured Data: Product Schema with Seller & Offers
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": title,
  "description": template.description[lang],
  "image": `${siteUrl}${template.previewImage}`,
  "brand": {
    "@type": "Brand",
    "name": "Gilabs"
  },
  "sku": `GILABS-${template.id.toUpperCase()}`,
  "offers": {
    "@type": "Offer",
    "price": numericPrice,
    "priceCurrency": "IDR",
    "availability": "https://schema.org/InStock",
    "url": canonical,
    "priceValidUntil": "2027-12-31",
    "seller": {
      "@type": "Organization",
      "name": "Gilabs",
      "url": siteUrl
    }
  }
};

// Structured Data: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'en' ? "Turnkey Business Websites" : "Website Bisnis Siap Online",
      "item": lang === 'en' ? `${siteUrl}/en/templates` : `${siteUrl}/templates`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonical
    }
  ]
};

const ogImage = `${siteUrl}${template.previewImage}`;
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
  alternateUrls={alternateUrls}
  ogImage={ogImage}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-16 sm:pt-20 bg-background">
    <TemplateDetailView template={template} lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
