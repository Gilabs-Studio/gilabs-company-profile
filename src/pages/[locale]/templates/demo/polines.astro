---
import PolinesTemplate from '../../../../features/template/polines/PolinesTemplate.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale === 'en' ? 'en' : 'id';
---

<PolinesTemplate lang={lang} />
