---
import DriveLoopTemplate from '../../../../features/template/driveloop/DriveLoopTemplate.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale === 'en' ? 'en' : 'id';
---

<DriveLoopTemplate lang={lang} />
