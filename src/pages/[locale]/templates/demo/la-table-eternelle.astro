---
import LaTableEternelleTemplate from '../../../../features/template/la-table-eternelle/LaTableEternelleTemplate.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale === 'en' ? 'en' : 'id';
---

<LaTableEternelleTemplate lang={lang} />
