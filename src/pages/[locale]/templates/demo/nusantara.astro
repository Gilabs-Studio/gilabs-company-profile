---
import NusantaraTemplate from '../../../../features/template/nusantara/NusantaraTemplate.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale === 'en' ? 'en' : 'id';
---

<NusantaraTemplate lang={lang} />
