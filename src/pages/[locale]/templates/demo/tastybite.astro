---
import TastybiteTemplate from '../../../../features/template/tastybite/TastybiteTemplate.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = locale === 'en' ? 'en' : 'id';
---

<TastybiteTemplate lang={lang} />
