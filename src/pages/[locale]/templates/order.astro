---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/sections/Footer.astro';
import OrderFlow from '../../../components/templates/OrderFlow';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = (locale === 'en' ? 'en' : 'id') as 'en' | 'id';

const siteUrl = 'https://gilabs.id';
const canonical = lang === 'en' ? `${siteUrl}/en/templates/order` : `${siteUrl}/id/templates/order`;

const pageTitle = lang === 'en'
  ? 'Order Turnkey Business Website - Gilabs.id'
  : 'Pemesanan Website Siap Online • Konfigurasi Paket - Gilabs.id';

const pageDescription = lang === 'en'
  ? 'Select your plan duration (1, 2, or 3 years), request your preferred business domain name, configure optional service add-ons, and finalize your turnkey website order with GiLabs.'
  : 'Pilih durasi paket (1, 2, atau 3 tahun), request nama domain bisnis, tambahkan opsi add-on layanan, dan selesaikan pesanan website siap online terima beres bersama Gilabs.';

const keywords = lang === 'en'
  ? 'order turnkey website, business website package, domain hosting bundle, done for you website'
  : 'pesan website siap online, buat website terima beres, paket hosting domain, jasa website company profile';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'en' ? "Turnkey Business Websites" : "Website Bisnis Siap Online",
      "item": lang === 'en' ? `${siteUrl}/en/templates` : `${siteUrl}/templates`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": lang === 'en' ? "Order Website" : "Pemesanan Website",
      "item": canonical
    }
  ]
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    <OrderFlow client:load lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
