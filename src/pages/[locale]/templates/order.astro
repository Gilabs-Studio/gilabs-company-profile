---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/sections/Footer.astro';
import OrderFlow from '../../../components/templates/OrderFlow';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = (locale === 'en' ? 'en' : 'id') as 'en' | 'id';

const siteUrl = 'https://gilabs.id';
const canonical = lang === 'en' ? `${siteUrl}/en/templates/order` : `${siteUrl}/id/templates/order`;

const pageTitle = lang === 'en'
  ? 'Order Website Template & Hosting Package - Gilabs.id'
  : 'Pemesanan Template Website & Konfigurasi Paket - Gilabs.id';

const pageDescription = lang === 'en'
  ? 'Select your plan duration (1, 2, or 3 years), register your free business domain name, add optional content editing service, and finalize your order with GiLabs.'
  : 'Pilih durasi paket (1, 2, atau 3 tahun), daftarkan nama domain gratis, tambahkan opsi jasa editing website, dan selesaikan pesanan website Anda bersama Gilabs.';

const keywords = lang === 'en'
  ? 'order website template, buy company profile website, domain hosting bundle, turnkey business website'
  : 'pesan template website, beli website company profile, paket hosting domain, jasa website siap pakai';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'en' ? "Website Templates" : "Template Website",
      "item": lang === 'en' ? `${siteUrl}/en/templates` : `${siteUrl}/id/templates`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": lang === 'en' ? "Order" : "Pemesanan",
      "item": canonical
    }
  ]
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    <OrderFlow client:load lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
