---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import TemplatesCatalog from '../../components/templates/TemplatesCatalog';
import TemplatesFaq from '../../components/templates/TemplatesFaq.astro';
import { templatesData, templatesPageContent } from '../../data/templatesData';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = (locale === 'en' ? 'en' : 'id') as 'en' | 'id';
const t = templatesPageContent[lang];

const siteUrl = 'https://gilabs.id';
const canonical = lang === 'en' ? `${siteUrl}/en/templates` : `${siteUrl}/id/templates`;

const pageTitle = lang === 'en'
  ? 'Website Templates | Landing Page & Company Profile - Gilabs.id'
  : 'Katalog Template Website | Landing Page & Company Profile - Gilabs.id';

const pageDescription = lang === 'id'
  ? 'Beli template website profil perusahaan (company profile) dan landing page modern siap pakai dengan full source code, arsitektur teruji, dan lisensi komersial penuh dari Gilabs.'
  : 'Purchase modern landing page and corporate company profile website templates with complete source code, responsive design, and commercial licenses from Gilabs.';

const keywords = lang === 'en'
  ? 'website template, landing page template, company profile template, business website template, buy website templates'
  : 'template website, template landing page, template company profile, template profil perusahaan, jual template website';

// Structured Data: ItemList of Templates
const templateListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "numberOfItems": templatesData.length,
  "itemListElement": templatesData.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Product",
      "name": item.title,
      "description": item.description[lang],
      "image": `${siteUrl}${item.previewImage}`,
      "offers": {
        "@type": "Offer",
        "price": item.startingPriceIdr,
        "priceCurrency": "IDR",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "Gilabs"
        }
      }
    }
  }))
};

// Structured Data: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'id' ? "Template Website" : "Website Templates",
      "item": canonical
    }
  ]
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(templateListSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    {/* Consistent wide container (max-w-6xl) */}
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      {/* Compact Minimal Header Section */}
      <header class="py-6 sm:py-8 border-b border-border/60 mb-8">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-2">
          {t.heroTag}
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-foreground max-w-3xl leading-tight">
          {t.heroTitle}
        </h1>
        <p class="text-xs sm:text-sm text-muted-foreground mt-2.5 max-w-2xl leading-relaxed">
          {t.heroSubtitle}
        </p>

        {/* Clean Guarantees Bar - Compact and focused */}
        <div class="mt-5 pt-4 border-t border-border/40 flex flex-wrap gap-x-5 gap-y-2 text-xs text-foreground/80">
          {t.guarantees.map((item) => (
            <div class="flex items-center gap-1.5">
              <span class="text-muted-foreground font-semibold">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </header>

      {/* Catalog Component with Instant Filter & Detail Modal */}
      <TemplatesCatalog 
        client:load 
        templates={templatesData} 
        lang={lang} 
      />

      {/* FAQ and Custom Request Section */}
      <TemplatesFaq lang={lang} />
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
