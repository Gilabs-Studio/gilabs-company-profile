---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import TemplatesCatalog from '../../components/templates/TemplatesCatalog';
import TemplatesFaq from '../../components/templates/TemplatesFaq.astro';
import TemplatesCta from '../../components/templates/TemplatesCta.astro';
import { templatesData, templatesPageContent, tiersData } from '../../data/templatesData';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const lang = (locale === 'en' ? 'en' : 'id') as 'en' | 'id';
const t = templatesPageContent[lang];

const siteUrl = 'https://gilabs.id';
const canonical = lang === 'en' ? `${siteUrl}/en/templates` : `${siteUrl}/templates`;
const ogImage = lang === 'en' ? `${siteUrl}/og-templates-en.jpg` : `${siteUrl}/og-templates.jpg`;

const alternateUrls = {
  en: `${siteUrl}/en/templates`,
  id: `${siteUrl}/templates`,
  'x-default': `${siteUrl}/templates`,
};

const pageTitle = lang === 'en'
  ? 'Turnkey Business Websites • Fully Managed | Gilabs'
  : 'Website Bisnis Siap Online • Terima Beres | Gilabs';

const pageDescription = lang === 'id'
  ? 'Pilih referensi desain modern kelas dunia, kirim materi bisnis Anda, dan website profesional Anda siap online terima beres lengkap dengan cloud hosting cepat, SSL, dan domain.'
  : 'Pick a world-class design reference, send your business content, and launch your turnkey professional website in days with high-speed cloud hosting, SSL, and custom domain setup.';

const keywords = lang === 'en'
  ? 'turnkey website, business website service, done for you website, company profile website, landing page development, Gilabs software house'
  : 'jasa website siap online, website bisnis terima beres, website company profile, landing page profesional, buat website tanpa ribet, Gilabs software house';

const activeTemplates = templatesData.filter((item) => !item.hidden);

// Structured Data: ItemList of Templates (Product Schema with Seller & Offers)
const templateListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "numberOfItems": activeTemplates.length,
  "itemListElement": activeTemplates.map((item, idx) => {
    const tier = tiersData.find((t) => t.tierNumber === item.tier);
    const defaultTierPrice = parseInt(tiersData[0].pricing.price.replace(/[^0-9]/g, ''), 10);
    const numericPrice = tier ? parseInt(tier.pricing.price.replace(/[^0-9]/g, ''), 10) : defaultTierPrice;
    const itemUrl = lang === 'en' ? `${siteUrl}/en/templates/${item.slug}` : `${siteUrl}/templates/${item.slug}`;
    return {
      "@type": "ListItem",
      "position": idx + 1,
      "item": {
        "@type": "Product",
        "name": lang === 'en' && item.titleEn ? item.titleEn : item.title,
        "description": item.description[lang],
        "image": item.previewImage ? `${siteUrl}${item.previewImage}` : `${siteUrl}${item.demoUrl}`,
        "brand": {
          "@type": "Brand",
          "name": "Gilabs"
        },
        "sku": `GILABS-${item.id.toUpperCase()}`,
        "offers": {
          "@type": "Offer",
          "price": numericPrice,
          "priceCurrency": "IDR",
          "availability": "https://schema.org/InStock",
          "url": itemUrl,
          "priceValidUntil": "2027-12-31",
          "seller": {
            "@type": "Organization",
            "name": "Gilabs",
            "url": siteUrl
          }
        }
      }
    };
  })
};

// Structured Data: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'id' ? "Website Bisnis Siap Online" : "Turnkey Business Websites",
      "item": canonical
    }
  ]
};

// Structured Data: FAQPage for Rich Search Results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
  alternateUrls={alternateUrls}
  ogImage={ogImage}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(templateListSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    {/* Container aligned with Navbar */}
    <div class="container mx-auto px-4 sm:px-6">
      {/* Header Section Aligned with Landing Page Typography */}
      <header class="pt-4 sm:pt-8 pb-4 text-center max-w-7xl mx-auto">
        <div class="flex items-center justify-center gap-3 sm:gap-4 mb-3 md:mb-4">
          <div class="h-px w-6 sm:w-12 bg-primary/20"></div>
          <span class="typography-eyebrow text-muted-foreground">
            {t.heroTag}
          </span>
          <div class="h-px w-6 sm:w-12 bg-primary/20"></div>
        </div>

        <h1 class="typography-hero-title mb-4 md:mb-6 lg:mb-8 animate-slide-up px-2 text-foreground max-w-7xl mx-auto whitespace-pre-line" style="animation-delay: 0.1s;">
          {t.heroTitle}
        </h1>

        <div class="typography-subtitle mb-6 md:mb-8 lg:mb-12 max-w-4xl mx-auto animate-slide-up px-4 text-foreground/80 font-light" style="animation-delay: 0.2s;">
          <p>{t.heroSubtitle}</p>
        </div>
      </header>

      {/* Catalog Component with Tier Containers & Instant Filter */}
      <TemplatesCatalog 
        client:load 
        templates={activeTemplates} 
        lang={lang} 
      />
    </div>

    {/* FAQ Section */}
    <TemplatesFaq lang={lang} />

    {/* Custom Development / Fitur Khusus CTA Section */}
    <TemplatesCta lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
