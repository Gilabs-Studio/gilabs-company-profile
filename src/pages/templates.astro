---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import TemplatesCatalog from '../components/templates/TemplatesCatalog';
import TemplatesFaq from '../components/templates/TemplatesFaq.astro';
import TemplatesCta from '../components/templates/TemplatesCta.astro';
import { templatesData, templatesPageContent } from '../data/templatesData';

const lang = 'id';
const t = templatesPageContent[lang];

const siteUrl = 'https://gilabs.id';
const canonical = `${siteUrl}/templates`;

const alternateUrls = {
  en: `${siteUrl}/en/templates`,
  id: `${siteUrl}/templates`,
  'x-default': `${siteUrl}/templates`,
};

const pageTitle = 'Template Website Siap Jadi Hari Ini | Bikin Web Tanpa Ribet - Gilabs';
const pageDescription = 'Malas cari vendor? Dapatkan website bisnis siap pakai yang langsung jadi hari ini. Lengkap domain, hosting, dan bisa dieditkan terima beres.';
const keywords = 'template website, template website siap pakai, website langsung jadi hari ini, template landing page, template company profile, bikin website tanpa ribet, jasa edit website, jual template website, website bisnis siap online';

// Structured Data: ItemList of Templates (Product Schema with Seller & Offers)
const templateListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "numberOfItems": templatesData.length,
  "itemListElement": templatesData.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Product",
      "name": item.title,
      "description": item.description[lang],
      "image": item.previewImage ? `${siteUrl}${item.previewImage}` : `${siteUrl}${item.demoUrl}`,
      "brand": {
        "@type": "Brand",
        "name": "Gilabs"
      },
      "sku": `GILABS-${item.id.toUpperCase()}`,
      "offers": {
        "@type": "Offer",
        "price": item.startingPriceIdr,
        "priceCurrency": "IDR",
        "availability": "https://schema.org/InStock",
        "url": `${siteUrl}${item.demoUrl}`,
        "priceValidUntil": "2027-12-31",
        "seller": {
          "@type": "Organization",
          "name": "Gilabs",
          "url": siteUrl
        }
      }
    }
  }))
};

// Structured Data: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Template Website",
      "item": canonical
    }
  ]
};

// Structured Data: FAQPage for Rich Search Results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
  alternateUrls={alternateUrls}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(templateListSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    {/* Container aligned with Navbar */}
    <div class="container mx-auto px-4 sm:px-6">
      {/* Compact Minimal Header Section with Pain-Point Slogan */}
      <header class="py-3 sm:py-8 mb-6 text-center flex flex-col items-center">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-2">
          {t.heroTag}
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-foreground max-w-3xl leading-tight">
          {t.heroTitle}
        </h1>
        <p class="text-xs sm:text-sm text-muted-foreground mt-2.5 max-w-2xl leading-relaxed">
          {t.heroSubtitle}
        </p>
      </header>

      {/* Catalog Component with Tier Containers & Instant Filter */}
      <TemplatesCatalog 
        client:load 
        templates={templatesData} 
        lang={lang} 
      />
    </div>

    {/* FAQ Section */}
    <TemplatesFaq lang={lang} />

    {/* Custom Development / Fitur Khusus CTA Section */}
    <TemplatesCta lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
