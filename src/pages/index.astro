---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Showcase from '../components/sections/Showcase.astro';
import Process from '../components/sections/Process.astro';
import FAQ from '../components/sections/FAQ.astro';
import Offer from '../components/sections/Offer.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../components/ui/WorkResultDrawer';
import Footer from '../components/sections/Footer.astro';

const lang = 'en';
const title = 'Gilabs.id - Premium Software Agency | Web & Mobile App Development';
const description = 'Premium Software Agency specializing in web development, mobile apps, and digital solutions. Transform your business with cutting-edge technology.';
const keywords = 'web development, mobile app development, software agency, digital solutions, UI/UX design, custom software, web design, app development Indonesia';

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "What is a software house?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "A software house is a company specializing in custom software development tailored to business needs. Unlike SaaS products, a software house builds systems truly adapted to your workflow and business processes."
			}
		},
		{
			"@type": "Question",
			"name": "What services does Gilabs offer?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs offers ERP development, CRM development, POS system, HRIS development, Finance System, web development, mobile app development, UI/UX design, and AI integration."
			}
		},
		{
			"@type": "Question",
			"name": "How long does software development take?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "It depends on complexity: landing pages and websites usually take 2-4 weeks, single CRM or HRIS modules 6-12 weeks, and full ERP systems 3-6 months. We work agile with regular updates."
			}
		},
		{
			"@type": "Question",
			"name": "Does Gilabs serve all of Indonesia?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Yes, Gilabs serves all of Indonesia remotely. Although our team is based in Semarang, Central Java, we work with clients from various cities including Jakarta, Surabaya, Bali, Medan, and others."
			}
		},
		{
			"@type": "Question",
			"name": "What technologies does Gilabs use?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs uses a modern stack: Next.js 16 and React for frontend, Go (Golang) and Node.js for backend, PostgreSQL for database, Flutter for mobile apps, TypeScript, Tailwind CSS, and AI integration."
			}
		}
	]
};
---

<Layout
	lang={lang}
	title={title}
	description={description}
	canonical="https://gilabs.id"
	keywords={keywords}
	ogImage="https://gilabs.id/og-image.png"
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<Navbar lang={lang} />
	<WorkResultDrawer client:load lang={lang} />

	<main>
		<Hero lang={lang} />
		<Showcase lang={lang} />
		<Portfolio lang={lang} />
		<Offer lang={lang} />
		<Process lang={lang} />
		<FAQ lang={lang} />
		<FinalCTA lang={lang} />
	</main>

	<Footer lang={lang} />
</Layout>
