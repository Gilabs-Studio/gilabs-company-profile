---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Showcase from '../components/sections/Showcase.astro';
import Process from '../components/sections/Process.astro';
import Comparison from '../components/sections/Comparison.astro';
import FAQ from '../components/sections/FAQ.astro';
import Offer from '../components/sections/Offer.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../components/ui/WorkResultDrawer';
import Footer from '../components/sections/Footer.astro';

const lang = 'en';
const title = 'Gilabs | PT Griya Innovations Labs - Complex Internal Systems Software House';
const description = 'Gilabs by PT Griya Innovations Labs is an Indonesia software house focused on complex internal systems: ERP, CRM, POS, HRIS, finance systems, operational dashboards, workflow approvals, and custom enterprise software.';
const keywords = 'Gilabs, PT Griya Innovations Labs, Indonesia software house, Semarang software house, Jakarta software house, software development company Indonesia, complex internal systems development, custom ERP development Indonesia, custom CRM development company, HRIS software development, finance system development, operational dashboard development, workflow approval system development, custom POS software development, cooperative management system, custom manufacturing software, distributor software systems, business digitalization software house';

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "Is Gilabs the same as PT Griya Innovations Labs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Yes. Gilabs is the public brand of PT Griya Innovations Labs, an Indonesia software house focused on developing complex internal systems for companies."
			}
		},
		{
			"@type": "Question",
			"name": "What is a software house?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "A software house is a company specializing in custom software development tailored to business needs. Unlike SaaS products, a software house builds systems truly adapted to your workflow and business processes."
			}
		},
		{
			"@type": "Question",
			"name": "What services does Gilabs offer?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs offers: ERP development, CRM development, POS systems, HRIS, finance systems, operational dashboards, workflow approval systems, web development, mobile app development, UI/UX design, and AI integration."
			}
		},
		{
			"@type": "Question",
			"name": "How long does software development take?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "It depends on complexity: Landing pages/websites 2-4 weeks, single CRM or HRIS module 6-12 weeks, full ERP system 3-6 months. We work agile with regular updates."
			}
		},
		{
			"@type": "Question",
			"name": "Does Gilabs serve all of Indonesia?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Yes, Gilabs serves all of Indonesia remotely. Although our team is based in Semarang, Central Java, we work with clients from various cities including Jakarta, Surabaya, Bali, Medan, and others."
			}
		},
		{
			"@type": "Question",
			"name": "What technologies does Gilabs use?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs uses a modern stack: Next.js 16 and React for frontend, Go (Golang) and Node.js for backend, PostgreSQL for database, Flutter for mobile app, TypeScript, Tailwind CSS, and AI integration."
			}
		}
	]
};
---

<Layout
	lang={lang}
	title={title}
	description={description}
	canonical="https://gilabs.id"
	keywords={keywords}
	ogImage="https://gilabs.id/og-image.png"
	showRays={true}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<Navbar lang={lang} />
	<WorkResultDrawer client:idle lang={lang} />

	<main>
		<Hero lang={lang} />
		<Showcase lang={lang} />
		<Portfolio lang={lang} />
		<Offer lang={lang} />
		<Process lang={lang} />
		<Comparison lang={lang} />
		<FAQ lang={lang} />
		<FinalCTA lang={lang} />
	</main>

	<Footer lang={lang} />
</Layout>
