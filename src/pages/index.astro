---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Showcase from '../components/sections/Showcase.astro';
import Process from '../components/sections/Process.astro';
import FAQ from '../components/sections/FAQ.astro';
import Offer from '../components/sections/Offer.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../components/ui/WorkResultDrawer';
import Footer from '../components/sections/Footer.astro';

const lang = 'id';
const title = 'Gilabs | PT Griya Innovations Labs - Software House Sistem Internal Kompleks';
const description = 'Gilabs by PT Griya Innovations Labs adalah software house Indonesia yang fokus pada pengembangan sistem internal kompleks: ERP, CRM, POS, HRIS, finance system, dashboard operasional, workflow approval, dan custom software enterprise.';
const keywords = 'Gilabs, PT Griya Innovations Labs, software house Indonesia, software house Semarang, jasa pengembangan sistem internal perusahaan, jasa pembuatan ERP custom Indonesia, jasa pembuatan CRM perusahaan, jasa pembuatan POS custom, jasa pembuatan HRIS Indonesia, jasa pembuatan finance system, pengembangan dashboard operasional, pengembangan workflow approval system, custom software enterprise Indonesia, vendor sistem internal kompleks';

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "Apakah Gilabs adalah PT Griya Innovations Labs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Ya. Gilabs adalah brand publik dari PT Griya Innovations Labs, software house Indonesia yang fokus pada pengembangan sistem internal kompleks untuk perusahaan."
			}
		},
		{
			"@type": "Question",
			"name": "Apa itu software house?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Software house adalah perusahaan yang spesialis dalam pengembangan software kustom sesuai kebutuhan bisnis. Berbeda dengan produk SaaS, software house membangun sistem yang benar-benar disesuaikan dengan alur kerja dan proses bisnis Anda."
			}
		},
		{
			"@type": "Question",
			"name": "Apa saja layanan Gilabs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs menyediakan layanan: pembuatan ERP, CRM, POS, HRIS, finance system, dashboard operasional, workflow approval system, web development, mobile app development, UI/UX design, dan integrasi AI."
			}
		},
		{
			"@type": "Question",
			"name": "Berapa lama waktu pengembangan software?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Tergantung kompleksitas: landing page dan website biasanya 2-4 minggu, modul CRM atau HRIS tunggal 6-12 minggu, dan sistem ERP lengkap 3-6 bulan. Kami bekerja secara agile dengan update berkala."
			}
		},
		{
			"@type": "Question",
			"name": "Apakah Gilabs melayani seluruh Indonesia?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Ya, Gilabs melayani seluruh Indonesia secara remote. Meskipun tim kami berbasis di Semarang, Jawa Tengah, kami bekerja dengan klien dari berbagai kota seperti Jakarta, Surabaya, Bali, Medan, dan lainnya."
			}
		},
		{
			"@type": "Question",
			"name": "Teknologi apa yang digunakan Gilabs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs menggunakan stack modern: Next.js 16 dan React untuk frontend, Go (Golang) dan Node.js untuk backend, PostgreSQL untuk database, Flutter untuk mobile app, TypeScript, Tailwind CSS, dan integrasi AI."
			}
		}
	]
};
---

<Layout
	lang={lang}
	title={title}
	description={description}
	canonical="https://gilabs.id"
	keywords={keywords}
	ogImage="https://gilabs.id/og-image.png"
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<Navbar lang={lang} />
	<WorkResultDrawer client:load lang={lang} />

	<main>
		<Hero lang={lang} />
		<Showcase lang={lang} />
		<Portfolio lang={lang} />
		<Offer lang={lang} />
		<Process lang={lang} />
		<FAQ lang={lang} />
		<FinalCTA lang={lang} />
	</main>

	<Footer lang={lang} />
</Layout>
