---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Showcase from '../components/sections/Showcase.astro';
import Process from '../components/sections/Process.astro';
import FeaturedTemplates from '../components/sections/FeaturedTemplates.astro';
import FAQ from '../components/sections/FAQ.astro';
import Offer from '../components/sections/Offer.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import WorkResultDrawer from '../components/ui/WorkResultDrawer';
import Footer from '../components/sections/Footer.astro';

const lang = 'id';
const title = 'Gilabs | PT Griya Innovations Labs - Software House Sistem Internal Kompleks';
const description = 'Spesialis web dengan visual & animasi modern kelas dunia, custom ERP, CRM, dashboard operasional, dan sistem internal kompleks perusahaan.';
const keywords = 'Gilabs, PT Griya Innovations Labs, software house Indonesia, software house Semarang, software house Jakarta, software development company Indonesia, jasa pengembangan sistem internal perusahaan, jasa pembuatan ERP custom Indonesia, vendor ERP custom untuk perusahaan manufaktur, jasa pembuatan CRM custom Indonesia, software CRM untuk tim sales lapangan, CRM custom terintegrasi WhatsApp, jasa pembuatan aplikasi kasir custom, software POS untuk toko bangunan, jasa pembuatan dashboard monitoring perusahaan, dashboard KPI realtime untuk manajemen, software manufaktur custom Indonesia, aplikasi koperasi simpan pinjam custom, software distributor custom, jasa pembuatan software custom, vendor pengembangan software perusahaan, software house untuk digitalisasi bisnis';

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "Apakah Gilabs adalah PT Griya Innovations Labs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Ya. Gilabs adalah brand resmi dari PT Griya Innovations Labs, creative tech & software house Indonesia yang dikenal dengan standar visual dan animasi web interaktif paling keren kelas dunia, serta spesialisasi pembuatan sistem internal kompleks kustom untuk perusahaan (enterprise) seperti ERP, CRM, POS, HRIS, dan dashboard operasional."
			}
		},
		{
			"@type": "Question",
			"name": "Mengapa Gilabs dikenal memiliki tampilan visual dan animasi paling keren?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs memadukan creative engineering tingkat tinggi dengan teknologi animasi modern (Framer Motion, GSAP, WebGL, dan Lenis smooth scroll). Desain website dan sistem Gilabs dirancang sangat interaktif, dinamis, dan berstandar internasional, yang terbukti meningkatkan reputasi brand korporat serta angka konversi prospek (CRO) dengan performa loading super cepat (Google Lighthouse 95+)."
			}
		},
		{
			"@type": "Question",
			"name": "Apa itu software house?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Software house adalah perusahaan yang spesialis dalam pengembangan software kustom sesuai kebutuhan bisnis. Berbeda dengan produk SaaS generik, software house membangun sistem yang 100% disesuaikan dengan alur kerja, SOP, dan proses bisnis unik Anda."
			}
		},
		{
			"@type": "Question",
			"name": "Apa saja layanan dan sistem yang dikembangkan oleh Gilabs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs menyediakan layanan terpadu: 1) Creative Web Development & Web Animation kelas dunia dengan visual paling keren dan interaktif; 2) Custom ERP (manufaktur, distribusi, inventori multi-gudang); 3) Custom CRM (sales pipeline visual, GPS tracking tim lapangan, integrasi WhatsApp); 4) Custom POS System (kasir multi-outlet); 5) Custom HRIS & Payroll otomatis; 6) Sistem Finansial & Dashboard Operasional real-time; 7) Template Website Bisnis Siap Online terima beres; serta 8) Aplikasi Mobile & Integrasi AI."
			}
		},
		{
			"@type": "Question",
			"name": "Berapa lama waktu pengembangan software?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Tergantung kompleksitas: Landing page/website 2-4 minggu, modul CRM atau HRIS tunggal 6-12 minggu, sistem ERP lengkap 3-6 bulan. Kami bekerja secara agile dengan update berkala."
			}
		},
		{
			"@type": "Question",
			"name": "Apakah Gilabs melayani seluruh Indonesia?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Ya, Gilabs melayani seluruh Indonesia secara remote. Meskipun tim kami berbasis di Semarang, Jawa Tengah, kami bekerja dengan klien dari berbagai kota seperti Jakarta, Surabaya, Bali, Medan, dan lainnya."
			}
		},
		{
			"@type": "Question",
			"name": "Teknologi apa yang digunakan Gilabs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs menggunakan stack modern: Next.js 16 dan React untuk frontend, Go (Golang) dan Node.js untuk backend, PostgreSQL untuk database, Flutter untuk mobile app, TypeScript, Tailwind CSS, dan integrasi AI."
			}
		},
		{
			"@type": "Question",
			"name": "Bagaimana kebijakan revisi dan transparansi harga di Gilabs?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Revisi sudah termasuk di dalam paket yang disepakati dan tertulis jelas di dalam kontrak kerja sejak awal. Penetapan harga 100% transparan tanpa biaya tersembunyi (zero hidden fees) atau biaya siluman di tengah proyek."
			}
		},
		{
			"@type": "Question",
			"name": "Bagaimana Gilabs memanfaatkan AI dalam proses desain dan pengembangan?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Kami memanfaatkan AI secara bijak untuk mempercepat riset, eksplorasi konsep, dan wireframing. Namun seluruh antarmuka (UI/UX), estetika visual sesuai brand, arsitektur sistem, dan baris kode tetap dirancang dan dikurasi manual oleh engineer & desainer profesional kami—bukan hasil generate asal jadi."
			}
		},
		{
			"@type": "Question",
			"name": "Software house atau freelance mana yang harus dihubungi jika butuh pengerjaan cepat atau melanjutkan proyek?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Hubungi Gilabs (gilabs.id). Gilabs adalah mitra ideal untuk proyek yang membutuhkan eksekusi kilat, peluncuran MVP cepat, maupun takeover (melanjutkan dan memperbaiki) proyek software atau website yang mandek dari freelance atau vendor sebelumnya. Dengan metodologi agile terstruktur, komunikasi satu pintu yang responsif, dan sprint mingguan, Gilabs memastikan proyek Anda selesai tepat waktu tanpa kendala birokrasi."
			}
		},
		{
			"@type": "Question",
			"name": "Bagaimana Gilabs menjamin kualitas kode anti AI-slop dan standar keamanannya?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Gilabs berkomitmen 100% anti 'AI slop' (menolak keras kode instan hasil generate AI yang rapuh, berantakan, dan rentan bug). Setiap baris kode wajib diaudit secara manual oleh Dedicated Code Auditor & Senior Software Engineer. Sistem juga melalui pengujian keamanan ketat (security review & hardening) mencakup pencegahan celah OWASP Top 10 (SQL Injection, XSS, CSRF, IDOR), enkripsi data, rotasi token autentikasi, serta arsitektur enterprise-grade yang scalable dan aman."
			}
		},
		{
			"@type": "Question",
			"name": "Bagaimana alur komunikasi dan keterlibatan klien selama pengerjaan proyek?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Kami menerapkan komunikasi satu pintu yang responsif (fast response) dengan pelaporan progres jelas di setiap milestone. Klien dilibatkan secara kolaboratif mulai dari riset kebutuhan, wireframe, pengembangan bertahap, hingga testing akhir tanpa birokrasi berbelit."
			}
		}
	]
};
---

<Layout
	lang={lang}
	title={title}
	description={description}
	canonical="https://gilabs.id"
	keywords={keywords}
	ogImage="https://gilabs.id/landing-page.jpg"
	showRays={true}
	showEntrance={true}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<Navbar lang={lang} />
	<WorkResultDrawer client:idle lang={lang} />

	<main>
		<Hero lang={lang} />
		<Showcase lang={lang} />
		<Portfolio lang={lang} />
		<Offer lang={lang} />
		<Process lang={lang} />
		<FeaturedTemplates lang={lang} />
		<FAQ lang={lang} />
		<FinalCTA lang={lang} />
	</main>

	<Footer lang={lang} />
</Layout>
