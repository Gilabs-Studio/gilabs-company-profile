---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import OrderFlow from '../../components/templates/OrderFlow';

const lang = 'id';
const siteUrl = 'https://gilabs.id';
const canonical = `${siteUrl}/templates/order`;

const pageTitle = 'Pemesanan Template Website & Konfigurasi Paket - Gilabs.id';
const pageDescription = 'Pilih durasi paket (1, 2, atau 3 tahun), daftarkan nama domain gratis, tambahkan opsi jasa editing website, dan selesaikan pesanan website Anda bersama Gilabs.';
const keywords = 'pesan template website, beli website company profile, paket hosting domain, jasa website siap pakai';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Template Website",
      "item": `${siteUrl}/templates`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Pemesanan",
      "item": canonical
    }
  ]
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-24 sm:pt-28 pb-20 bg-background min-h-screen">
    <OrderFlow client:load lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
