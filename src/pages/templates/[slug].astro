---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import TemplateDetailView from '../../components/templates/TemplateDetailView.astro';
import { templatesData, tiersData } from '../../data/templatesData';

export function getStaticPaths() {
  return templatesData.map((item) => ({
    params: { slug: item.slug },
    props: { template: item },
  }));
}

const { template } = Astro.props;
const lang = 'id';

const siteUrl = 'https://gilabs.id';
const canonical = `${siteUrl}/templates/${template.slug}`;

const alternateUrls = {
  en: `${siteUrl}/en/templates/${template.slug}`,
  id: `${siteUrl}/templates/${template.slug}`,
  'x-default': `${siteUrl}/templates/${template.slug}`,
};

const tier = tiersData.find((t) => t.tierNumber === template.tier) || tiersData[0];
const numericPrice = parseInt(tier.pricing.price.replace(/[^0-9]/g, ''), 10);

const pageTitle = `${template.title} - Jasa Pembuatan Website Siap Online | Gilabs`;
const pageDescription = `${template.description.id} Termasuk nama domain, cloud hosting cepat, SSL, email bisnis, dan bantuan tim teknis terima beres.`;
const keywords = `${template.title}, jasa pembuatan website bisnis, website siap online, website company profile terima beres, Gilabs software house`;

// Structured Data: Product Schema with Seller & Offers
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": template.title,
  "description": template.description.id,
  "image": `${siteUrl}${template.previewImage}`,
  "brand": {
    "@type": "Brand",
    "name": "Gilabs"
  },
  "sku": `GILABS-${template.id.toUpperCase()}`,
  "offers": {
    "@type": "Offer",
    "price": numericPrice,
    "priceCurrency": "IDR",
    "availability": "https://schema.org/InStock",
    "url": canonical,
    "priceValidUntil": "2027-12-31",
    "seller": {
      "@type": "Organization",
      "name": "Gilabs",
      "url": siteUrl
    }
  }
};

// Structured Data: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Gilabs",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Website Bisnis Siap Online",
      "item": `${siteUrl}/templates`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": template.title,
      "item": canonical
    }
  ]
};

const ogImage = `${siteUrl}${template.previewImage}`;
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={keywords}
  alternateUrls={alternateUrls}
  ogImage={ogImage}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Navbar lang={lang} />

  <main class="pt-16 sm:pt-20 bg-background">
    <TemplateDetailView template={template} lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
