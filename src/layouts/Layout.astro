---
import "../styles/globals.css";
import LightRays from "../components/ui/LightRays";
import MobileMenu from "../components/MobileMenu.astro";

const { 
	lang = Astro.currentLocale || 'id', 
	title = 'Gilabs | PT Griya Innovations Labs - Software House Indonesia untuk Sistem Internal Kompleks',
	description = 'Gilabs by PT Griya Innovations Labs adalah software house Indonesia yang fokus pada pengembangan sistem internal kompleks: ERP, CRM, HRIS, finance, workflow, dashboard operasional, dan custom software enterprise.',
	canonical = Astro.url.href,
	robots = 'index, follow',
	noindex = false,
	showRays = false,
	keywords = 'Gilabs, PT Griya Innovations Labs, software house Indonesia, software house Semarang, software house Jakarta, software development company Indonesia, jasa pengembangan sistem internal perusahaan, jasa pembuatan ERP custom Indonesia, vendor ERP custom untuk perusahaan manufaktur, jasa pembuatan CRM custom Indonesia, software CRM untuk tim sales lapangan, CRM custom terintegrasi WhatsApp, jasa pembuatan aplikasi kasir custom, software POS untuk toko bangunan, jasa pembuatan dashboard monitoring perusahaan, dashboard KPI realtime untuk manajemen, software manufaktur custom Indonesia, aplikasi koperasi simpan pinjam custom, software distributor custom, jasa pembuatan software custom, vendor pengembangan software perusahaan, software house untuk digitalisasi bisnis',
	ogImage = 'https://gilabs.id/og-image.png'
} = Astro.props;

const siteUrl = 'https://gilabs.id';
let canonicalUrlStr = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
// Remove trailing slash for consistency (unless it's exactly the root domain)
if (canonicalUrlStr.endsWith('/') && canonicalUrlStr !== `${siteUrl}/`) {
  canonicalUrlStr = canonicalUrlStr.slice(0, -1);
}
const fullCanonical = canonicalUrlStr;
const robotsContent = noindex ? 'noindex, nofollow' : robots;

// Generate hreflang URLs for multi-language SEO
// Extract the path after locale prefix to build alternate URLs
let currentPath = Astro.url.pathname;
// Remove trailing slash from currentPath
if (currentPath.endsWith('/') && currentPath !== '/') {
  currentPath = currentPath.slice(0, -1);
}
const pathWithoutLocale = currentPath.replace(/^\/(en|id)/, '') || '/';

// Build alternate URLs for each language
const enUrl = `${siteUrl}/en${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`;
const idUrl = `${siteUrl}/id${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`;

// Keep the homepage x-default anchored to the root canonical URL.
const defaultUrl = pathWithoutLocale === '/' ? siteUrl : enUrl;

// Schema.org: Organization + LocalBusiness
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
  "@id": "https://gilabs.id/#organization",
  "name": "Gilabs",
  "legalName": "PT Griya Innovations Labs",
  "alternateName": [
    "GiLabs",
    "Gilabs Software House",
    "Gilabs.id",
    "PT Griya Innovations Labs",
    "Griya Innovations Labs"
  ],
  "url": "https://gilabs.id",
  "logo": {
    "@type": "ImageObject",
    "url": "https://gilabs.id/favicon-144x144.png",
    "width": 144,
    "height": 144
  },
  "description": lang === 'id'
    ? "Gilabs adalah brand dari PT Griya Innovations Labs, software house Indonesia yang spesialis dalam pengembangan sistem internal kompleks untuk perusahaan: ERP, CRM, POS, HRIS, finance system, workflow operasional, dashboard, dan custom software enterprise."
    : "Gilabs is the brand of PT Griya Innovations Labs, an Indonesia software house specializing in complex internal systems for companies: ERP, CRM, POS, HRIS, finance systems, operational workflows, dashboards, and custom enterprise software.",
  "email": "hello@gilabs.id",
  "brand": {
    "@type": "Brand",
    "name": "Gilabs"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Semarang",
    "addressRegion": "Jawa Tengah",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-6.9667",
    "longitude": "110.4167"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Sales",
    "availableLanguage": ["Indonesian", "English"]
  },
  "sameAs": [
    "https://gilabs.id"
  ],
  "keywords": [
    "Gilabs",
    "PT Griya Innovations Labs",
    "software house Indonesia",
    "software house Semarang",
    "software house Jakarta",
    "software development company Indonesia",
    "pengembangan sistem internal perusahaan",
    "custom ERP development",
    "custom CRM development",
    "HRIS development",
    "finance system development",
    "workflow automation system",
    "dashboard operasional perusahaan",
    "custom enterprise software",
    "custom POS development",
    "cooperative software development",
    "manufacturing software development",
    "distributor software development"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": lang === 'id' ? "Layanan Software House" : "Software House Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ERP System Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CRM System Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "POS System Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "HRIS System Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Finance System Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile App Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Software Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cooperative Management Software Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Manufacturing Software Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Distributor ERP Solutions" } }
    ]
  },
  "knowsAbout": [
    "Software House", "Web Development", "Mobile App Development", "ERP System",
    "CRM System", "POS System", "HRIS", "Finance System",
    "Custom Software Development", "Workflow Automation", "Internal Tools",
    "Operational Dashboard", "Approval System", "Inventory System",
    "Next.js", "Go (Golang)", "Flutter",
    "TypeScript", "PostgreSQL", "Enterprise Software", "Digital Transformation"
  ]
};

// Schema.org: WebSite with SearchAction
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://gilabs.id/#website",
  "name": "Gilabs Software House",
  "url": "https://gilabs.id",
  "description": lang === 'id'
    ? "Software house Indonesia milik PT Griya Innovations Labs yang spesialis dalam sistem internal kompleks untuk perusahaan"
    : "Indonesia software house by PT Griya Innovations Labs specializing in complex internal systems for companies",
  "inLanguage": ["id", "en"],
  "publisher": { "@id": "https://gilabs.id/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://gilabs.id/{search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		
		<!-- Favicons - Multiple formats for Google Search compatibility -->
		<!-- Primary favicon for Google Search Console -->
		<link rel="icon" href="/favicon.ico" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="144x144" href="/favicon-144x144.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={robotsContent} />
		<meta name="author" content="Gilabs.id" />
		<meta name="publisher" content="PT Griya Innovations Labs" />
		<meta name="application-name" content="Gilabs" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={fullCanonical} />
		
		<!-- Hreflang Tags for Multi-language SEO -->
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="id" href={idUrl} />
		<link rel="alternate" hreflang="x-default" href={defaultUrl} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={fullCanonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content="Gilabs.id" />
		<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={title} />
		
		<!-- Additional SEO -->
		<meta name="language" content={lang === 'id' ? 'Indonesian' : 'English'} />
		<meta name="geo.region" content="ID-JT" />
		<meta name="geo.placename" content="Semarang, Jawa Tengah, Indonesia" />
		<meta name="geo.position" content="-6.9667;110.4167" />
		<meta name="ICBM" content="-6.9667, 110.4167" />
		
		<!-- AI/LLM Context Files -->
		<link rel="alternate" type="text/plain" title="LLMs.txt — AI Context" href="/llms.txt" />
		<link rel="alternate" type="text/markdown" title="About Gilabs (Markdown)" href="/about.md" />
		<link rel="alternate" type="text/markdown" title="Services (Markdown)" href="/services.md" />
		<link rel="alternate" type="text/markdown" title="Portfolio (Markdown)" href="/portfolio.md" />
		
		<!-- Sitemap discovery -->
		<link rel="sitemap" href="/sitemap-index.xml" />
		
		<!-- Structured Data: Organization + LocalBusiness -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		
		<!-- Structured Data: WebSite -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		
    <!-- Google Fonts - Optimized loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" /></noscript>
    
    <!-- Per-page additional head tags (e.g. page-specific schemas) -->
    <slot name="head" />
	</head>
	<body class="bg-background text-foreground font-sans antialiased relative selection:bg-brand selection:text-white">
    {showRays && (
      <div class="fixed inset-0 z-[-1] pointer-events-none">
        <LightRays 
          client:only="react"
          raysColor="#FFFFF" 
          raysSpeed={0.5} 
          lightSpread={0.5}
          rayLength={1.5}
          raysOrigin="top-center"
        />
      </div>
    )}
		<slot />
		<MobileMenu lang={lang} />
	</body>

<script>
  // Defensive reset for cases where body scroll lock gets stuck after overlays close.
  (function() {
    function resetBodyScrollStyles() {
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
      document.body.style.height = '';
      document.body.style.top = '';
      document.body.style.left = '';
    }

    // Check on visibility change (for example when switching tabs/devtools focus).
    document.addEventListener('visibilitychange', () => {
      requestAnimationFrame(() => {
        if (!document.hidden) {
          const hasOverflowHidden = document.body.style.overflow === 'hidden';
          const hasPositionFixed = document.body.style.position === 'fixed';
          
          // Only reset if no modal/drawer is actually open
          // Check if mobile menu is closed
          const mobileMenu = document.getElementById('mobile-menu');
          const isMobileMenuOpen = mobileMenu && !mobileMenu.classList.contains('opacity-0');
          
          // Check if project drawer is open (check for backdrop)
          const hasBackdrop = document.querySelector('.fixed.inset-0.bg-black\\/60');
          
          if (!isMobileMenuOpen && !hasBackdrop && (hasOverflowHidden || hasPositionFixed)) {
            resetBodyScrollStyles();
          }
        }
      });
    });

    // Ensure scroll is enabled on page load
    window.addEventListener('load', () => {
      requestAnimationFrame(() => {
        resetBodyScrollStyles();
        
        // Clean up any existing ScrollTrigger instances if GSAP was loaded
        const win = window as any;
        if (win.ScrollTrigger) {
          try {
            win.ScrollTrigger.getAll().forEach((st: any) => st?.kill?.());
            win.ScrollTrigger.refresh();
          } catch (e) {
            // Ignore errors
          }
        }
      });
    });
    
    // Also cleanup on DOMContentLoaded for faster response
    document.addEventListener('DOMContentLoaded', () => {
      requestAnimationFrame(() => {
        resetBodyScrollStyles();
      });
    });
  })();
</script>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
