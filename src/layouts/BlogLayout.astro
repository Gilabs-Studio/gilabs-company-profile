---
import "../styles/globals.css";

const {
lang = Astro.currentLocale || 'en',
title = 'Gilabs.id',
description = 'Premium Software Agency specializing in web development, mobile apps, and digital solutions. Transform your business with cutting-edge technology.',
canonical = Astro.url.href,
robots = 'index, follow',
noindex = false,
keywords = 'web development, mobile app development, software agency, digital solutions, UI/UX design, custom software, web design, app development Indonesia, ERP system, CRM system, software development company, web application development, mobile application development, e-commerce development, enterprise software, digital transformation, software consulting, Indonesia software company',
ogImage = 'https://gilabs.id/og-image.png',
datePublished,
dateModified,
articleAuthor = 'Gilabs Editorial Team',
articleCategory,
} = Astro.props;

const siteUrl = 'https://gilabs.id';
let canonicalUrlStr = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
if (canonicalUrlStr.endsWith('/') && canonicalUrlStr !== `${siteUrl}/`) {
  canonicalUrlStr = canonicalUrlStr.slice(0, -1);
}
const fullCanonical = canonicalUrlStr;
const robotsContent = noindex ? 'noindex, nofollow' : robots;

let currentPath = Astro.url.pathname;
if (currentPath.endsWith('/') && currentPath !== '/') {
  currentPath = currentPath.slice(0, -1);
}
const pathWithoutLocale = currentPath.replace(/^\/(en|id)/, '') || '/';

const enUrl = `${siteUrl}/en${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`;
const idUrl = `${siteUrl}/id${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`;
const defaultUrl = enUrl;

const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": ogImageAbsolute,
  "url": fullCanonical,
  "datePublished": datePublished,
  "dateModified": dateModified || datePublished,
  "author": {
    "@type": "Organization",
    "name": articleAuthor,
    "url": "https://gilabs.id"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Gilabs Software House",
    "@id": "https://gilabs.id/#organization",
    "url": "https://gilabs.id",
    "logo": {
      "@type": "ImageObject",
      "url": "https://gilabs.id/favicon-144x144.png",
      "width": 144,
      "height": 144
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullCanonical
  },
  ...(articleCategory ? { "articleSection": articleCategory } : {})
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": lang === 'id' ? `${siteUrl}/id` : `${siteUrl}/en`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": lang === 'id' ? `${siteUrl}/id/blog` : `${siteUrl}/en/blog`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": fullCanonical
    }
  ]
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />

<link rel="icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="icon" type="image/png" sizes="144x144" href="/favicon-144x144.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={articleAuthor} />
<meta name="publisher" content="Gilabs.id" />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonical} />

<!-- Hreflang Tags for Multi-language SEO -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="id" href={idUrl} />
<link rel="alternate" hreflang="x-default" href={defaultUrl} />

<!-- Sitemap discovery -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph / Facebook (Article) -->
<meta property="og:type" content="article" />
<meta property="og:url" content={fullCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Gilabs.id" />
<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
{datePublished && <meta property="article:published_time" content={datePublished} />}
{(dateModified || datePublished) && <meta property="article:modified_time" content={dateModified || datePublished} />}
{articleCategory && <meta property="article:section" content={articleCategory} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />
<meta name="twitter:image:alt" content={title} />

<!-- Additional SEO -->
<meta name="language" content={lang === 'id' ? 'Indonesian' : 'English'} />
<meta name="geo.region" content="ID-JT" />
<meta name="geo.placename" content="Semarang, Jawa Tengah, Indonesia" />

<!-- Structured Data: Article -->
{datePublished && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

<!-- Structured Data: BreadcrumbList -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- Structured Data: Organization (publisher) -->
<script type="application/ld+json" set:html={JSON.stringify({
"@context": "https://schema.org",
"@type": "Organization",
"@id": "https://gilabs.id/#organization",
"name": "Gilabs Software House",
"url": "https://gilabs.id",
"logo": {
"@type": "ImageObject",
"url": "https://gilabs.id/favicon-144x144.png",
"width": 144,
"height": 144
},
"description": "Gilabs adalah software house premium di Indonesia spesialis ERP, CRM, POS, HRIS, Finance System & custom software enterprise.",
"address": {
"@type": "PostalAddress",
"addressLocality": "Semarang",
"addressRegion": "Jawa Tengah",
"addressCountry": "ID"
},
"areaServed": { "@type": "Country", "name": "Indonesia" }
})} />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="bg-background text-foreground font-sans antialiased relative selection:bg-brand selection:text-white">
<div class="fixed inset-0 z-[-1] pointer-events-none">
<div class="absolute inset-0 bg-linear-to-b from-background via-background/98 to-background"></div>
</div>
<slot />
</body>
</html>

<style>
html,
body {
margin: 0;
width: 100%;
height: 100%;
}
</style>
